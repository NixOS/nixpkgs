+			   (int)sizeof(module), module
 		))
 		return -ENOMEM;
 
 	if (device->prot[0])
-		if (add_uevent_var(env, "DDCCI_PROT=%s", device->prot))
+		if (add_uevent_var(env, "DDCCI_PROT=%.*s", (int)sizeof(device->prot), device->prot))
 			return -ENOMEM;
 
 	if (device->type[0])
-		if (add_uevent_var(env, "DDCCI_TYPE=%s", device->type))
