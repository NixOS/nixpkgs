 	if (device->model[0])
-		if (add_uevent_var(env, "DDCCI_MODEL=%s", device->model))
+		if (add_uevent_var(env, "DDCCI_MODEL=%.*s", (int)sizeof(device->model), device->model))
 			return -ENOMEM;
 
 	if (device->vendor[0]) {
-		if (add_uevent_var(env, "DDCCI_VENDOR=%s", device->vendor))
