diff '--color=auto' -ruN a/arch/powerpc/kernel/Makefile b/arch/powerpc/kernel/Makefile
--- a/arch/powerpc/kernel/Makefile	2026-11-06 19:15:59.000000000 +0100
+++ b/arch/powerpc/kernel/Makefile	2026-11-20 22:44:55.199869783 +0100
@@ -222,8 +222,12 @@
 clean-files := vmlinux.lds
 
 # Force dependency (incbin is bad)
-$(obj)/vdso32_wrapper.o : $(obj)/vdso/vdso32.so.dbg
-$(obj)/vdso64_wrapper.o : $(obj)/vdso/vdso64.so.dbg
+$(obj)/vdso32_wrapper.o : $(obj)/vdso/vdso32.so
+$(obj)/vdso64_wrapper.o : $(obj)/vdso/vdso64.so
+
+$(obj)/vdso/vdso%.so :
+	$(Q)$(MAKE) \
+		$(build)=arch/powerpc/kernel/vdso $@
 
 # for cleaning
 subdir- += vdso
