diff --git a/arch/powerpc/kernel/Makefile b/arch/powerpc/kernel/Makefile
index 7bf6b16b2d93..1dae989e826e 100644
--- a/arch/powerpc/kernel/Makefile
+++ b/arch/powerpc/kernel/Makefile
@@ -213,8 +213,12 @@ targets += prom_init_check
 clean-files := vmlinux.lds
 
 # Force dependency (incbin is bad)
-$(obj)/vdso32_wrapper.o : $(obj)/vdso/vdso32.so.dbg
-$(obj)/vdso64_wrapper.o : $(obj)/vdso/vdso64.so.dbg
+$(obj)/vdso32_wrapper.o : $(obj)/vdso/vdso32.so
+$(obj)/vdso64_wrapper.o : $(obj)/vdso/vdso64.so
+
+$(obj)/vdso/vdso%.so :
+	$(Q)$(MAKE) \
+		$(build)=arch/powerpc/kernel/vdso $@
 
 # for cleaning
 subdir- += vdso
