+	err = sock->ops->bind(sock, (struct sockaddr_unsized *) &my_addr, path->path.my_addr_len);
 	if (err < 0)
 		goto out;
 
@@ -1079,6 +1079,6 @@ static int dtl_init_listener(struct drbd_transport *transport,
