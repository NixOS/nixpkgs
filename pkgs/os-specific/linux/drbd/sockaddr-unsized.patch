Backport the bind() changes from upstream commit
57c336f7b6ae66039f6787fa74576c83f23e633a:
https://github.com/LINBIT/drbd/commit/57c336f7b6ae66039f6787fa74576c83f23e633a

Linux 6.18.57 backported sockaddr_unsized for bind(), but not connect().
Keep the connect() calls unchanged and detect the new type so older kernels
continue to use sockaddr.

diff --git a/drbd/drbd-kernel-compat/cocci/struct_sockaddr_unsized__no_present.cocci b/drbd/drbd-kernel-compat/cocci/struct_sockaddr_unsized__no_present.cocci
new file mode 100644
--- /dev/null
+++ b/drbd/drbd-kernel-compat/cocci/struct_sockaddr_unsized__no_present.cocci
@@ -0,0 +1,4 @@
+@@
+@@
+- struct sockaddr_unsized
++ struct sockaddr
diff --git a/drbd/drbd-kernel-compat/gen_patch_names.c b/drbd/drbd-kernel-compat/gen_patch_names.c
--- a/drbd/drbd-kernel-compat/gen_patch_names.c
+++ b/drbd/drbd-kernel-compat/gen_patch_names.c
@@ -668,6 +668,9 @@ int main(int argc, char **argv)
 	patch(1, "timer_container_of", true, false,
 	      COMPAT_HAVE_TIMER_CONTAINER_OF, "present");
 
+	patch(1, "struct_sockaddr_unsized", true, false,
+	      COMPAT_HAVE_STRUCT_SOCKADDR_UNSIZED, "present");
+
 /* #define BLKDEV_ISSUE_ZEROOUT_EXPORTED */
 /* #define BLKDEV_ZERO_NOUNMAP */
 
