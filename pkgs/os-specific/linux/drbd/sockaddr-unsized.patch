--- a/drbd/drbd_transport_lb-tcp.c
+++ b/drbd/drbd_transport_lb-tcp.c
@@ -624,6 +624,6 @@ dtl_try_connect(struct drbd_transport *transport, struct dtl_path *path, struct
 	 */
 	what = "bind before connect";
