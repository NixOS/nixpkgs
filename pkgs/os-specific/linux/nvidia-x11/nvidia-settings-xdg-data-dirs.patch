+/* The driver installs its data files in the XDG data directories, so look the
+   file up there rather than at a fixed path. */
+static char *find_driver_data_file(const char *name)
+{
+    const char * const *data_dirs;
+    int i;
+
+    if (name == NULL) {
+        return NULL;
+    }
+
+    data_dirs = g_get_system_data_dirs();
+
+    for (i = 0; data_dirs[i] != NULL; i++) {
+        char *candidate = g_build_filename(data_dirs[i], "nvidia", name, NULL);
+
+        if (access(candidate, F_OK) != -1) {
+            return candidate;
+        }
+
+        g_free(candidate);
+    }
+
+    return NULL;
+}
