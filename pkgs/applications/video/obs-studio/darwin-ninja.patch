+# _xcode_attribute_compile_options: Gives other generators the compiler options of an Xcode attribute
+function(_xcode_attribute_compile_options target key value)
+  if(XCODE OR NOT value STREQUAL YES)
+    return()
+  endif()
+  if(key STREQUAL CLANG_ENABLE_OBJC_ARC)
+    target_compile_options(${target} PRIVATE $<$<COMPILE_LANGUAGE:OBJC,OBJCXX>:-fobjc-arc>)
+  elseif(key STREQUAL CLANG_ENABLE_MODULES)
+    target_compile_options(${target} PRIVATE $<$<COMPILE_LANGUAGE:OBJC,OBJCXX>:-fmodules>)
+  endif()
+endfunction()
+
 # set_target_xcode_properties: Sets Xcode-specific target attributes
 function(set_target_xcode_properties target)
   set(options "")
@@ -16,6 +28,7 @@ function(set_target_xcode_properties target)
   while(_STXP_PROPERTIES)
     list(POP_FRONT _STXP_PROPERTIES key value)
     set_property(TARGET ${target} PROPERTY XCODE_ATTRIBUTE_${key} "${value}")
+    _xcode_attribute_compile_options(${target} ${key} "${value}")
   endwhile()
 endfunction()
 
