diff --git a/landlock_linux.go b/landlock_linux.go
index 9191986..03c024b 100644
--- a/landlock_linux.go
+++ b/landlock_linux.go
@@ -233,6 +233,30 @@ func setupLandlock() error {
 		logger.Printf("note: kernel does not support landlock net rules, sandboxing will be limited")
 	}
 
+	// A kernel without landlock gives no sandbox at all.
+	if err != nil {
+		if *requireLandlock {
+			return fmt.Errorf("kernel does not support landlock: %w", err)
+		}
+		logger.Printf("warning: kernel does not support landlock, running without the sandbox: %v", err)
+		abiVersion = 0
+	}
+
+	// go-landlock uses ABI 5 on a kernel with ABI 6 or later that lacks the
+	// fix for the signal scoping bug, so the warning below uses it too.
+	if abiVersion >= 6 {
+		errata, errataErr := llsys.LandlockGetErrata()
+		if errataErr != nil || errata&0x2 == 0 {
+			abiVersion = 5
+		}
+	}
+
+	// Below ABI 6, the sandbox lacks some restrictions but still limits the
+	// process, so this is a warning, also with --require-landlock.
+	if abiVersion >= 1 && abiVersion < 6 {
+		logger.Printf("warning: the landlock sandbox is incomplete, because the kernel provides ABI %d; ABI 6 or later provides all restrictions that ghostunnel requests", abiVersion)
+	}
+
 	// Enable best-effort mode: If the kernel doesn't support ABI v8, then go-landlock
 	// will enforce as much as possible given the ABI version that *is* available. Note
 	// that normally no error will be returned in best-effort mode, but we capture and
