cargo-auditable evaluates feature names for optional dependencies while
collecting dependency metadata. snarkOS only exposed snarkos-node-metrics
through `dep:` entries inside the `metrics` feature, so there was no public
`snarkos-node-metrics` feature for cargo-auditable to request.

Add explicit aliases that forward `snarkos-node-metrics` to `metrics`.
Adapted from NixOS/nixpkgs#378092.

diff --git i/cli/Cargo.toml w/cli/Cargo.toml
--- i/cli/Cargo.toml
+++ w/cli/Cargo.toml
@@ -27,6 +27,7 @@ locktick = [
   "snarkvm/locktick"
 ]
 metrics = [ "dep:snarkos-node-metrics", "snarkos-node/metrics" ]
+snarkos-node-metrics = [ "metrics" ]
 cuda = [
   "snarkvm/cuda",
   "snarkos-account/cuda",
diff --git i/node/bft/Cargo.toml w/node/bft/Cargo.toml
--- i/node/bft/Cargo.toml
