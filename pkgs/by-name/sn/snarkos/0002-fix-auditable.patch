@@ -34,6 +34,7 @@ metrics = [
   "snarkos-node-bft-ledger-service/metrics",
   "snarkos-node-network/metrics"
 ]
+snarkos-node-metrics = [ "metrics" ]
 cuda = [
   "snarkvm/cuda",
   "snarkos-account/cuda",
diff --git i/node/bft/ledger-service/Cargo.toml w/node/bft/ledger-service/Cargo.toml
--- i/node/bft/ledger-service/Cargo.toml
+++ w/node/bft/ledger-service/Cargo.toml
@@ -26,6 +26,7 @@ locktick = [
   "snarkos-utilities/locktick"
 ]
 metrics = [ "dep:snarkos-node-metrics", "snarkvm/metrics" ]
