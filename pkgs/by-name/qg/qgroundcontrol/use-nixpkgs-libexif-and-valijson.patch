 # ============================================================================
 # valijson (header-only JSON-Schema validator, native Qt-JSON adapter)
 # ============================================================================
 
-CPMAddPackage(
-    NAME valijson
-    GITHUB_REPOSITORY tristanpenman/valijson
-    # Pinned to 1.1.0: 1.1.1 calls std::from_chars(double) unguarded, which AppleClang's
-    # libc++ (macos-15/ios CI, pre-LLVM 20) lacks — valijson#239, fixed in 1.1.2.
-    GIT_TAG v1.1.0
-    EXCLUDE_FROM_ALL YES
-    OPTIONS
-        "valijson_BUILD_TESTS OFF"
-        "valijson_BUILD_EXAMPLES OFF"
-    # QtJsonAdapter isInteger()/getInteger() use 32-bit toInt(), so integral values
-    # > INT_MAX (e.g. PX4 uint32 fileCrc) fail "type": "integer" checks or truncate.
-    PATCHES valijson-qtjson-int64.patch
-)
+# Upstream's own CMake install produces no valijsonConfigVersion.cmake at
+# all, so any version constraint here is unsatisfiable (find_package
+# rejects it as "version: unknown") - omit one; the QtJsonAdapter
+# int64-truncation fix QGC originally pinned >=1.1.2 for is applied
+# directly to the real nixpkgs valijson package instead (see
+# pkgs/by-name/va/valijson), independent of whichever version that is.
+find_package(valijson REQUIRED)
+
+# nixpkgs' valijson installs the bare "valijson" target (no ValiJSON::
+# namespace); alias it to match what QGCParsing links below.
+add_library(ValiJSON::valijson ALIAS valijson)
 
 target_link_libraries(QGCParsing
