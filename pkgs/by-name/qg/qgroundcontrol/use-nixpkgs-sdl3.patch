-    OPTIONS
-        "SDL_INSTALL OFF"
-        "SDL_UNINSTALL OFF"
-        "SDL_SHARED ${SDL_SHARED_FLAG}"
-        "SDL_STATIC ${SDL_STATIC_FLAG}"
-        "SDL_TEST_LIBRARY OFF"
-        "SDL_EXAMPLES OFF"
-        "SDL_AUDIO OFF"
