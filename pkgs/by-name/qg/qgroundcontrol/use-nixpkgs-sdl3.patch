-        "SDL_RENDER OFF"
-        "SDL_CAMERA OFF"
-        "SDL_JOYSTICK ON"
-        "SDL_HAPTIC ON"
-        "SDL_HIDAPI ON"
-        "SDL_POWER ON"
-        "SDL_SENSOR ON"
-        "SDL_DIALOG OFF"
-        "SDL_CCACHE ON"
-        "SDL_DBUS OFF"
-        "SDL_IBUS OFF"
-        "SDL_MMX OFF"
-        "SDL_VIRTUAL_JOYSTICK ON"
