+# Try the real package directly first: CPM's own NAMES override
+# (FIND_PACKAGE_ARGUMENTS below) finds GeographicLib's real config file, but
+# GeographicLib's own *-config-version.cmake defensively rejects any match
+# whose CMAKE_FIND_PACKAGE_NAME is not literally "GeographicLib" - which it
+# never is when found via CPM, since CPM's own NAME positional argument
+# (lowercase "geographiclib") is what actually sets that variable. Finding it
+# ourselves first means CPM_LOCAL_PACKAGES_ONLY never falls through to its
+# own (also broken for this exact case, and in the sandbox, fatal)
+# network-fetch fallback below.
+find_package(GeographicLib 2.7 QUIET)
+
+if(NOT GeographicLib_FOUND)
+    CPMAddPackage(
+        NAME geographiclib
+        VERSION 2.7
+        GITHUB_REPOSITORY geographiclib/geographiclib
+        GIT_TAG r2.7
+        # System package installs its config as `GeographicLib`, not `geographiclib`.
+        FIND_PACKAGE_ARGUMENTS "NAMES GeographicLib"
+        OPTIONS
+            "BUILD_BOTH_LIBS OFF"
+            "BUILD_DOCUMENTATION OFF"
+            "BUILD_MANPAGES OFF"
+            "PACKAGE_DEBUG_LIBS OFF"
+            "APPLE_MULTIPLE_ARCHITECTURES OFF"
+            "INCDIR OFF"
+            "BINDIR OFF"
+            "SBINDIR OFF"
+            "LIBDIR OFF"
+            "DLLDIR ${CMAKE_INSTALL_BINDIR}"
+            "MANDIR OFF"
+            "CMAKEDIR OFF"
+            "PKGDIR OFF"
+            "DOCDIR OFF"
+            "EXAMPLEDIR OFF"
+        PATCHES geographiclib.patch
+    )
+endif()
 
-# geographiclib_ADDED is set only when CPM downloads; geographiclib_FOUND when
