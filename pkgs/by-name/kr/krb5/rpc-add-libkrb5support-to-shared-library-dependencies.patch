From 6c872777f0dceaf9f28992cb1c61d771c048cf1a Mon Sep 17 00:00:00 2001
From: catalin-h <catalin.horghidan@gmail.com>
Date: Thu, 12 Nov 2026 18:19:17 +0200
Subject: [PATCH] build: rpc: add libkrb5support to shared library dependencies

After a change in release 1.22.3 the libgssrpc build breaks when linking against an glibc older 2.17 as it requires support for secure_getenv. To compensate for the lack of secure_getenv, libkrb5support exports the in-house function k5_secure_getenv.
The patch adds libkrb5support as a link dependency for libgssrpc.
---
 lib/rpc/Makefile.in | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/lib/rpc/Makefile.in b/lib/rpc/Makefile.in
index 39db2d3ce9e..7658f4ff709 100644
--- a/lib/rpc/Makefile.in
+++ b/lib/rpc/Makefile.in
@@ -14,8 +14,9 @@ SHLIB_EXPDEPS= \
 	$(TOPLIBD)/libgssapi_krb5$(SHLIBEXT) \
 	$(TOPLIBD)/libkrb5$(SHLIBEXT) \
 	$(TOPLIBD)/libk5crypto$(SHLIBEXT) \
+	$(TOPLIBD)/libkrb5support$(SHLIBEXT) \
 	$(COM_ERR_DEPLIB)
-SHLIB_EXPLIBS=-lgssapi_krb5 -lkrb5 -lk5crypto $(COM_ERR_LIB) $(LIBS)
+SHLIB_EXPLIBS=-lgssapi_krb5 -lkrb5 -lk5crypto -lkrb5support $(COM_ERR_LIB) $(LIBS)
 RELDIR=rpc
 
 SRCS = $(srcdir)/auth_none.c \
