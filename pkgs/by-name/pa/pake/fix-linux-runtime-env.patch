@@ -4,5 +4,42 @@
 )]
 
 fn main() {
+    #[cfg(target_os = "linux")]
+    {
+        let gio_modules = "@GIO_EXTRA_MODULES@";
+        match std::env::var("GIO_EXTRA_MODULES") {
+            Ok(val) => {
+                if !val.split(':').any(|p| p == gio_modules) {
+                    std::env::set_var("GIO_EXTRA_MODULES", format!("{}:{}", gio_modules, val));
+                }
+            }
+            Err(_) => {
+                std::env::set_var("GIO_EXTRA_MODULES", gio_modules);
+            }
+        }
+        let gst_plugins = "@GST_PLUGIN_SYSTEM_PATH_1_0@";
+        match std::env::var("GST_PLUGIN_SYSTEM_PATH_1_0") {
+            Ok(val) => {
+                if !val.split(':').any(|p| p == gst_plugins) {
+                    std::env::set_var("GST_PLUGIN_SYSTEM_PATH_1_0", format!("{}:{}", gst_plugins, val));
+                }
+            }
+            Err(_) => {
+                std::env::set_var("GST_PLUGIN_SYSTEM_PATH_1_0", gst_plugins);
+            }
+        }
+        if std::env::var_os("WEBKIT_GST_ALLOWED_URI_PROTOCOLS").is_none() {
+            std::env::set_var("WEBKIT_GST_ALLOWED_URI_PROTOCOLS", "asset");
+        }
+        if std::env::var_os("__NV_DISABLE_EXPLICIT_SYNC").is_none() {
+            std::env::set_var("__NV_DISABLE_EXPLICIT_SYNC", "1");
+        }
+        if std::env::var_os("GST_PLUGIN_FEATURE_RANK").is_none() {
+            std::env::set_var("GST_PLUGIN_FEATURE_RANK", "vaav1dec:NONE,vavp9dec:NONE,vah264dec:NONE,vah265dec:NONE,vavp8dec:NONE");
+        }
+        if std::env::var("GDK_BACKEND").as_deref() == Ok("wayland,x11") && std::env::var_os("DISPLAY").is_some() {
+            std::env::set_var("GDK_BACKEND", "x11");
+        }
+    }
     app_lib::run()
 }
