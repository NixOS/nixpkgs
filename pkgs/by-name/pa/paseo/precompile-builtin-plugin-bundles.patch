+export const PREBUILT_BUNDLES_FILENAME = "paseo-prebuilt-bundles.json";
+
+async function readPrebuiltBundles(
+  directory: string,
+): Promise<{ clientBundle: string | null; serverBundle: string | null } | null> {
+  const filePath = path.join(directory, PREBUILT_BUNDLES_FILENAME);
+  const info = await stat(filePath).catch(() => null);
+  if (!info?.isFile()) return null;
+  try {
+    const parsed: unknown = JSON.parse(await readFile(filePath, "utf8"));
+    if (typeof parsed !== "object" || parsed === null) return null;
+    const { serverBundle, clientBundle } = parsed as {
+      serverBundle?: unknown;
+      clientBundle?: unknown;
+    };
+    if (typeof serverBundle !== "string" && typeof clientBundle !== "string") return null;
+    return {
+      serverBundle: typeof serverBundle === "string" ? serverBundle : null,
+      clientBundle: typeof clientBundle === "string" ? clientBundle : null,
+    };
+  } catch {
+    return null;
+  }
+}
