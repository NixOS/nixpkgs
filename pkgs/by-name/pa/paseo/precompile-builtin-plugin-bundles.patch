+import { readdir, readFile, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+
+import { PREBUILT_BUNDLES_FILENAME } from "../packages/server/dist/server/server/plugins/compiler-build.js";
+
+const REPO_ROOT = path.resolve(import.meta.dirname, "..");
+const BUILTIN_PLUGINS_ROOT = path.join(
+  REPO_ROOT,
+  "packages/server/dist/server/builtin-plugins",
+);
+
+const { version } = JSON.parse(
+  await readFile(path.join(REPO_ROOT, "packages/server/package.json"), "utf8"),
+);
+const { compileDirectoryPlugin } = await import(
+  pathToFileURL(
+    path.join(REPO_ROOT, "packages/server/dist/server/server/plugins/compiler.js"),
+  ).href
+);
+
+const directories = (await readdir(BUILTIN_PLUGINS_ROOT, { withFileTypes: true }))
+  .filter((entry) => entry.isDirectory())
+  .map((entry) => entry.name)
+  .sort();
+
+for (const id of directories) {
+  const directory = path.join(BUILTIN_PLUGINS_ROOT, id);
+  const started = Date.now();
+  const { clientBundle, serverBundle } = await compileDirectoryPlugin(directory, version, id);
+  await writeFile(
+    path.join(directory, PREBUILT_BUNDLES_FILENAME),
+    `${JSON.stringify({ serverBundle, clientBundle })}\n`,
+  );
+  process.stdout.write(
+    `pre-compiled ${id}: server ${serverBundle?.length ?? 0}B, client ${clientBundle?.length ?? 0}B in ${Date.now() - started}ms\n`,
+  );
+}
