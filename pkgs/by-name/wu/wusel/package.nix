{
  lib,
  stdenv,
  rustPlatform,
  fetchFromGitHub,
  fuse3,
  glib,
  nautilus,
  pkg-config,
  copyDesktopItems,
  makeDesktopItem,
  nix-update-script,
}:

rustPlatform.buildRustPackage (finalAttrs: {
  pname = "wusel";
  version = "0.4.0";

  src = fetchFromGitHub {
    owner = "itbh-at";
    repo = "wusel";
    tag = "v${finalAttrs.version}";
    hash = "sha256-3o8WKCzdVLJQPmADj3Q/ML9ooqNfH33sn3FP99xCKt0=";
  };

  cargoHash = "sha256-Ul5vAw2C2OFRHcmRnBh6UbRWDg8EEBEvBh4dGrnz7OU=";

  buildFeatures = lib.optionals stdenv.hostPlatform.isLinux [ "fuse" ];

  nativeBuildInputs = [
    pkg-config
    copyDesktopItems
  ];

  buildInputs = lib.optionals stdenv.hostPlatform.isLinux [
    fuse3
    glib
    nautilus
  ];

  # Linux-only: the FUSE mount, the Nautilus extension and the GNOME Shell
  # search provider all rely on Linux-only libraries. The CLI/engine still
  # builds elsewhere, but the binary would be useless without the FUSE mount.
  meta.platforms = lib.platforms.linux;

  # Building every test pulls in the FUSE mount's end-to-end tests which
  # need /dev/fuse and a writable cache. The build sandbox has neither.
  doCheck = false;

  # Build the C Nautilus extension (Makefile-driven) and stage every file
  # the upstream packaging scripts install. The source tree is read-only
  # in the nix store, so copy the Makefile + sources to a writable dir first.
  preInstall = lib.optionalString stdenv.hostPlatform.isLinux ''
    cp -r $src/integration/nautilus /tmp/wusel-nautilus-build
    chmod -R u+w /tmp/wusel-nautilus-build
    make -C /tmp/wusel-nautilus-build \
      PKG=libnautilus-extension-4
  '';

  postInstall = lib.optionalString stdenv.hostPlatform.isLinux ''
    pushd $src

    # Native Nautilus extension (built in /tmp earlier — see preInstall)
    install -Dm755 /tmp/wusel-nautilus-build/libwusel-nautilus.so \
      $out/lib/nautilus/extensions-4/libwusel-nautilus.so

    # State emblems (cloud / cached / pinned / …) — into the cross-desktop
    # hicolor theme so every freedesktop file manager finds them.
    install -Dm644 integration/nautilus/emblems/wusel-emblem-*.svg \
      -t $out/share/icons/hicolor/scalable/emblems
    # also touch the parent directory so the package owns it even when no
    # emblem is shipped yet (parity with the rpm spec, which marks %dir).
    mkdir -p $out/share/icons/hicolor/scalable/emblems

    # App icons — full colour for the launcher / search header, monochrome
    # symbolic for the file-manager sidebar (GTK re-tints it to the theme fg).
    install -Dm644 integration/icons/at.itbh.Wusel.svg \
      $out/share/icons/hicolor/scalable/apps/at.itbh.Wusel.svg
    install -Dm644 integration/icons/at.itbh.Wusel-symbolic.svg \
      $out/share/icons/hicolor/symbolic/apps/at.itbh.Wusel-symbolic.svg

    # Search-provider launcher + its registration; the GNOME Shell .service
    # runs on demand via D-Bus activation.
    install -Dm644 integration/gnome-search/at.itbh.Wusel.desktop \
      -t $out/share/applications/
    install -Dm644 integration/gnome-search/wusel-search-provider.desktop \
      -t $out/share/gnome-shell/search-providers/

    # D-Bus activation for the search provider — Exec= must be absolute and
    # point at the packaged binary, not the source default `/usr/local/bin`.
    mkdir -p $out/share/dbus-1/services
    substitute \
      integration/gnome-search/at.itbh.Wusel.SearchProvider.service \
      $out/share/dbus-1/services/at.itbh.Wusel.SearchProvider.service \
      --replace-fail "/usr/local/bin/wusel" "$out/bin/wusel"

    # Cloud-provider (Nautilus sidebar) registration for the default account —
    # generated by the freshly built binary so it never drifts from the code.
    # `$out/bin/wusel` is on PATH inside the install hook.
    PATH="$out/bin:$PATH" \
      $out/bin/wusel desktop install-provider \
        --account default --dir $out/share/applications \
        >/dev/null

    # install-provider calls update-desktop-database, which leaves a mimeinfo.cache
    # in the applications dir — not ours to ship, and rpmbuild/nix-store would
    # reject an unpackaged file. Drop it here too.
    rm -f $out/share/applications/mimeinfo.cache

    # Systemd *user* unit template: one instance per account (wusel@default,
    # wusel@work, …). Path hardcoded — see the matching note in the spec.
    install -Dm644 packaging/rpm/wusel@.service \
      $out/lib/systemd/user/wusel@.service

    popd
  '';

  desktopItems = lib.optionals stdenv.hostPlatform.isLinux [
    # Replaces the upstream `Exec=sh -c 'xdg-open "$HOME/Wusel"'` line with
    # the absolute path to the packaged binary so it works on a clean
    # $HOME (no /etc/skel/Wusel yet) without falling back to the generic file
    # manager.
    (makeDesktopItem {
      name = "at.itbh.Wusel";
      type = "Application";
      desktopName = "Wusel";
      comment = "Nextcloud files via Wusel";
      icon = "at.itbh.Wusel";
      exec = "wusel mount --account default";
      terminal = false;
      categories = [
        "Network"
        "Utility"
      ];
    })
  ];

  passthru.updateScript = nix-update-script { };

  meta = {
    description = "VFS-first virtual Nextcloud filesystem for Linux (FUSE + GNOME integration)";
    longDescription = ''
      Wusel makes a Nextcloud appear as an ordinary folder on Linux — VFS-first:
      files are online-only by default and are fetched on access (on-demand
      hydration), instead of mirroring everything locally. On top of FUSE it
      ships a full GNOME desktop integration (Nautilus sidebar + per-file
      emblems + a pin/unpin context menu) and a GNOME Shell search provider
      backed by Nextcloud Unified Search.

      The mount runs as a systemd *user* service, one instance per account:
        wusel login https://cloud.example.org
        systemctl --user enable --now wusel@default
    '';
    homepage = "https://github.com/itbh-at/wusel";
    changelog = "https://github.com/itbh-at/wusel/releases/tag/v${finalAttrs.version}";
    license = lib.licenses.asl20;
    maintainers = with lib.maintainers; [ ser ];
    mainProgram = "wusel";
  };
})

