+++ b/src/rgw/CMakeLists.txt
@@ -317,6 +317,7 @@ target_link_libraries(rgw_common
     OATH::OATH
     dmclock::dmclock
     ${CURL_LIBRARIES}
+    expat
     ${EXPAT_LIBRARIES}
     ${ARROW_LIBRARIES}
     ${ARROW_FLIGHT_LIBRARIES}
diff --git a/src/rgw/driver/dbstore/CMakeLists.txt b/src/rgw/driver/dbstore/CMakeLists.txt
index 0226c3afb02039b4bdf9bd338908d72fe571449e..d6bb6bab75f4f82a1b5c370404442d50c1839412 100644
--- a/src/rgw/driver/dbstore/CMakeLists.txt
+++ b/src/rgw/driver/dbstore/CMakeLists.txt
@@ -37,7 +37,13 @@ if(WITH_JAEGER)
   list(APPEND link_targets jaeger_base)
 endif()
 list(APPEND link_targets rgw_common)
-target_link_libraries(dbstore_lib PUBLIC ${link_targets})
+find_package(EXPAT REQUIRED)
+target_link_libraries(dbstore_lib
+	PRIVATE
+	${EXPAT_LIBRARIES}
+	PUBLIC
+	${link_targets}
+)
 
 set (CMAKE_LINK_LIBRARIES ${CMAKE_LINK_LIBRARIES} dbstore_lib)
 
