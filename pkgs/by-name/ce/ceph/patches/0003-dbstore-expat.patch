 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/rgw/CMakeLists.txt b/src/rgw/CMakeLists.txt
index aebcc19d56ae1aa1a3e20edaf82c1ad6c08d508a..e64b14440c16fec945e46b1c113bf0710ad99bc6 100644
