+ * Prefer the runtime-recommended signal stack size when available. Some
+ * libc implementations define SIGSTKSZ as a fixed value smaller than the
+ * kernel minimum on CPUs with large signal frames.
  */
 static char *altstack;
+#ifdef _SC_SIGSTKSZ
+#define ALTSTACK_SIZE (sysconf(_SC_SIGSTKSZ) + SECRETBYTES)
+#else
 #define ALTSTACK_SIZE (SIGSTKSZ + SECRETBYTES)
+#endif
 
