+/* Same order as nixpkgs' openssl; setuid programs ignore the variables. */
+static const char *
+nix_cert_file_env(void)
+{
+	static const char *names[] = { "NIX_SSL_CERT_FILE", "SSL_CERT_FILE" };
+	const char *file;
+	size_t i;
+
+	for (i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+#if defined(__linux__)
+		file = secure_getenv(names[i]);
+#elif defined(_WIN32)
+		file = getenv(names[i]);
+#else
+		file = issetugid() ? NULL : getenv(names[i]);
+#endif
+		if (file != NULL)
+			return file;
+	}
+	return NULL;
+}
