+/// Environment variable pointing TriOS at a Starsector installation that lives
+/// outside the user's reach for writes — a Nixpkgs store path, for example.
+const gameDirEnvVar = 'STARSECTOR_DIR';
+
+/// The raw [gameDirEnvVar] value, or null when unset. Use
+/// `gameDirFromEnvironment()` from `platform_paths.dart` for a validated one.
+String? gameDirFromEnvironmentRaw() {
+  final candidate = Platform.environment[gameDirEnvVar];
+  if (candidate == null || candidate.isEmpty) {
+    return null;
+  }
+  return candidate;
+}
+
+/// The XDG base directory for user-specific data, or null when it cannot be
+/// determined. Follows the Base Directory Specification: `$XDG_DATA_HOME`,
+/// falling back to `$HOME/.local/share`.
+Directory? xdgDataHome() {
+  final fromEnv = Platform.environment['XDG_DATA_HOME'];
+  if (fromEnv != null && fromEnv.isNotEmpty) {
+    return Directory(fromEnv);
+  }
+  final home = Platform.environment['HOME'];
+  if (home == null || home.isEmpty) {
+    return null;
+  }
+  return Directory(p.join(home, ".local", "share"));
+}
+
+/// [path] with symlinks resolved, falling back to an absolute lexical path when
+/// it cannot be resolved (it may not exist yet).
+String _resolvedPath(String path) {
+  try {
+    return Directory(path).resolveSymbolicLinksSync();
+  } catch (_) {
+    return Directory(path).absolute.normalize.path;
+  }
+}
+
+/// Whether [gamePath] is the installation advertised through [gameDirEnvVar].
+///
+/// Distributions such as Nixpkgs install the game into a read-only prefix and
+/// hand the game its writable directories via
+///   -Dcom.fs.starfarer.settings.paths.mods=<data home>/starsector/mods
+///   -Dcom.fs.starfarer.settings.paths.saves=<data home>/starsector/saves
+///   -Dcom.fs.starfarer.settings.paths.logs=<data home>/starsector
+/// so that is where TriOS has to read and write them. This is deliberately
+/// gated on the *selected* game folder being that installation, compared with
+/// symlinks resolved so a profile symlink and the store path it points at
+/// compare equal: a second, writable copy the user picked keeps upstream's
+/// layout, where mods, saves and the log sit next to the game.
+bool isEnvAdvertisedGameRoot(Directory gamePath) {
+  final fromEnv = gameDirFromEnvironmentRaw();
+  if (fromEnv == null) {
+    return false;
+  }
+  return p.equals(_resolvedPath(gamePath.path), _resolvedPath(fromEnv));
+}
+
+/// The per-user Starsector directory the game is pointed at when it is installed
+/// read-only, i.e. `$XDG_DATA_HOME/starsector`, or null when it cannot be
+/// determined.
+Directory? xdgStarsectorHome() {
+  final dataHome = xdgDataHome();
+  if (dataHome == null) {
+    return null;
+  }
+  return Directory(p.join(dataHome.path, "starsector")).normalize;
+}
