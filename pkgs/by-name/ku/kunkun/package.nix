{
  lib,
  _experimental-update-script-combinators,
  cargo-tauri,
  cmake,
  deno,
  desktop-file-utils,
  fetchFromGitHub,
  fetchPnpmDeps,
  fetchurl,
  glib-networking,
  gtk3,
  libayatana-appindicator,
  librsvg,
  libxtst,
  nix-update-script,
  nodejs,
  openssl,
  pkg-config,
  pnpmConfigHook,
  pnpm_10,
  protobuf,
  rustPlatform,
  webkitgtk_4_1,
  wrapGAppsHook3,
  xdg-utils,
  xdotool,
  xprop,
}:

let
  pnpm = pnpm_10;

  # The public Supabase credentials the frontend is built against. Upstream
  # keeps them out of the source tree and injects them from
  # <https://storage.kunkun.sh/env.json> through
  # `packages/ci/scripts/init-env.ts`, so mirror that file here. It is
  # refreshed by `update-scripts/env.nu`.
  upstreamEnv = lib.importJSON ./generated-data/env.json;

  # `apps/desktop/project.inlang/settings.json` refers to these modules by
  # jsDelivr URL with an unpinned `@latest` specifier. We pin a resolved version
  # of each and rewrite the URLs in the settings to the resulting store paths.
  # The pins are regenerated by `update-scripts/inlang-plugins.nu`.
  inlangModules = lib.mapAttrs (_: info: fetchurl { inherit (info) url hash; }) (
    lib.importJSON ./generated-data/inlang-plugins.json
  );
in
rustPlatform.buildRustPackage (finalAttrs: {
  pname = "kunkun";
  version = "0.1.37";

  src = fetchFromGitHub {
    owner = "kunkunsh";
    repo = "kunkun";
    tag = "Kunkun-v${finalAttrs.version}";
    hash = "sha256-XkYgAD8Q5Ys+t4ovHyeuIz+l2pyXncUN6y3nCsjOtZ8=";
    fetchSubmodules = true;
  };

  cargoHash = "sha256-GAANH8xFppslCcwh1FSxDdmnzIf1qOlzNSHOKgbTx30=";

  pnpmDeps = fetchPnpmDeps {
    inherit (finalAttrs) pname version src;
    inherit pnpm;
    fetcherVersion = 4;
    hash = "sha256-1Jt9h9dY5vVaHNSvniku37ky4efZC/Wcc37xxfy49rs=";
  };

  __structuredAttrs = true;

  patches = [
    ./applications-rs-honour-xdg-data-dirs.patch
  ];

  postPatch = ''
    ${lib.concatStringsSep "\n" (
      lib.mapAttrsToList (remote: drv: ''
        substituteInPlace apps/desktop/project.inlang/settings.json \
          --replace-fail "${remote}" "${drv}"
      '') inlangModules
    )}

    # `packages/tauri-plugins/jarvis/setup.ts` downloads this public key and
    # `build.rs` then embeds it via `include_bytes!`. Kept in sync with
    # `update-scripts/server-public-key.nu`.
    install -m644 ${./generated-data/server_public_key.pem} packages/tauri-plugins/jarvis/keys/server_public_key.pem

    # `libappindicator-sys` loads the library with `dlopen` by bare soname. It
    # is never linked, so the store path does not end up on the binary's
    # RUNPATH, and there is no ld.so cache or /usr/lib to fall back on. Without
    # this the tray icon setup panics inside the `Builder::setup` callback,
    # i.e. the app fails to start at all.
    substituteInPlace $cargoDepsCopy/*/libappindicator-sys-*/src/lib.rs \
      --replace-fail \
        '"libayatana-appindicator3.so.1"' \
        '"${libayatana-appindicator}/lib/libayatana-appindicator3.so.1"'
  '';

  nativeBuildInputs = [
    cargo-tauri.hook
    cmake # required by the `libz-ng-sys` crate
    desktop-file-utils
    nodejs
    pkg-config
    pnpm
    pnpmConfigHook
    protobuf # required by the `tonic-build` crate
    wrapGAppsHook3
  ];

  buildInputs = [
    glib-networking
    gtk3
    libayatana-appindicator
    librsvg
    openssl
    webkitgtk_4_1

    # `tauri-plugin-user-input` listens for input events with `rdev` and
    # simulates them with `enigo`
    libxtst # for `rdev`, which uses the XRecord and XTEST extensions
    xdotool # for `enigo`, which links libxdo
  ];

  buildAndTestSubdir = "apps/desktop/src-tauri";

  env = {
    OPENSSL_NO_VENDOR = true;

    PUBLIC_SUPABASE_URL = upstreamEnv.SUPABASE_URL;
    PUBLIC_SUPABASE_ANON_KEY = upstreamEnv.SUPABASE_ANON_KEY;
  };

  preBuild = ''
    # Upstream builds the workspace with `turbo build`, but the Tauri hook only
    # reaches `apps/desktop`'s `vite build`, so the JavaScript side of the
    # vendored tauri plugins would still be unbuilt when the frontend imports it.
    pnpm --filter='tauri-plugin-*-api' build

    # `apps/desktop/setup.ts` downloads the dance animation and stores it
    # lz-string compressed for `dance.svelte` to import. `pnpmConfigHook`
    # installs with `--ignore-scripts` so it never runs. Reproduce its output
    # from the copy that `update-scripts/dance.nu` mirrors instead.
    mkdir -p apps/desktop/src/data
    pushd apps/desktop
    node -e 'const fs = require("fs"); fs.writeFileSync(
      "src/data/dance.bin",
      require("lz-string").compressToBase64(fs.readFileSync("${./generated-data/dance.json}", "utf8"))
    )'
    popd
  '';

  preFixup = ''
    # Extensions are executed by spawning `deno` from PATH, `applications-rs`
    # shells out to `xprop` to identify the frontmost application and the `open`
    # crate spawns `xdg-open` to hand URLs and paths to the desktop's default
    # handler.
    # Suffixed so that a user installed `deno` or `xdg-open` takes precedence.
    gappsWrapperArgs+=(--suffix PATH : ${
      lib.makeBinPath [
        deno
        xdg-utils
        xprop
      ]
    })
  '';

  postInstall = ''
    # Tauri generates the file but we edit these fields because:
    #   Categories: empty
    #   Exec: bare exec would drop the URL argument
    #   MimeType: upstream types its `.kunkun` extension installers as
    #     `text/plain`, which would claim every plain text file. Dropping it
    #     drops the installer association too, which was the only type declared
    #     for it.
    desktop-file-edit \
      --set-key="Categories" --set-value="Utility;" \
      --set-key="Exec" --set-value="kunkun %u" \
      --set-key="MimeType" --set-value="x-scheme-handler/kunkun;" \
      "$out/share/applications/kunkun.desktop"
  '';

  passthru.updateScript = _experimental-update-script-combinators.sequence [
    (nix-update-script {
      extraArgs = [
        "--version-regex"
        "Kunkun-v(.*)"
      ];
    })
    ./update-scripts/dance.nu
    ./update-scripts/env.nu
    ./update-scripts/inlang-plugins.nu
    ./update-scripts/server-public-key.nu
  ];

  meta = {
    description = "Cross-platform extensible application launcher";
    homepage = "https://kunkun.sh";
    changelog = "https://github.com/kunkunsh/kunkun/releases/tag/${finalAttrs.src.tag}";
    license = lib.licenses.gpl3Only;
    maintainers = with lib.maintainers; [ ilkecan ];
    mainProgram = "kunkun";
    # The maintainer cannot test Darwin, so please create a PR if it matters to
    # you.
    platforms = lib.platforms.linux;
  };
})
