+
+/// Select fixtures that request the conventional x86-64 glibc loader.
+fn needs_nix_loader(path: &OsStr) -> bool {
+    let Ok(data) = std::fs::read(path) else {
+        return false;
+    };
+    let Ok(elf) = ElfFile64::<object::Endianness>::parse(data.as_slice()) else {
+        return false;
+    };
+    elf.elf_program_headers().iter().any(|header| {
+        header
+            .interpreter(elf.endian(), data.as_slice())
+            .ok()
+            .flatten()
+            == Some(&b"/lib64/ld-linux-x86-64.so.2"[..])
+    })
 }

