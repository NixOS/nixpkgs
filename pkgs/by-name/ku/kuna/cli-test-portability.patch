 /// A required command must exist and exit successfully.
 pub fn required_output(command: &mut Command) -> Output {
     optional_output(command).unwrap_or_else(|| panic!("required command not found: {command:?}"))
+}
+
+/// Run a fixture through an explicitly configured ELF loader, if supplied.
+pub fn fixture_output(path: impl AsRef<Path>) -> Output {
+    let path = path.as_ref();
+    if let Some(loader) = std::env::var_os("KUNA_TEST_LD_SO") {
+        required_output(Command::new(loader).arg(path))
+    } else {
+        required_output(&mut Command::new(path))
+    }
 }

