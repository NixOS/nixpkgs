+/* ------------------------------------------------------------------ */
+/*  Cached GL offscreen instance (reused between player sessions)      */
+/* ------------------------------------------------------------------ */
+static pthread_mutex_t glCacheMutex = PTHREAD_MUTEX_INITIALIZER;
+static struct {
+    int valid;
+    int useGLX;
+    int gbmFd;
