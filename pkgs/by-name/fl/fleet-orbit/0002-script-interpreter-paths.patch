 package scripts
 
 import (
+	"bytes"
 	"context"
 	"os"
 	"os/exec"
 	"path/filepath"
+	"strings"
 	"time"
 
 	"github.com/fleetdm/fleet/v4/server/contexts/ctxerr"
 	"github.com/fleetdm/fleet/v4/server/fleet"
 )
 
+var (
+	scriptEnvPath     string
+	scriptShPath      string
+	scriptBashPath    string
+	scriptZshPath     string
+	scriptPythonPath  string
+	scriptPython3Path string
+)
+
+func configuredInterpreterPath(configured, original string) string {
+	if configured != "" {
+		return configured
+	}
+	return original
+}
+
+func shebangInterpreterPath(interpreter string) string {
+	switch base := filepath.Base(interpreter); {
+	case base == "env":
+		return configuredInterpreterPath(scriptEnvPath, interpreter)
+	case base == "sh":
+		return configuredInterpreterPath(scriptShPath, interpreter)
+	case base == "bash":
+		return configuredInterpreterPath(scriptBashPath, interpreter)
+	case base == "zsh":
+		return configuredInterpreterPath(scriptZshPath, interpreter)
+	case base == "python":
+		return configuredInterpreterPath(scriptPythonPath, interpreter)
+	case base == "python3" || strings.HasPrefix(base, "python3."):
+		return configuredInterpreterPath(scriptPython3Path, interpreter)
+	default:
+		return interpreter
+	}
+}
+
+func envShebangCommand(text string, start, end int) (int, int, bool) {
+	hasSplitOption := false
+	for start < end {
+		for start < end && (text[start] == ' ' || text[start] == '\t') {
+			start++
+		}
+		tokenStart := start
+		for start < end && text[start] != ' ' && text[start] != '\t' {
+			start++
+		}
+		if tokenStart == start {
+			break
+		}
+		if text[tokenStart:start] == "-S" {
+			hasSplitOption = true
+		}
+		if text[tokenStart] != '-' {
+			return tokenStart, start, hasSplitOption
+		}
+	}
+	return -1, -1, hasSplitOption
+}
+
+func rewriteShebang(contents []byte) []byte {
+	directExecute, err := fleet.ValidateShebang(string(contents))
+	if err != nil || !directExecute {
+		return contents
+	}
+
+	text := string(contents)
+	lineEnd := strings.IndexByte(text, '\n')
+	if lineEnd == -1 {
+		lineEnd = len(text)
+	}
+	parseEnd := lineEnd
+	if parseEnd > 0 && text[parseEnd-1] == '\r' {
+		parseEnd--
+	}
+	if parseEnd < 2 || !strings.HasPrefix(text, "#!") {
+		return contents
+	}
+
+	interpreterStart := 2
+	for interpreterStart < parseEnd && (text[interpreterStart] == ' ' || text[interpreterStart] == '\t') {
+		interpreterStart++
+	}
+	interpreterEnd := interpreterStart
+	for interpreterEnd < parseEnd && text[interpreterEnd] != ' ' && text[interpreterEnd] != '\t' {
+		interpreterEnd++
+	}
+	if interpreterStart == interpreterEnd {
+		return contents
+	}
+
+	interpreter := text[interpreterStart:interpreterEnd]
+	replacement := shebangInterpreterPath(interpreter)
+	if filepath.Base(interpreter) == "env" {
+		commandStart, commandEnd, hasSplitOption := envShebangCommand(text, interpreterEnd, parseEnd)
+		if commandStart != -1 {
+			command := text[commandStart:commandEnd]
+			commandReplacement := shebangInterpreterPath(command)
+			splitOption := ""
+			if !hasSplitOption && len(strings.Fields(text[interpreterEnd:parseEnd])) > 1 {
+				splitOption = " -S"
+			}
+			if replacement != interpreter || commandReplacement != command || splitOption != "" {
+				return []byte(text[:interpreterStart] + replacement + splitOption + text[interpreterEnd:commandStart] + commandReplacement + text[commandEnd:])
+			}
+		}
+	}
+	if replacement == interpreter {
+		return contents
+	}
+
+	return []byte(text[:interpreterStart] + replacement + text[interpreterEnd:])
+}
+
 func ExecCmd(ctx context.Context, scriptPath string, env []string) (output []byte, exitCode int, err error) {
 	// initialize to -1 in case the process never starts
 	exitCode = -1
