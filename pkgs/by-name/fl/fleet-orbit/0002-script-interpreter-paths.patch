 }
+
+func TestRewriteShebang(t *testing.T) {
+	oldEnv, oldSh := scriptEnvPath, scriptShPath
+	oldBash, oldZsh := scriptBashPath, scriptZshPath
+	oldPython, oldPython3 := scriptPythonPath, scriptPython3Path
+	t.Cleanup(func() {
+		scriptEnvPath, scriptShPath = oldEnv, oldSh
+		scriptBashPath, scriptZshPath = oldBash, oldZsh
+		scriptPythonPath, scriptPython3Path = oldPython, oldPython3
+	})
+
+	scriptEnvPath = "/nix/store/coreutils/bin/env"
+	scriptShPath = "/nix/store/bash/bin/sh"
+	scriptBashPath = "/nix/store/bash/bin/bash"
+	scriptZshPath = "/nix/store/zsh/bin/zsh"
+	scriptPythonPath = "/nix/store/python/bin/python"
+	scriptPython3Path = "/nix/store/python/bin/python3"
+
+	for _, tc := range []struct {
+		name string
+		in   string
+		want string
+	}{
+		{
+			name: "sh",
+			in:   "#!/bin/sh\necho ok\n",
+			want: "#!/nix/store/bash/bin/sh\necho ok\n",
+		},
+		{
+			name: "bash arguments and CRLF",
+			in:   "#!/usr/bin/bash -e\r\necho ok\r\n",
+			want: "#!/nix/store/bash/bin/bash -e\r\necho ok\r\n",
+		},
+		{
+			name: "zsh without final newline",
+			in:   "#!/bin/zsh -f",
+			want: "#!/nix/store/zsh/bin/zsh -f",
+		},
+		{
+			name: "python",
+			in:   "#!/usr/bin/python -u\nprint('ok')",
+			want: "#!/nix/store/python/bin/python -u\nprint('ok')",
+		},
+		{
+			name: "python3",
+			in:   "#!/usr/local/bin/python3\nprint('ok')\n",
+			want: "#!/nix/store/python/bin/python3\nprint('ok')\n",
+		},
+		{
+			name: "versioned python",
+			in:   "#!/opt/python/bin/python3.11 -B\nprint('ok')\n",
+			want: "#!/nix/store/python/bin/python3 -B\nprint('ok')\n",
+		},
+		{
+			name: "env with arguments",
+			in:   "#!/usr/bin/env python3 -u\nprint('ok')\n",
+			want: "#!/nix/store/coreutils/bin/env -S /nix/store/python/bin/python3 -u\nprint('ok')\n",
+		},
+		{
+			name: "env with options and versioned python",
+			in:   "#!/usr/bin/env -S python3.11 -u\r\nprint('ok')\r\n",
+			want: "#!/nix/store/coreutils/bin/env -S /nix/store/python/bin/python3 -u\r\nprint('ok')\r\n",
+		},
+		{name: "no shebang", in: "echo ok", want: "echo ok"},
+		{name: "unsupported", in: "#!/opt/bin/bash\necho ok\n", want: "#!/opt/bin/bash\necho ok\n"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			require.Equal(t, tc.want, string(rewriteShebang([]byte(tc.in))))
+		})
+	}
+}
+
+func TestExecCmdValidatesBeforeRewrite(t *testing.T) {
+	contents := "#!/opt/bin/bash\necho unsafe\n"
+	scriptPath := filepath.Join(t.TempDir(), "unsupported.sh")
+	require.NoError(t, os.WriteFile(scriptPath, []byte(contents), 0o700))
+
+	_, exitCode, err := ExecCmd(context.Background(), scriptPath, nil)
+	require.Equal(t, -1, exitCode)
+	require.ErrorIs(t, err, fleet.ErrUnsupportedInterpreter)
+	got, readErr := os.ReadFile(scriptPath)
+	require.NoError(t, readErr)
+	require.Equal(t, contents, string(got))
+}
+
+func TestExecCmdRewritesSupportedShebang(t *testing.T) {
+	oldPython3 := scriptPython3Path
+	scriptPython3Path = "/bin/sh"
+	t.Cleanup(func() { scriptPython3Path = oldPython3 })
+
+	scriptPath := filepath.Join(t.TempDir(), "versioned-python")
+	require.NoError(t, os.WriteFile(scriptPath, []byte("#!/usr/bin/python3.11\nprintf rewritten\n"), 0o700))
+
+	output, exitCode, err := ExecCmd(context.Background(), scriptPath, nil)
+	require.NoError(t, err)
+	require.Zero(t, exitCode)
+	require.Equal(t, "rewritten", string(output))
+	got, readErr := os.ReadFile(scriptPath)
+	require.NoError(t, readErr)
+	require.Equal(t, "#!/bin/sh\nprintf rewritten\n", string(got))
+}
+
+func TestExecCmdRewritesEnvShebangArguments(t *testing.T) {
+	oldEnv, oldPython3 := scriptEnvPath, scriptPython3Path
+	t.Cleanup(func() {
+		scriptEnvPath, scriptPython3Path = oldEnv, oldPython3
+	})
+
+	envPath, err := exec.LookPath("env")
+	require.NoError(t, err)
+	shellPath, err := exec.LookPath("sh")
+	require.NoError(t, err)
+	scriptEnvPath = envPath
+	scriptPython3Path = shellPath
+
+	scriptPath := filepath.Join(t.TempDir(), "env-python-arguments")
+	require.NoError(t, os.WriteFile(scriptPath, []byte("#!/usr/bin/env python3 -u\nprintf rewritten\n"), 0o700))
+
+	output, exitCode, err := ExecCmd(context.Background(), scriptPath, nil)
+	require.NoError(t, err)
+	require.Zero(t, exitCode)
+	require.Equal(t, "rewritten", string(output))
+	got, readErr := os.ReadFile(scriptPath)
+	require.NoError(t, readErr)
+	require.Equal(t, "#!"+envPath+" -S "+shellPath+" -u\nprintf rewritten\n", string(got))
+}
