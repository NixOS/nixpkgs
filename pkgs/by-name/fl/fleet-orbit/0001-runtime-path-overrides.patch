+func externalComponentPaths(osquerydPath, desktopPath string, desktopEnabled bool) (string, string, bool, error) {
+	external := osquerydPath != "" || desktopPath != ""
+	if !external {
+		return "", "", false, nil
+	}
+	if osquerydPath == "" {
+		return "", "", false, errors.New("desktop-path requires osqueryd-path")
+	}
+	if desktopEnabled && desktopPath == "" {
+		return "", "", false, errors.New("fleet-desktop requires desktop-path when osqueryd-path is configured")
+	}
+	if !desktopEnabled {
+		desktopPath = ""
+	}
+	return osquerydPath, desktopPath, true, nil
+}
+
+func shouldRunUpdater(disableUpdates, devMode, externalComponents bool) bool {
+	return !externalComponents && (!disableUpdates || devMode)
+}
+
+func configuredPath(value, fallback string) string {
+	if value != "" {
+		return value
+	}
+	return fallback
+}
+
+func linuxBrowserPath(configured string, pathExists func(string) bool) string {
+	if configured != "" {
+		return configured
+	}
+	if pathExists("/usr/bin/firefox") {
+		return "/usr/bin/firefox"
+	}
+	return "/usr/bin/xdg-open"
+}
