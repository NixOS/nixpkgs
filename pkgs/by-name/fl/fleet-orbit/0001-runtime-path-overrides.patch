+func TestExternalComponentPaths(t *testing.T) {
+	for _, tc := range []struct {
+		name           string
+		osquerydPath   string
+		desktopPath    string
+		desktopEnabled bool
+		wantOsqueryd   string
+		wantDesktop    string
+		wantExternal   bool
+		wantErr        bool
+	}{
+		{
+			name: "updater-managed components",
+		},
+		{
+			name:           "external osqueryd",
+			osquerydPath:   "/nix/store/osquery/bin/osqueryd",
+			wantOsqueryd:   "/nix/store/osquery/bin/osqueryd",
+			wantExternal:   true,
+			desktopEnabled: false,
+		},
+		{
+			name:           "external osqueryd and desktop",
+			osquerydPath:   "/nix/store/osquery/bin/osqueryd",
+			desktopPath:    "/nix/store/fleet-desktop/bin/fleet-desktop",
+			desktopEnabled: true,
+			wantOsqueryd:   "/nix/store/osquery/bin/osqueryd",
+			wantDesktop:    "/nix/store/fleet-desktop/bin/fleet-desktop",
+			wantExternal:   true,
+		},
+		{
+			name:           "missing external osqueryd",
+			desktopPath:    "/nix/store/fleet-desktop/bin/fleet-desktop",
+			desktopEnabled: true,
+			wantErr:        true,
+		},
+		{
+			name:           "missing external desktop",
+			osquerydPath:   "/nix/store/osquery/bin/osqueryd",
+			desktopEnabled: true,
+			wantErr:        true,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			gotOsqueryd, gotDesktop, gotExternal, err := externalComponentPaths(
+				tc.osquerydPath,
+				tc.desktopPath,
+				tc.desktopEnabled,
+			)
+			if tc.wantErr {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tc.wantOsqueryd, gotOsqueryd)
+			require.Equal(t, tc.wantDesktop, gotDesktop)
+			require.Equal(t, tc.wantExternal, gotExternal)
+		})
+	}
+}
+
+func TestShouldRunUpdater(t *testing.T) {
+	for _, tc := range []struct {
+		name           string
+		disableUpdates bool
+		devMode        bool
+		external       bool
+		wantRunUpdater bool
+	}{
+		{name: "updates enabled", wantRunUpdater: true},
+		{name: "updates disabled", disableUpdates: true},
+		{name: "development mode", disableUpdates: true, devMode: true, wantRunUpdater: true},
+		{name: "external components", external: true},
+		{name: "external components in development mode", devMode: true, external: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			require.Equal(t, tc.wantRunUpdater, shouldRunUpdater(tc.disableUpdates, tc.devMode, tc.external))
+		})
+	}
+}
+
+func TestConfiguredPath(t *testing.T) {
+	require.Equal(t, "/configured", configuredPath("/configured", "/fallback"))
+	require.Equal(t, "/fallback", configuredPath("", "/fallback"))
+}
+
+func TestLinuxBrowserPath(t *testing.T) {
+	pathExists := func(path string) bool { return path == "/usr/bin/firefox" }
+
+	require.Equal(t, "/nix/store/xdg-utils/bin/xdg-open", linuxBrowserPath("/nix/store/xdg-utils/bin/xdg-open", pathExists))
+	require.Equal(t, "/usr/bin/firefox", linuxBrowserPath("", pathExists))
+	require.Equal(t, "/usr/bin/xdg-open", linuxBrowserPath("", func(string) bool { return false }))
+}
