Keep PATH in the environment of subprocesses that force a C locale.  Without
it, Python looks commands up in os.defpath only, so `df`, `lscpu`, `free` and
`uptime` are never found on NixOS.  Also tolerate a missing `getent`, which
crashes the Shell entry when SHELL is unset on systems lacking it, such as
Darwin.

diff --git a/archey/entries/cpu.py b/archey/entries/cpu.py
index 75ca9e0..5ef4cf2 100644
--- a/archey/entries/cpu.py
+++ b/archey/entries/cpu.py
@@ -1,6 +1,7 @@
 """CPU information detection class"""
 
 import json
+import os
 import platform
 import re
 from subprocess import DEVNULL, CalledProcessError, check_output
@@ -100,7 +101,7 @@ class CPU(Entry):
     def _parse_lscpu_output(cls) -> List[Dict[str, int]]:
         """Same operation but from `lscpu` output"""
         try:
-            cpu_info = check_output("lscpu", env={"LANG": "C"}, universal_newlines=True)
+            cpu_info = check_output("lscpu", env={"LANG": "C", "PATH": os.environ.get("PATH", os.defpath)}, universal_newlines=True)
         except FileNotFoundError:
             return []
 
