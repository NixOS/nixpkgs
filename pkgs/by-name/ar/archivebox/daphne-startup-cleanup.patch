@@ -0,0 +1,53 @@
+from unittest import TestCase
+from unittest.mock import Mock, call, patch
+
+from daphne.testing import BaseDaphneTestingInstance
+
+
+class TestStartupCleanup(TestCase):
+    def make_process(self):
+        process = Mock()
+        process.ready.wait.return_value = False
+        process.errors.empty.return_value = True
+        return process
+
+    def make_instance(self):
+        return BaseDaphneTestingInstance(application=lambda *_: None)
+
+    def test_process_is_terminated_after_startup_timeout(self):
+        process = self.make_process()
+        process.is_alive.return_value = False
+
+        with patch("daphne.testing.DaphneProcess", return_value=process):
+            with self.assertRaisesRegex(
+                RuntimeError, "Daphne did not start up, no error caught"
+            ):
+                self.make_instance().__enter__()
+
+        process.terminate.assert_called_once_with()
+        process.join.assert_called_once_with(timeout=1)
+        process.kill.assert_not_called()
+
+    def test_unresponsive_process_is_killed_after_startup_timeout(self):
+        process = self.make_process()
+        process.is_alive.side_effect = [True, False]
+
+        with patch("daphne.testing.DaphneProcess", return_value=process):
+            with self.assertRaisesRegex(
+                RuntimeError, "Daphne did not start up, no error caught"
+            ):
+                self.make_instance().__enter__()
+
+        process.terminate.assert_called_once_with()
+        self.assertEqual(process.join.call_args_list, [call(timeout=1), call()])
+        process.kill.assert_called_once_with()
+
+    def test_cleanup_error_does_not_replace_startup_error(self):
+        process = self.make_process()
+        process.terminate.side_effect = OSError("cleanup failed")
+
+        with patch("daphne.testing.DaphneProcess", return_value=process):
+            with self.assertRaisesRegex(
+                RuntimeError, "Daphne did not start up, no error caught"
+            ):
+                self.make_instance().__enter__()
