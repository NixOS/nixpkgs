From 0fbe7195f5fbcc21bc4ff7c557301cbd17462696 Mon Sep 17 00:00:00 2001
From: Maximilian Bosch <maximilian@mbosch.me>
Date: Sun, 25 Oct 2026 18:05:42 +0100
Subject: [PATCH] Allow DB configuration without `postgres` conf parameter

The postgres library also allows being configured via env-vars, i.e.
`PGHOST`, `PGPASS` et al.. This is useful since that way one can
actually configure a DB connection that uses UNIX sockets rather than
TCP sockets.

Co-authored-by: networkException <git@nwex.de>
---
 README.md          |  3 +++
 bin/conf.js        |  6 +++++-
 bin/init-db.js     |  9 ++++++---
 src/index.js       |  5 +----
 src/persistence.js | 18 +++++++++++++-----
 src/types.js       |  2 +-
 6 files changed, 29 insertions(+), 14 deletions(-)

diff --git a/README.md b/README.md
index 4c4a403..b71c442 100644
--- a/README.md
+++ b/README.md
@@ -198,6 +198,9 @@ S3_YHUB_BUCKET=yhub               # Bucket for document storage
 POSTGRES=postgres://user:pass@localhost:5432/yhub
 ```
 
+For configuration via UNIX domain-socket it's recommended to leave `POSTGRES`
+unset and use the [environment variables from the 'postgres'-library instead.](https://github.com/porsager/postgres#environmental-variables)
+
 ### Optional Settings
 
 ```bash
diff --git a/bin/conf.js b/bin/conf.js
index 930d35e..0308a21 100644
--- a/bin/conf.js
+++ b/bin/conf.js
@@ -38,7 +38,11 @@ export const conf = {
     taskDebounce: number.parseInt(env.getConf('redis-task-debounce') || '10000'),
     minMessageLifetime: number.parseInt(env.getConf('redis-min-message-lifetime') || '60000')
   },
-  postgres: env.ensureConf('postgres'),
+  // Postgres is optional (i.e. no ensureConf) on purpose since it's also
+  // possible to configure the 'postgres' library via environment variables,
+  // i.e. PGHOST et al.. This is relevant for advanced use-cases such as connection
+  // via UNIX domain-socket.
+  postgres: env.getConf('postgres') ?? undefined,
   persistence: bucket == null
     ? []
     : [
