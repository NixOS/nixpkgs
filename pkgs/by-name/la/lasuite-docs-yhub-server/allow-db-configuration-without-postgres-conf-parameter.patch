@@ -140,7 +140,7 @@ async function init (postgresUrl) {
   } finally {
     await sql.end({ timeout: 5 })
   }
-  log.info({ postgres: describeUrl(postgresUrl) }, 'initialization done')
+  log.info({ postgres: postgresUrl ? describeUrl(postgresUrl) : 'configured from env' }, 'initialization done')
 }
 
 /**
@@ -164,7 +164,10 @@ log.info('initializing databases based on environment variables POSTGRES & POSTG
 
 const postgresUrl = env.getConf('postgres')
 const postgresTestingUrl = env.getConf('postgres-testing')
-postgresUrl && await init(postgresUrl)
+// NOTE: We make the following unconditional to support missing POSTGRES= with all other
