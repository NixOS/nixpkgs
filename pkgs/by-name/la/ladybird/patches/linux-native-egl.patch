+// Only use the system driver manifests to discover Nix store directories.
+static Optional<ByteString> resolve_nix_store_library(ByteString const& path)
+{
+    char resolved[PATH_MAX];
+    if (!realpath(path.characters(), resolved))
+        return {};
+    StringView canonical_path { resolved, strlen(resolved) };
+    if (!canonical_path.starts_with("@NIX_STORE_DIR@/"sv))
+        return {};
+    auto metadata = Core::System::stat(canonical_path);
+    if (metadata.is_error() || !S_ISREG(metadata.value().st_mode))
+        return {};
+    return canonical_path.to_byte_string();
+}
+
+struct NixDriverLibraries {
+    HashTable<ByteString> libraries;
+    HashTable<ByteString> driver_directories;
+};
+
+static void append_elf_dependencies(ByteString const& library, Vector<ByteString>& pending)
+{
+    static bool const elf_initialized = elf_version(EV_CURRENT) != EV_NONE;
+    if (!elf_initialized)
+        return;
+
+    auto file = Core::File::open(library, Core::File::OpenMode::Read);
+    if (file.is_error())
+        return;
+    auto* elf = elf_begin(file.value()->fd(), ELF_C_READ_MMAP_PRIVATE, nullptr);
+    if (!elf)
+        return;
+    ScopeGuard end_elf([&] { elf_end(elf); });
+
+    for (Elf_Scn* section = nullptr; (section = elf_nextscn(elf, section));) {
+        GElf_Shdr header;
+        if (!gelf_getshdr(section, &header) || header.sh_type != SHT_DYNAMIC || header.sh_entsize == 0)
+            continue;
+        auto* data = elf_getdata(section, nullptr);
+        if (!data)
+            return;
+
+        Optional<StringView> runpath;
+        Optional<StringView> rpath;
+        Vector<StringView> needed;
+        for (size_t index = 0; index < data->d_size / header.sh_entsize && index <= NumericLimits<int>::max(); ++index) {
+            GElf_Dyn entry;
+            if (!gelf_getdyn(data, static_cast<int>(index), &entry) || entry.d_tag == DT_NULL)
+                break;
+            if (entry.d_tag != DT_NEEDED && entry.d_tag != DT_RUNPATH && entry.d_tag != DT_RPATH)
+                continue;
+            auto const* value = elf_strptr(elf, header.sh_link, entry.d_un.d_val);
+            if (!value)
+                continue;
+            StringView string { value, strlen(value) };
+            if (entry.d_tag == DT_NEEDED)
+                needed.append(string);
+            else if (entry.d_tag == DT_RUNPATH)
+                runpath = string;
+            else
+                rpath = string;
+        }
+
+        auto origin = LexicalPath::dirname(library);
+        Vector<ByteString> search_directories;
+        for (auto entry : runpath.value_or(rpath.value_or(""sv)).split_view(':')) {
+            auto directory = entry.to_byte_string().replace("${ORIGIN}"sv, origin).replace("$ORIGIN"sv, origin);
+            if (directory.starts_with('/'))
+                search_directories.append(move(directory));
+        }
+
+        for (auto name : needed) {
+            if (name.starts_with('/')) {
+                pending.append(name.to_byte_string());
+                continue;
+            }
+            if (name.contains('/'))
+                continue;
+            for (auto const& directory : search_directories) {
+                if (auto dependency = resolve_nix_store_library(LexicalPath::join(directory, name).string()); dependency.has_value()) {
+                    pending.append(dependency.release_value());
+                    break;
+                }
+            }
+        }
+        return;
+    }
+}
+
+static ErrorOr<void> add_nix_driver_library_paths(Vector<PathRule>& paths, ByteString const& manifest_library, NixDriverLibraries& visited)
+{
+    auto driver = resolve_nix_store_library(manifest_library);
+    if (!driver.has_value())
+        return {};
+
+    Vector<ByteString> pending;
+    auto driver_directory = LexicalPath::dirname(*driver);
+    pending.append(driver.release_value());
+
+    // Mesa can dlopen DRI modules which do not appear in the EGL driver's DT_NEEDED entries.
+    if (visited.driver_directories.set(driver_directory) == HashSetResult::InsertedNewEntry) {
+        auto dri_directory = LexicalPath::join(driver_directory, "dri"sv).string();
+        auto metadata = Core::System::stat(dri_directory);
+        if (!metadata.is_error() && S_ISDIR(metadata.value().st_mode)) {
+            auto flags = static_cast<Core::DirIterator::Flags>(Core::DirIterator::SkipDots | Core::DirIterator::NoStat);
+            TRY(Core::Directory::for_each_entry(dri_directory, flags, [&](Core::DirectoryEntry const& entry, Core::Directory const&) -> ErrorOr<IterationDecision> {
+                if (entry.name.ends_with("_dri.so"sv))
+                    pending.append(LexicalPath::join(dri_directory, entry.name).string());
+                return IterationDecision::Continue;
+            }));
+        }
+    }
+
+    while (!pending.is_empty()) {
+        auto library = resolve_nix_store_library(pending.take_last());
+        if (!library.has_value() || visited.libraries.set(*library) != HashSetResult::InsertedNewEntry)
+            continue;
+
+        auto directory = LexicalPath::dirname(*library);
+        if (directory != "@NIX_STORE_DIR@"sv)
+            TRY(add_path_if_exists(paths, directory, PathRule::Access::ReadOnly));
+        append_elf_dependencies(*library, pending);
+    }
+    return {};
+}

