{
  lib,
  replaceVarsWith,
  perl,

  path,
  dbPath ? path + "/programs.sqlite",
}:

let
  command-not-found =
    dbPath':
    replaceVarsWith {
      name = "command-not-found";
      dir = "bin";
      src = ./command-not-found.pl;
      isExecutable = true;
      replacements = {
        dbPath = dbPath';
        perl = perl.withPackages (p: [
          p.DBDSQLite
          p.StringShellQuote
        ]);
      };
    };

  failWithMessage =
    drv:
    drv.overrideAttrs {
      preBuild = ''
        cat >&2 <<-EOF
        ***
        command-not-found requires the dbPath to be present.
        If this message is shown, then the nixpkgs it is built with doesn't have
        the programs database generated by hydra.
        You can try using the hydra release tarballs instead.
        ***
        EOF
        exit 1
      '';
    };

  withMeta = lib.addMetaAttrs {
    mainProgram = "command-not-found";
    hydraPlatforms = [ ];
  };
in

withMeta (
  if builtins.pathExists dbPath then
    (command-not-found dbPath)
  else
    failWithMessage
      # We have to give the derivation a fake path string, otherwise the invalid path will be forced.
      # This derivation will never build, the goal is to move the eval error as a realisation error.
      (command-not-found "@invalid_db_path@")
)
