{
  replaceVarsWith,
  perl,

  path,
  dbPath ? path + "/programs.sqlite",
}:

let
  command-not-found = replaceVarsWith {
    name = "command-not-found";
    dir = "bin";
    src = ./command-not-found.pl;
    isExecutable = true;
    replacements = {
      inherit dbPath;
      perl = perl.withPackages (p: [
        p.DBDSQLite
        p.StringShellQuote
      ]);
    };
  };
in

if builtins.pathExists dbPath then
  command-not-found
else
  throw ''
    command-not-found requires the dbPath to be present.
    If this message is shown, then the nixpkgs it is built with doesn't have
    the programs database generated by hydra.
    You can try using the hydra release tarballs instead.
  ''
