{
  lib,
  replaceVarsWith,
  perl,

  path,
  dbPath ? path + "/programs.sqlite",
}:

replaceVarsWith {
  name = "command-not-found";

  dir = "bin";
  src = ./command-not-found.pl;
  isExecutable = true;

  replacements = {
    perl = perl.withPackages (p: [
      p.DBDSQLite
      p.StringShellQuote
    ]);
  }
  # If dbPath doesn't exist, we must not include it in the replacements.
  # Otherwise, it will be forced and nix will throw an evaluation error.
  // lib.optionalAttrs (builtins.pathExists dbPath) {
    inherit dbPath;
  };

  passthru = {
    inherit dbPath;
  };

  preBuild = lib.optionalString (!builtins.pathExists dbPath) ''
    cat >&2 <<-EOF
    ***
    command-not-found requires the dbPath to be present.
    If this message is shown, then the nixpkgs it is built with doesn't have
    the programs database generated by hydra.
    You can try using the hydra release tarballs instead.
    ***
    EOF
    exit 1
  '';

  meta = {
    description = "Show package for missing commands in shell.";
    longDescription = ''
      Provides suggestions of packages to install if the user
      tries to run a missing command in a supported shell, namely Bash.
      This is implemented using a SQLite database that maps program names to Nix
      package names (e.g., "pdflatex" is mapped to "tetex").
    '';
    homepage = "https://github.com/NixOS/nixpkgs/tree/master/pkgs/by-name/co/command-not-found";
    license = lib.licenses.mit;
    mainProgram = "command-not-found";
    maintainers = [ lib.maintainers.leana8959 ];
    hydraPlatforms = [ ];
  };
}
