+def _cross_2d(a, b):
+    """
+    2D scalar cross product (z-component), broadcasting over the last axis.
+
+    NumPy 2.3 removed support for 2-dimensional inputs to ``np.cross``; this
+    helper replaces those calls.
+    """
+    a = np.asarray(a)
+    b = np.asarray(b)
+    return a[..., 0] * b[..., 1] - a[..., 1] * b[..., 0]
+
