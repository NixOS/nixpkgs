+	$(MSGFMT) $(MSGFMT_EXTRA_FLAGS) -c -v -o $@ $(top_srcdir)/plugingui/locale/da.po
 
 $(top_builddir)/plugingui/locale/fr.mo: $(top_srcdir)/plugingui/locale/fr.po
-	$(MSGFMT) -c -v -o $@ $(top_srcdir)/plugingui/locale/fr.po
+	$(MSGFMT) $(MSGFMT_EXTRA_FLAGS) -c -v -o $@ $(top_srcdir)/plugingui/locale/fr.po
 
 endif
 
