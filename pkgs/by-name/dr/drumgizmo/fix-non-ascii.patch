diff --git a/configure.ac b/configure.ac
index 28c492d4..530bdd78 100644
--- a/configure.ac
+++ b/configure.ac
@@ -157,6 +157,18 @@ AC_ARG_WITH([nls],
                    AC_CHECK_PROGS([MSGFMT], [msgfmt])
                    AS_IF([test "x$MSGFMT" = "x"],
                          AC_MSG_ERROR([Missing msgfmt tool.]))
+                   AS_IF(
+                       [$MSGFMT --help 2>&1 | grep -q -- '--no-convert'],
+                       [
+                         MSGFMT_EXTRA_FLAGS='--no-convert'
+                         AC_MSG_NOTICE([msgfmt supports --no-convert])
+                       ],
+                       [
+                         MSGFMT_EXTRA_FLAGS=''
+                         AC_MSG_NOTICE([msgfmt does NOT support --no-convert])
+                       ]
+                   )
+                   AC_SUBST([MSGFMT_EXTRA_FLAGS])
                    AC_DEFINE_UNQUOTED([WITH_NLS], , [Build with nls support])],
                   [AC_MSG_WARN([*** Building without nls support!])]
 )
diff --git a/plugingui/Makefile.am b/plugingui/Makefile.am
index 706b3c9a..25cccf01 100644
--- a/plugingui/Makefile.am
+++ b/plugingui/Makefile.am
@@ -55,10 +55,10 @@ $(top_srcdir)/plugingui/locale/fr.po: $(top_srcdir)/plugingui/locale/drumgizmo.p
 	$(MSGMERGE) --update $@ $(top_srcdir)/plugingui/locale/drumgizmo.pot
 
 $(top_builddir)/plugingui/locale/da.mo: $(top_srcdir)/plugingui/locale/da.po
