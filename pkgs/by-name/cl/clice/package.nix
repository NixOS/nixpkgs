{
  lib,
  stdenv,
  fetchFromGitHub,
  fetchurl,
  fetchzip,
  cmake,
  ninja,
  llvmPackages_22,
  xz,
}:

let
  # clice has no tagged release yet; package the upstream master as of
  # 2026-07-22. When a tagged release appears, switch to `tag`/`hash`
  # and drop the date suffix.
  version = "0-unstable-2026-07-22";

  # Revision of clice-io/clice packaged here.
  rev = "694c07afba3d2a3cc585d110c3e61141641342e5";

  # clice is built against a prebuilt LLVM/Clang fork (clice-io/clice-llvm)
  # rather than nixpkgs' llvmPackages, because clice depends on Clang
  # internals that diverge from upstream. Bump in lockstep with setup_llvm()
  # in clice's cmake/package.cmake. The URL encodes '+' as %2B.
  llvmVersion = "21.1.8+r1";

  cliceLlvmTarball = fetchurl {
    name = "clice-llvm-${llvmVersion}-x64-linux-gnu-releasedbg.tar.xz";
    url = "https://github.com/clice-io/clice-llvm/releases/download/${
      lib.replaceStrings [ "+" ] [ "%2B" ] llvmVersion
    }/x64-linux-gnu-releasedbg.tar.xz";
    hash = "sha256-UL+YVArlSEJxd2dHiR533pylHzD08LC7fOKfX7XFpuo=";
  };

  # The published LLVM tarball has no enclosing directory, so stdenv's
  # default unpacker rejects it; extract it into $out ourselves.
  cliceLlvm = stdenv.mkDerivation {
    pname = "clice-llvm-prebuilt";
    inherit version;

    src = cliceLlvmTarball;
    nativeBuildInputs = [ xz ];

    dontConfigure = true;
    dontBuild = true;

    unpackPhase = ''
      runHook preUnpack
      mkdir unpacked
      tar -xf "${cliceLlvmTarball}" -C unpacked
      cd unpacked
      runHook postUnpack
    '';

    installPhase = ''
      runHook preInstall
      mkdir -p "$out"
      cp -r . "$out/"
      runHook postInstall
    '';

    meta.platforms = lib.platforms.linux;
  };

  # clice uses CMake FetchContent for all its third-party deps. Prefetch
  # each one and inject via FETCHCONTENT_SOURCE_DIR_* so the build is
  # hermetic. Versions must match clice's cmake/package.cmake and
  # kotatsu's CMakeLists.txt.
  spdlogSrc = fetchFromGitHub {
    owner = "gabime";
    repo = "spdlog";
    rev = "v1.15.3";
    hash = "sha256-0rOR9G2Y4Z4OBZtUHxID0s1aXN9ejodHrurlVCA0pIo=";
  };

  croaringSrc = fetchFromGitHub {
    owner = "RoaringBitmap";
    repo = "CRoaring";
    rev = "v4.4.2";
    hash = "sha256-l8E9hVbsdEsAaDPCe+kJLIqk2rip6ZiS48fVZ3lV7FY=";
    # CRoaring v4.4.2 unconditionally configure_file()s into the
    # read-only source tree. The generated tests/config.h is only used
    # when tests are ON (clice leaves them OFF), so pre-seed an empty
    # file and comment out the two-line call.
    postFetch = ''
      printf '%s\n' \
        '// Generated by nix postFetch; values are irrelevant because' \
        '// ENABLE_ROARING_TESTS is OFF in clice.' \
        > "$out/tests/config.h"
      sed -i '/configure_file .*tests\/config\.h\.in/,/tests\/config\.h")/s/^/# disabled for hermetic nix build: /' \
        "$out/CMakeLists.txt"
    '';
  };

  flatbuffersSrc = fetchFromGitHub {
    owner = "google";
    repo = "flatbuffers";
    rev = "v25.9.23";
    hash = "sha256-A9nWfgcuVW3x9MDFeviCUK/oGcWJQwadI8LqNR8BlQw=";
  };

  kotatsuSrc = fetchFromGitHub {
    owner = "clice-io";
    repo = "kotatsu";
    rev = "f2cdf65";
    hash = "sha256-+YuZW8dTQW6XgwyrooR9NfvUYpDkS9/LUmqywcZ6GgE=";
  };

  # kotatsu's transitive deps.
  libuvSrc = fetchFromGitHub {
    owner = "libuv";
    repo = "libuv";
    rev = "v1.52.0";
    hash = "sha256-WyIBJjxsGo1sSjmbM1zRBF2cR97n6iSBK12FGbg73n0=";
  };

  simdjsonSrc = fetchFromGitHub {
    owner = "simdjson";
    repo = "simdjson";
    rev = "v4.2.4";
    hash = "sha256-TTZcdnD7XT5n39n7rSlA81P3pid+5ek0noxjXAGbb64=";
  };

  tomlplusplusSrc = fetchFromGitHub {
    owner = "marzer";
    repo = "tomlplusplus";
    rev = "v3.4.0";
    hash = "sha256-h5tbO0Rv2tZezY58yUbyRVpsfRjY3i+5TPkkxr6La8M=";
  };

  cpptraceSrc = fetchFromGitHub {
    owner = "jeremy-rifkin";
    repo = "cpptrace";
    rev = "v1.0.4";
    hash = "sha256-KmAJEEU1aTKwleGBllSxlrsO4jVSTKnSTQQZyJ50loY=";
  };

  # cpptrace's transitive deps (libdwarf path on Linux).
  zstdSrc = fetchzip {
    name = "zstd-1.5.7-src";
    url = "https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz";
    hash = "sha256-tNFWIT9ydfozB8dWcmTMuZLCQmQudTFJIkSr0aG7S44=";
  };

  libdwarfSrc = fetchFromGitHub {
    owner = "jeremy-rifkin";
    repo = "libdwarf-lite";
    rev = "5dfb2cd2aacf2bf473e5bfea79e41289f88b3a5f"; # v2.1.0
    hash = "sha256-K0vmGJhQgNV3mEShPoIMNnInTkttkj1LD7jByj+/RwA=";
  };
in
llvmPackages_22.stdenv.mkDerivation (finalAttrs: {
  pname = "clice";
  inherit version;

  __structuredAttrs = true;
  strictDeps = true;

  src = fetchFromGitHub {
    owner = "clice-io";
    repo = "clice";
    inherit rev;
    hash = "sha256-UEabIK91vQPu2i8ln/HUrGVVu012qoLtcMHh4KuvygM=";
  };

  nativeBuildInputs = [
    cmake
    ninja
    llvmPackages_22.clang
    llvmPackages_22.lld
    llvmPackages_22.llvm
  ];

  cmakeFlags = [
    "-G"
    "Ninja"
    "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
    "-DCMAKE_TOOLCHAIN_FILE=${finalAttrs.src}/cmake/toolchain.cmake"
    "-DCLICE_ENABLE_TEST=OFF"
    "-DCLICE_ENABLE_BENCHMARK=OFF"
    "-DCLICE_OFFLINE_BUILD=ON"
    # CRoaring tries to fetch CPM.cmake from the network even with tests
    # OFF; disable it since CRoaring has no third-party deps clice needs.
    "-DROARING_USE_CPM=OFF"
    "-DLLVM_INSTALL_PATH=${cliceLlvm}"
    # Inject prefetched FetchContent sources; the uppercased source name
    # is the variable CMake's FetchContent module consults.
    "-DFETCHCONTENT_SOURCE_DIR_SPDLOG=${spdlogSrc}"
    "-DFETCHCONTENT_SOURCE_DIR_CROARING=${croaringSrc}"
    "-DFETCHCONTENT_SOURCE_DIR_FLATBUFFERS=${flatbuffersSrc}"
    "-DFETCHCONTENT_SOURCE_DIR_KOTATSU=${kotatsuSrc}"
    "-DFETCHCONTENT_SOURCE_DIR_LIBUV=${libuvSrc}"
    "-DFETCHCONTENT_SOURCE_DIR_SIMDJSON=${simdjsonSrc}"
    "-DFETCHCONTENT_SOURCE_DIR_TOMLPLUSPLUS=${tomlplusplusSrc}"
    "-DFETCHCONTENT_SOURCE_DIR_CPPTRACE=${cpptraceSrc}"
    "-DFETCHCONTENT_SOURCE_DIR_ZSTD=${zstdSrc}"
    "-DFETCHCONTENT_SOURCE_DIR_LIBDWARF=${libdwarfSrc}"
  ];

  # CRoaring's roaring.pc ends up with mangled nix paths; clice links
  # via the CMake target directly and never consumes it.
  postInstall = ''
    rm -rf "$out/lib/pkgconfig"
  '';

  meta = {
    description = "Next-generation C++ language server built on LLVM/Clang";
    homepage = "https://github.com/clice-io/clice";
    license = lib.licenses.asl20;
    mainProgram = "clice";
    maintainers = [ lib.maintainers.luochen1990 ];
    platforms = lib.platforms.linux;
  };
})
