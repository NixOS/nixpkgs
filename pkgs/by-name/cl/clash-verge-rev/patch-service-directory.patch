-    let executable = approved_core_copy(
-        &crate::core::paths::service_paths()
-            .map_err(|error| untrusted(error.to_string()))?
-            .core_dir(),
-        // The installer stages symlinked cores under the original name, not the target name.
-        client_path,
-    )?;
+    let executable = packaged_core(client_path)?;
@@ -426,0 +421,15 @@ pub(crate) fn validate_core_path(core_path: &str) -> Result<ResolvedCore, Servic
+/// Resolves the supported core name to the immutable executable selected by the packager.
+pub(crate) fn packaged_core(requested: &Path) -> Result<PathBuf, ServiceError> {
+    // The manager validates the approved executable again before spawning it.
+    if requested == Path::new("@mihomo@") {
+        return canonical_regular_file(requested, "packaged core");
+    }
+    let Some(name) = requested.file_name() else {
+        return Err(untrusted("core path has no file name"));
+    };
+    if name != std::ffi::OsStr::new("verge-mihomo") {
+        return Err(untrusted(format!("unsupported core name {name:?}")));
+    }
+    canonical_regular_file(Path::new("@mihomo@"), "packaged core")
+}
