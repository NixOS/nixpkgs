{
  lib,
  rustPlatform,
  fetchFromGitHub,
  installShellFiles,
  versionCheckHook,
}:

rustPlatform.buildRustPackage (finalAttrs: {
  pname = "marquee-markdown";
  version = "0.10.0";

  src = fetchFromGitHub {
    owner = "SophanaSok";
    repo = "marquee-markdown";
    tag = "v${finalAttrs.version}";
    hash = "sha256-ijTZ0qmAWdt9viBgtqhXKbdZrcU3moIhCYKgr0WYNtc=";
  };

  cargoHash = "sha256-j4hm2jfVuNakfsBHpV7fiiNUrCxVvXtxwqfMMWyqFFM=";

  nativeBuildInputs = [ installShellFiles ];

  # Syntax highlighting uses a pure-Rust regex backend on purpose, so there is
  # no C toolchain and no system library to find. Nothing belongs here.
  buildInputs = [ ];

  # The live-forge checks are `#[ignore]`d, so the suite needs no network.
  # `--all-targets` skips doctests, and the render module's public example is
  # one, so both are run.
  checkFlags = [ ];

  postInstall = ''
    # Generated by the binaries themselves, so they cannot drift from the
    # flags actually accepted. Both names, because a completion registered for
    # a name the reader does not type never fires.
    for name in marquee-markdown mmd; do
      # `--name` because the page arrives on a process substitution, which is
      # a named pipe: there is no `marquee-markdown.1` for the hook to read a
      # name and a section out of, and it refuses to guess.
      installManPage --name "$name.1" <("$out/bin/$name" man)
      installShellCompletion --cmd "$name" \
        --bash <("$out/bin/$name" completion bash) \
        --zsh <("$out/bin/$name" completion zsh) \
        --fish <("$out/bin/$name" completion fish)
    done
  '';

  nativeInstallCheckInputs = [ versionCheckHook ];
  versionCheckProgramArg = "--version";
  doInstallCheck = true;

  meta = {
    description = "TUI markdown reader that renders documents like Claude artifacts, with a table-of-contents panel";
    longDescription = ''
      A terminal markdown reader with the functionality of glow, rendering
      documents the way Claude artifacts do — a centered reading column on a
      painted page, typographic headings, sealed code cards — with a
      scroll-tracking table-of-contents panel and in-document search.

      Installs two commands, marquee-markdown and mmd, which are the same
      program under a shorter name.
    '';
    homepage = "https://github.com/SophanaSok/marquee-markdown";
    changelog = "https://github.com/SophanaSok/marquee-markdown/blob/v${finalAttrs.version}/CHANGELOG.md";
    license = lib.licenses.mit;
    maintainers = with lib.maintainers; [ SophanaSok ];
    mainProgram = "mmd";
    platforms = lib.platforms.unix ++ lib.platforms.windows;
  };
})
