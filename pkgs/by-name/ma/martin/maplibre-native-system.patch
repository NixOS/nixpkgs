+/// `pkg-config --cflags --libs mbgl-core`, split into its flags.
+fn mbgl_core_flags() -> Vec<String> {
+    let output = Command::new(env::var("PKG_CONFIG").unwrap_or("pkg-config".to_string()))
+        .args(["--cflags", "--libs", "mbgl-core"])
+        .output()
+        .unwrap();
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+    String::from_utf8(output.stdout).unwrap().split_whitespace().map(str::to_owned).collect()
+}
