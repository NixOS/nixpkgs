@@ -74,6 +74,44 @@
     } while(0)
 
 
+#if defined(MAGMA_HAVE_CUDA) && CUDA_VERSION >= 11000
+// Own the workspace for legacy CSR-to-CSC callers. The generic API takes
+// the CSC column pointers before its row indices, unlike the legacy API.
+static inline magma_int_t
+magma_csr2csc_ex2(
+    cusparseHandle_t handle, int m, int n, int nnz,
+    const void *csrval, const int *csrrow, const int *csrcol,
+    void *cscval, int *csccol, int *cscrow,
+    cudaDataType value_type, cusparseAction_t action, cusparseIndexBase_t base )
+{
+    magma_int_t info = MAGMA_SUCCESS;
+    size_t workspace_size = 0;
+    void *workspace = NULL;
+
+    CHECK_CUSPARSE( cusparseCsr2cscEx2_bufferSize(
+        handle, m, n, nnz, csrval, csrrow, csrcol,
+        cscval, csccol, cscrow, value_type, action, base,
+        CUSPARSE_CSR2CSC_ALG1, &workspace_size ));
+    if (workspace_size > 0) {
+        CHECK( magma_malloc( &workspace, workspace_size ));
+    }
+    CHECK_CUSPARSE( cusparseCsr2cscEx2(
+        handle, m, n, nnz, csrval, csrrow, csrcol,
+        cscval, csccol, cscrow, value_type, action, base,
+        CUSPARSE_CSR2CSC_ALG1, workspace ));
+
+cleanup:
+    if (workspace != NULL) {
+        magma_int_t cleanup_info = magma_free( workspace );
+        if (info == MAGMA_SUCCESS) {
+            info = cleanup_info;
+        }
+    }
+    return info;
+}
+#endif
+
+
 #ifdef __cplusplus
 } // extern C
 #endif
