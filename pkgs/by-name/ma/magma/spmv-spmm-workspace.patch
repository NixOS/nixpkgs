+#if CUDA_VERSION >= 11000
+// Dense descriptor dimensions follow op(A), not the CSR storage dimensions.
+// Keep descriptors and temporary storage local so every failure releases them.
+static magma_int_t
+magma_zcsrmv_generic(
+    cusparseHandle_t handle, cusparseOperation_t op,
+    int rows, int cols, int nnz, const void *alpha,
+    void *dval, int *drow, int *dcol, void *x, const void *beta, void *y )
+{
+    magma_int_t info = MAGMA_SUCCESS;
+    cusparseSpMatDescr_t descrA = NULL;
+    cusparseDnVecDescr_t descrX = NULL, descrY = NULL;
+    size_t bufsize = 0;
+    void *buf = NULL;
+    int xrows = (op == CUSPARSE_OPERATION_NON_TRANSPOSE ? cols : rows);
+    int yrows = (op == CUSPARSE_OPERATION_NON_TRANSPOSE ? rows : cols);
+
+    CHECK_CUSPARSE( cusparseCreateCsr(
+        &descrA, rows, cols, nnz, drow, dcol, dval,
+        CUSPARSE_INDEX_32I, CUSPARSE_INDEX_32I,
+        CUSPARSE_INDEX_BASE_ZERO, CUDA_C_64F ));
+    CHECK_CUSPARSE( cusparseCreateDnVec( &descrX, xrows, x, CUDA_C_64F ));
+    CHECK_CUSPARSE( cusparseCreateDnVec( &descrY, yrows, y, CUDA_C_64F ));
+    CHECK_CUSPARSE( cusparseSpMV_bufferSize(
+        handle, op, alpha, descrA, descrX, beta, descrY,
+        CUDA_C_64F, CUSPARSE_CSRMV_ALG1, &bufsize ));
+    if (bufsize > 0) {
+        CHECK( magma_malloc( &buf, bufsize ));
+    }
+    CHECK_CUSPARSE( cusparseSpMV(
+        handle, op, alpha, descrA, descrX, beta, descrY,
+        CUDA_C_64F, CUSPARSE_CSRMV_ALG1, buf ));
+
+cleanup:
+    if (buf != NULL) magma_free( buf );
+    if (descrY != NULL) cusparseDestroyDnVec( descrY );
+    if (descrX != NULL) cusparseDestroyDnVec( descrX );
+    if (descrA != NULL) cusparseDestroySpMat( descrA );
+    return info;
+}
