{
  lib,
  stdenv,
  fetchFromGitHub,
  python3,
  cmake,
  nix-update-script,
}:

# Generates the same C MAVLink headers mavlink/c_library_v2 ships, but from
# the real authoritative sources instead of depending on that repo's
# periodic bot-authored snapshot commits (every commit there is machine-
# generated - "autogenerated headers for rev <mavlink/mavlink commit>" -
# with zero review, so track the two real upstreams directly): the XML
# message definitions in mavlink/mavlink, run through the C generator
# (generator/mavgen_c.py) that lives in mavlink/mavlink's own pymavlink
# submodule, pinned here independently since it's a separate upstream repo
# (ArduPilot/pymavlink) with its own release cadence.
#
# mavgen'ing just the top-level "all.xml" meta-dialect (which <include>s
# every other dialect XML) produces every dialect subdirectory in one pass -
# confirmed empirically to reproduce c_library_v2's exact directory layout
# (one dir per dialect, plus the shared root headers mavgen copies in).
#
# Upstream's own C-generator also generates a pack/unpack round-trip
# self-test (testsuite.h, built on a MAVLINK_ASSERT macro) into every
# dialect, right alongside its message headers - cmake-build.patch supplies
# the missing test driver and a real MAVLINK_ASSERT, so these checks
# actually run, one dialect at a time (the "all" meta-dialect is skipped:
# its generated testsuite.h has an upstream mavgen bug - see the patch -
# and every message it contains is already covered via its 18 constituent
# dialects). Upstream PR for the mavgen bug:
# https://github.com/ArduPilot/pymavlink/pull/1322
stdenv.mkDerivation (finalAttrs: {
  pname = "mavlink-c-library-v2";
  version = "0-unstable-2026-10-28";

  strictDeps = true;
  __structuredAttrs = true;
  separateDebugInfo = true;

  src = fetchFromGitHub {
    owner = "mavlink";
    repo = "mavlink";
    rev = "6bf60db460579d3e98c40b8581a51f579ec1b33c";
    hash = "sha256-uik0y8LW4HCbMzYRNfkC/WZ4ED6Ompin3ICZS5kYgIg=";
  };

  # Only the generator (generator/mavgen_c.py et al) is needed from this -
  # pinned separately from the XML definitions above since it's a distinct
  # upstream repo (not vendored as mavlink/mavlink's pymavlink submodule
  # here, to avoid an unnecessary fetchSubmodules + needing network access
  # to resolve it at fetch time).
  pymavlinkSrc = fetchFromGitHub {
    owner = "ArduPilot";
    repo = "pymavlink";
    rev = "03af8c2d476c2c83c3db9a95506f31b80bf0b898";
    hash = "sha256-odDN44kit+EWZPdNRdbcXYXd7g8gUKIHTqAxSUhsl6M=";
  };

  patches = [
    ./cmake-build.patch
  ];

  postPatch = ''
    # tools/mavgen.py does `from pymavlink.generator import mavgen`, so a
    # directory literally named pymavlink/ needs to be on PYTHONPATH (true
    # in mavlink/mavlink's own checkout, where it's a submodule at that
    # exact path - recreate that here since pymavlinkSrc is fetched
    # separately).
    pythonpath_dir=$(mktemp -d)
    ln -s ${finalAttrs.pymavlinkSrc} "$pythonpath_dir/pymavlink"

    # Generated into its own directory (not the source root, which is the
    # rest of the real mavlink/mavlink checkout) so nix-build/CMakeLists.txt
    # can install exactly these headers, not sweep up unrelated files.
    mkdir -p generated-headers
    PYTHONPATH="$pythonpath_dir" python3 ${finalAttrs.pymavlinkSrc}/tools/mavgen.py \
      --lang=C --wire-protocol=2.0 -o generated-headers message_definitions/v1.0/all.xml
    rm -rf "$pythonpath_dir"
  '';

  # Our CMake build lives in its own subdirectory rather than patching
  # upstream's own, unrelated root CMakeLists.txt (which drives mavgen
  # itself, for every target language, via its own Python/pip tooling).
  cmakeDir = "../nix-build";

  doCheck = true;

  nativeBuildInputs = [
    python3
    cmake
  ];

  # Only tracks the mavlink/mavlink XML definitions above - pymavlinkSrc
  # needs bumping by hand alongside it, since it's a second, independent
  # upstream with its own release cadence nix-update-script can't drive at
  # the same time.
  passthru.updateScript = nix-update-script { extraArgs = [ "--version=branch" ]; };

  meta = {
    description = "C MAVLink headers for all dialects (common, development, and vendor-specific), generated from mavlink/mavlink's own XML message definitions";
    homepage = "https://github.com/mavlink/mavlink";
    license = lib.licenses.mit;
    platforms = lib.platforms.all;
    maintainers = with lib.maintainers; [ pandapip1 ];
  };
})
