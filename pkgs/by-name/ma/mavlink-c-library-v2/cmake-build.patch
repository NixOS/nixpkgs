diff -ruN mavlink-pristine/cmake/mavlink-c-library-v2Config.cmake.in mavlink-new/cmake/mavlink-c-library-v2Config.cmake.in
--- mavlink-pristine/cmake/mavlink-c-library-v2Config.cmake.in	1969-12-31 19:00:00.000000000 -0500
+++ mavlink-new/cmake/mavlink-c-library-v2Config.cmake.in	2026-10-29 00:56:46.935964812 -0400
