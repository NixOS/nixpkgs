From 1e45f2ce30fb14eaaf6be82a6cbffbda8d380dd0 Mon Sep 17 00:00:00 2001
From: Rafael Ieda <git@ieda.me>
Date: Mon, 23 Nov 2026 17:37:30 -0300
Subject: [PATCH 1/5] cmake: Allow using the system SDL3

---
 CMakeLists.txt          | 10 ++++++++++
 external/CMakeLists.txt |  4 +++-
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 548dfe9d..03c415d8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -131,6 +131,16 @@ endmacro(get_boost)
 
 get_boost()
 
+############################
+########### SDL ############
+############################
+
+option(VITA3K_USE_SYSTEM_SDL "Use the SDL3 version in the system instead of building the one included with Vita3K" OFF)
+
+if(VITA3K_USE_SYSTEM_SDL)
+	find_package(SDL3 3.4 REQUIRED CONFIG)
+endif()
+
 if(WIN32)
 	add_compile_definitions("_SILENCE_ALL_CXX17_DEPRECATION_WARNINGS" "_CRT_SECURE_NO_WARNINGS" "NOMINMAX")
 endif()
diff --git a/external/CMakeLists.txt b/external/CMakeLists.txt
index 26ed6ed5..afb0f550 100644
--- a/external/CMakeLists.txt
+++ b/external/CMakeLists.txt
@@ -80,7 +80,9 @@ add_subdirectory(libfat16)
 add_library(miniz STATIC miniz/miniz.c miniz/miniz.h)
 target_include_directories(miniz PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/miniz")
 
-add_subdirectory(sdl)
+if(NOT VITA3K_USE_SYSTEM_SDL)
+	add_subdirectory(sdl)
+endif()
 
 # Cubeb setup, from https://github.com/RPCS3/rpcs3/blob/master/3rdparty/cubeb/CMakeLists.txt
 set(BUILD_SHARED_LIBS FALSE CACHE BOOL "Don't build shared libs")
-- 
