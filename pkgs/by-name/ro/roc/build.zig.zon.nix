# generated by zon2nix (https://github.com/nix-community/zon2nix), then reduced
# to the packages a build of roc actually asks for.
#
# roc ships its LLVM, LLD and Binaryen as one prebuilt archive per *host*
# platform (`roc_deps_<triple>`, 39-112 MB each) and declares all of them lazily,
# so a build fetches only the archive matching the machine it runs on. Keeping
# every archive here would make each build download ~440 MB it never opens, so
# `rocDeps` lists one per platform and only the entry for the platform being
# built is fetched. The AFL++ and kcov entries are dropped for the same reason:
# only `-Dfuzz` builds ask for AFL++, and the coverage step that would ask for
# kcov is switched off with `-Dcoverage=false` in package.nix. Everything roc
# asks for on the platforms in `meta.platforms` is below.
#
# Regenerate with `zon2nix` in the roc source tree, then drop those entries again.

{
  stdenv,
  linkFarm,
  fetchzip,
  fetchgit,
}:

let
  rocDeps = {
