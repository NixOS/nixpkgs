      name = "N-V-__8AAFRVFhloG5rlb8GkGn4-7ays_ZfWOq4W_pi1ETcU";
      path = fetchzip {
        url = "https://github.com/roc-lang/roc-bootstrap/releases/download/zig-0.17.0/x86_64-linux-musl.tar.xz";
        hash = "sha256-yGQdZo9ll5bBa9wIZGV9TjlEtwgqfePXkp3YZv5OVrw=";
