{
  lib,
  stdenv,
  fetchFromGitHub,
  cmakeMinimal,
  bashNonInteractive,
  gnugrep,
  fixDarwinDylibNames,
  file,
  versionCheckHook,
  legacySupport ? false,
  static ? stdenv.hostPlatform.isStatic, # generates static libraries *only*
  enableStatic ? static,
  # these need to be ran on the host, thus disable when cross-compiling
  buildContrib ? stdenv.buildPlatform.canExecute stdenv.hostPlatform,
  nix-update-script,

  # for passthru.tests
  libarchive,
  rocksdb,
  arrow-cpp,
  libzip,
  curl,
  python3Packages,
  haskellPackages,
  testers,
}:

# Note: this package is used for bootstrapping fetchurl, and thus
# cannot use fetchpatch! All mutable patches (generated by GitHub or
# cgit) that are needed here should be included directly in Nixpkgs as
# files.

stdenv.mkDerivation (finalAttrs: {
  pname = "zstd";
  version = "1.6.0";

  src = fetchFromGitHub {
    owner = "meta";
    repo = "zstd";
    tag = "v${finalAttrs.version}";
    hash = "sha256-bzIcrgp7uYeJ+LEv6Nb9Nd41jGfJvUvDZ0nxQBu5Tvo=";
  };

  patches = [
    # This patches makes sure we do not attempt to use the MD5 implementation
    # of the host platform when running the tests
    ./playtests-darwin.patch
  ];

  postPatch = lib.optionalString (!static) ''
    substituteInPlace build/cmake/CMakeModules/ZstdBuild.cmake \
      --replace-fail 'message(SEND_ERROR "Static library required to build test suite")' ""
    substituteInPlace build/cmake/tests/CMakeLists.txt \
      --replace-fail 'libzstd_static' 'libzstd_shared'
    sed -i \
      "1aexport ${lib.optionalString stdenv.hostPlatform.isDarwin "DY"}LD_LIBRARY_PATH=$PWD/build_/lib" \
      tests/playTests.sh
  '';

  nativeBuildInputs = [
    cmakeMinimal
  ]
  ++ lib.optionals stdenv.hostPlatform.isDarwin [ fixDarwinDylibNames ];
  buildInputs = lib.optionals stdenv.hostPlatform.isUnix [ bashNonInteractive ];

  strictDeps = true;

  cmakeDir = "../build/cmake";
  dontUseCmakeBuildDir = true;
  preConfigure = ''
    mkdir -p build_ && cd $_
  '';

  cmakeFlags = [
    (lib.cmakeBool "ZSTD_BUILD_CONTRIB" buildContrib)
    (lib.cmakeBool "ZSTD_BUILD_SHARED" (!static))
    (lib.cmakeBool "ZSTD_BUILD_STATIC" enableStatic)
    (lib.cmakeBool "ZSTD_BUILD_TESTS" finalAttrs.finalPackage.doCheck)
    (lib.cmakeBool "ZSTD_PROGRAMS_LINK_SHARED" (!static))
    (lib.cmakeBool "ZSTD_LEGACY_SUPPORT" legacySupport)
  ];

  doCheck = true;
  nativeCheckInputs = [ file ];
  checkPhase = ''
    runHook preCheck
    # Patch shebangs for playTests
    patchShebangs ../programs/zstdgrep
    ctest -R playTests # The only relatively fast test.
    runHook postCheck
  '';

  preInstall = ''
    substituteInPlace ../programs/zstdgrep \
      --replace-fail ":-grep" ":-${gnugrep}/bin/grep" \
      --replace-fail ":-zstdcat" ":-$bin/bin/zstdcat"

    substituteInPlace ../programs/zstdless \
      --replace-fail ":-zstd" ":-$bin/bin/zstd"
  '';

  postInstall = ''
    moveToOutput bin/pzstd $bin
  ''
  + lib.optionalString (buildContrib && stdenv.hostPlatform.isDarwin) ''
    install_name_tool -change @rpath/libzstd.1.dylib $out/lib/libzstd.1.dylib $bin/bin/pzstd
  ''
  # replace invalid symlinks when executable suffix is .exe
  + lib.optionalString stdenv.hostPlatform.isCygwin ''
    for link in unzstd zstdcat zstdmt; do
      ln -sf zstd.exe $bin/bin/$link
    done
  '';

  doInstallCheck = true;
  nativeInstallCheckInputs = [ versionCheckHook ];

  outputs = [
    "bin"
    "dev"
    "out"
  ]
  ++ lib.optionals buildContrib [ "doc" ]
  ++ lib.optionals stdenv.hostPlatform.isUnix [ "man" ];

  passthru = {
    updateScript = nix-update-script { };
    tests = {

      # Reverse dependencies

      inherit libarchive rocksdb arrow-cpp;
      libzip = libzip.override { withZstd = true; };
      curl = curl.override { zstdSupport = true; };
      python-zstd = python3Packages.zstd;
      haskell-zstd = haskellPackages.zstd;
      haskell-hs-zstd = haskellPackages.hs-zstd;

      # Package tests (coherent with overrides)

      pkg-config = testers.hasPkgConfigModules { package = finalAttrs.finalPackage; };
    };
  };

  __structuredAttrs = true;

  meta = {
    description = "Zstandard real-time compression algorithm";
    longDescription = ''
      Zstd, short for Zstandard, is a fast lossless compression algorithm,
      targeting real-time compression scenarios at zlib-level compression
      ratio. Zstd can also offer stronger compression ratio at the cost of
      compression speed. Speed/ratio trade-off is configurable by small
      increment, to fit different situations. Note however that decompression
      speed is preserved and remain roughly the same at all settings, a
      property shared by most LZ compression algorithms, such as zlib.
    '';
    homepage = "https://facebook.github.io/zstd/";
    changelog = "https://github.com/meta/zstd/blob/v${finalAttrs.version}/CHANGELOG";
    license = lib.licenses.OR [
      lib.licenses.bsd3
      lib.licenses.gpl2Only
    ];
    mainProgram = "zstd";
    platforms = lib.platforms.all;
    identifiers.cpeParts = lib.meta.cpeFullVersionWithVendor "facebook" finalAttrs.version // {
      product = "zstandard";
    };
    maintainers = [ ];
    pkgConfigModules = [ "libzstd" ];
  };
})
