{
  lib,
  rustPlatform,
  fetchFromGitHub,
  installShellFiles,
  versionCheckHook,
  libfido2,
  pcsclite,
  pkg-config,
  nix-update-script,
  nixosTests,
  stdenv,
}:

rustPlatform.buildRustPackage (finalAttrs: {
  pname = "yb";
  version = "0.7.2";

  src = fetchFromGitHub {
    owner = "douzebis";
    repo = "yb";
    tag = "v${finalAttrs.version}";
    hash = "sha256-3PspMWi61nlSaTlQTH9/wQkkklKp3xOA0rC14cXPdeI=";
  };

  cargoRoot = "rust";

  cargoHash = "sha256-s4CtsFNv9iDsoZzDQ1tFbTCVGOsev7e2Neo21FMKMsE=";

  # Build and test only the yb crate (not the yb-piv-harness test harness,
  # which requires a virtual smart card and runs in the NixOS VM test below).
  buildAndTestSubdir = "rust/yb";
  cargoBuildFlags = [
    "-p"
    "yb"
    "--features"
    "self-test"
  ];
  cargoTestFlags = [
    "-p"
    "yb"
    "--features"
    "self-test"
  ];

  nativeBuildInputs = [
    pkg-config
    installShellFiles
  ];

  buildInputs = [ libfido2 ] ++ lib.optionals stdenv.hostPlatform.isLinux [ pcsclite ];

  postInstall = lib.optionalString (stdenv.buildPlatform.canExecute stdenv.hostPlatform) ''
    installShellCompletion --cmd yb \
      --bash <(YB_COMPLETE=bash $out/bin/yb) \
      --zsh <(YB_COMPLETE=zsh $out/bin/yb) \
      --fish <(YB_COMPLETE=fish $out/bin/yb)

    # Man pages (generated by the yb-gen-man helper binary, also in this crate).
    $out/bin/yb-gen-man $out/share/man/man1
  '';

  nativeInstallCheckInputs = [
    versionCheckHook
  ];
  doInstallCheck = true;

  passthru = {
    # The tier-2 test binaries (hardware_piv_tests, yb_cli_tests), run by the
    # NixOS VM test against a virtual smart card.  They reuse this package's
    # source and vendored dependencies.  Also a yb built with the
    # test-fixture feature, which honors YB_FIXTURE (a simulated YubiKey,
    # for yb_cli_tests); the packaged yb ignores it.  Kept out of PATH.
    ybPivHarnessTests = rustPlatform.buildRustPackage {
      pname = "yb-piv-harness-tests";
      inherit (finalAttrs)
        version
        src
        cargoRoot
        cargoDeps
        ;

      buildAndTestSubdir = "rust/yb-piv-harness";
      cargoBuildFlags = [
        "-p"
        "yb-piv-harness"
        "-p"
        "yb"
        "--features"
        "yb-piv-harness/integration-tests,yb/test-fixture"
      ];

      nativeBuildInputs = [
        pkg-config
        # littlefs2-sys (under piv-authenticator) runs bindgen.
        rustPlatform.bindgenHook
      ];
      buildInputs = [ libfido2 ] ++ lib.optionals stdenv.hostPlatform.isLinux [ pcsclite ];

      postInstall = ''
        mkdir -p $out/libexec
        mv $out/bin/yb $out/libexec/yb-test-fixture
        rm $out/bin/yb-gen-man
      '';

      doCheck = false;
    };
    tests.integration = nixosTests.yb;
    updateScript = nix-update-script { };
  };

  meta = {
    description = "Secure blob storage on a YubiKey";
    longDescription = ''
      Command-line tool for storing encrypted binary blobs on a YubiKey using
      the PIV application. Blobs are encrypted with ECDH (the private key
      never leaves the YubiKey) and AES-256-GCM, and signed. Includes a
      guided setup (yb format), a health report of the YubiKey and the store
      (yb fsck), management key rotation, glob-pattern blob selection, and
      shell completions for bash, zsh, and fish.
    '';
    homepage = "https://github.com/douzebis/yb";
    changelog = "https://github.com/douzebis/yb/blob/${finalAttrs.src.rev}/CHANGELOG.md";
    license = lib.licenses.mit;
    maintainers = with lib.maintainers; [ douzebis ];
    mainProgram = "yb";
    platforms = lib.platforms.unix;
  };
})
