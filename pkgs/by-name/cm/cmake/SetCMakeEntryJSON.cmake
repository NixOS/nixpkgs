if (NOT DEFINED PREKEY)
  set(PREKEY "cmakeEntries")
endif()

file(READ $ENV{NIX_ATTRS_JSON_FILE} ATTRS_JSON_STRING)

if (DONT_OVERRIDE)
  string(JSON EXISTING_VALUE ERROR_VARIABLE ERROR_VAR GET "${ATTRS_JSON_STRING}" ${PREKEY} "${KEY}")
  if (ERROR_VAR STREQUAL "")
    cmake_language(EXIT 0)
  endif()
endif()

if (NOT PREKEY STREQUAL "" AND NOT KEY STREQUAL "")
  set(UNEXPECTED_TYPES NULL ARRAY OBJECT)
  string(JSON CMAKE_ENTRY_TYPE TYPE "${INPUT_JSON}")
  if (IGNORE_NULL AND CMAKE_ENTRY_TYPE STREQUAL "NULL")
    cmake_language(EXIT 0)
  endif()
  list(FIND UNEXPECTED_TYPES ${CMAKE_ENTRY_TYPE} UNEXPECTED_TYPE_FOUND)
  if (NOT UNEXPECTED_TYPE_FOUND STREQUAL "-1")
      message(FATAL_ERROR "SetCMakeEntryJSON: Unexpected value type ${CMAKE_ENTRY_TYPE} for INPUT_JSON ${INPUT_JSON}")
  endif()
endif()

string(JSON ATTRS_JSON_STRING SET "${ATTRS_JSON_STRING}" ${PREKEY} "${KEY}" "${INPUT_JSON}")
file(WRITE $ENV{NIX_ATTRS_JSON_FILE} "${ATTRS_JSON_STRING}")
