set(UNEXPECTED_TYPES NULL ARRAY OBJECT)

function(check_type MEMBER_TYPE DESCRIPTION ERROR_VARIABLE)
  list(FIND UNEXPECTED_TYPES "${MEMBER_TYPE}" UNEXPECTED_TYPE_FOUND)
  if(NOT UNEXPECTED_TYPE_FOUND STREQUAL "-1")
    set(MSG "OperateJSONAttr: Unexpected value type ${MEMBER_TYPE} for ${DESCRIPTION}")
    if(ERROR_VARIABLE STREQUAL "")
      message(FATAL_ERROR "$MSG")
    endif()
    set("${ERROR_VARIABLE}" "${MSG}" PARENT_SCOPE)
  else()
    set("${ERROR_VARIABLE}" "" PARENT_SCOPE)
  endif()
endfunction()

if(NOT DEFINED KEYWORD OR KEYWORD STREQUAL "")
  message(FATAL_ERROR "OperateJSONAttr: Expect non-empty KEYWORD")
endif()
string(TOUPPER "${KEYWORD}" KEYWORD)

if(NOT DEFINED KEY)
  message(FATAL_ERROR "OperateJSONAttr: Expect KEY")
endif()
set(TAIL_ARGS ${PREKEY} "${KEY}")

if(DEFINED DEFAULT_STRING)
  set(OBJECT_STRING "${DEFAULT_STRING}")
endif()

if(KEYWORD STREQUAL "SET")
  if(NOT DEFINED INPUT_JSON OR INPUT_JSON STREQUAL "")
    message(FATAL_ERROR "OperateJSONAttr: Expect non-empty INPUT_JSON for keyword ${KEYWORD}")
  endif()
  list(APPEND TAIL_ARGS "${INPUT_JSON}")
endif()

set(SKIP_ACTION false)

file(READ $ENV{NIX_ATTRS_JSON_FILE} ATTRS_JSON_STRING)

string(JOIN "." LITERAL_KEYS ${PREKEY} "${KEY}")

if(KEYWORD MATCHES "^(GET|SET)" AND NOT PREKEY STREQUAL "")
  if(KEYWORD STREQUAL "SET")
    string(JSON MEMBER_TYPE TYPE "${INPUT_JSON}")
    check_type("${MEMBER_TYPE}" "INPUT_JSON" "")
    if(DEFINED DONT_OVERRIDE)
      string(JSON EXISTING_VALUE ERROR_VARIABLE ERROR_VAR GET "${ATTRS_JSON_STRING}" ${PREKEY} "${KEY}")
      if (ERROR_VAR STREQUAL "")
        message(DEBUG "OperateJSONAttr: Member ${LITERAL_KEYS} already exists and DONT_OVERRIDE=${DONT_OVERRIDE}, skipping writing.")
        string(JSON MEMBER_TYPE TYPE "${EXISTING_VALUE}")
        check_type("${MEMBER_TYPE}" "existing ${LITERAL_KEYS} value ${EXISTING_VALUE}" "")
        cmake_language(EXIT 0)
      endif()
    endif()
  else()
    if(DEFINED DEFAULT_STRING)
      string(JSON MEMBER_TYPE ERROR_VARIABLE ERROR_VAR TYPE "${ATTRS_JSON_STRING}" ${TAIL_ARGS})
      if(NOT ERROR_VAR STREQUAL "")
        message(DEBUG "OperateJSONAttr: TYPE ${LITERAL_KEYS} for ${KEYWORD} failed, falling back to default ${DEFAULT_STRING}. Error message: ${ERROR_VAR}")
        set(SKIP_ACTION true)
      else()
        check_type("${MEMBER_TYPE}" "${LITERAL_KEYS}" ERROR_VAR)
        if(NOT ERROR_VAR STREQUAL "")
          message(WARNING "${ERROR_VAR}, falling back to default ${DEFAULT_STRING}.")
          set(SKIP_ACTION true)
        endif()
      endif()
    else()
      string(JSON MEMBER_TYPE TYPE "${ATTRS_JSON_STRING}" ${TAIL_ARGS})
      check_type("${MEMBER_TYPE}" "${LITERAL_KEYS}" "")
    endif()
  endif()
endif()

if(KEYWORD STREQUAL "SET" AND DONT_OVERRIDE)
  string(JSON EXISTING_VALUE ERROR_VARIABLE ERROR_VAR GET "${ATTRS_JSON_STRING}" ${PREKEY} "${KEY}")
  if (ERROR_VAR STREQUAL "")
    message(DEBUG "OperateJSONAttr: Member ${LITERAL_KEYS} exists for un")
    cmake_language(EXIT 0)
  endif()
endif()

if(NOT SKIP_ACTION)
  if(DEFINED DEFAULT_STRING)
    string(JSON OBJECT_STRING ERROR_VARIABLE ERROR_VAR ${KEYWORD} "${ATTRS_JSON_STRING}" ${TAIL_ARGS})
    if(NOT ERROR_VAR STREQUAL "")
      message(DEBUG "OperateJSONAttr: ${KEYWORD} ${LITERAL_KEYS} failed, falling back to default ${DEFAULT_STRING}. Error message: ${ERROR_VAR}")
    endif()
  else()
    string(JSON OBJECT_STRING ${KEYWORD} "${ATTRS_JSON_STRING}" ${TAIL_ARGS})
  endif()
endif()

if(KEYWORD MATCHES "^(REMOVE|SET)")
  file(WRITE $ENV{NIX_ATTRS_JSON_FILE} "${OBJECT_STRING}")
else()
  file(APPEND /dev/stdout "${OBJECT_STRING}")
endif()
