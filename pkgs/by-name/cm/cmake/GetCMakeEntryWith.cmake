string(TOUPPER "${KEYWORD}" KEYWORD)

if (NOT DEFINED PREKEY)
  set(PREKEY "cmakeEntries")
endif()

file(READ $ENV{NIX_ATTRS_JSON_FILE} ATTRS_JSON_STRING)

set(SKIP_ACTION false)

if (KEYWORD STREQUAL "GET")
  set(UNEXPECTED_TYPES NULL ARRAY OBJECT)
  if (DEFINED DEFAULT_STRING)
    string(JSON OUTPUT_TYPE ERROR_VARIABLE ERROR_VAR TYPE "${ATTRS_JSON_STRING}" ${PREKEY} "${KEY}")
    list(FIND UNEXPECTED_TYPES "${OUTPUT_TYPE}" UNEXPECTED_TYPE_FOUND)
    if (NOT ERROR_VAR STREQUAL "" OR NOT UNEXPECTED_TYPE_FOUND STREQUAL "-1")
      set(OBJECT_STRING "${DEFAULT_STRING}")
      set(SKIP_ACTION true)
    endif()
  else()
    string(JSON OUTPUT_TYPE TYPE "${ATTRS_JSON_STRING}" ${PREKEY} "${KEY}")
    list(FIND UNEXPECTED_TYPES "${OUTPUT_TYPE}" UNEXPECTED_TYPE_FOUND)
    if (NOT UNEXPECTED_TYPE_FOUND STREQUAL "-1")
      message(FATAL_ERROR "GetCMakeEntryWith: Unexpected value type ${OUTPUT_TYPE} for ${PREKEY}.${KEY}")
    endif()
  endif()
endif()

if (NOT SKIP_ACTION)
  if (DEFINED DEFAULT_STRING)
    string(JSON OBJECT_STRING ERROR_VARIABLE ERROR_VAR ${KEYWORD} "${ATTRS_JSON_STRING}" ${PREKEY} "${KEY}")
    if (NOT ERROR_VAR STREQUAL "")
      set(OBJECT_STRING "${DEFAULT_STRING}")
    endif()
  else()
    string(JSON OBJECT_STRING ${KEYWORD} "${ATTRS_JSON_STRING}" ${PREKEY} "${KEY}")
  endif()
endif()

if (KEYWORD STREQUAL "REMOVE")
  file(WRITE $ENV{NIX_ATTRS_JSON_FILE} "${OBJECT_STRING}")
else()
  file(APPEND /dev/stdout "${OBJECT_STRING}")
endif()
