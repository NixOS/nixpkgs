{
  lib,
  stdenv,
  fetchFromGitHub,
  fetchpatch,
  SDL2,
  _experimental-update-script-combinators,
  buildPackages,
  cmake,
  curl,
  fluidsynth,
  fontconfig,
  freetype,
  harfbuzz,
  icu,
  libGL,
  libogg,
  libopus,
  libpng,
  lzo,
  nix-update-script,
  openttd-opengfx,
  openttd-openmsx,
  openttd-opensfx,
  opusfile,
  pkg-config,
  soundfont-fluid,
  versionCheckHook,
  xz,
  zlib,
  soundfont-name ? "FluidR3_GM2-2",
  withFluidSynth ? true,
  withOpenGFX ? true,
  withOpenMSX ? true,
  withOpenSFX ? true,
}:

let
  # OpenTTD builds and uses some of its own tools during the build and we need those to be available for cross-compilation.
  # Build the tools for buildPlatform with minimal dependencies, using the "OPTION_TOOLS_ONLY" flag.
  crossTools = buildPackages.openttd.overrideAttrs (oldAttrs: {
    pname = "openttd-tools";
    buildInputs = [ ];
    cmakeFlags = oldAttrs.cmakeFlags or [ ] ++ [ (lib.cmakeBool "OPTION_TOOLS_ONLY" true) ];
    doCheck = false;
    installPhase = ''
      install -Dm555 src/strgen/strgen -t $out/bin
      install -Dm555 src/settingsgen/settingsgen -t $out/bin
    '';
    doInstallCheck = false;
  });
in
stdenv.mkDerivation (finalAttrs: {
  pname = "openttd";
  version = "15.3";

  __structuredAttrs = true;
  strictDeps = true;

  src = fetchFromGitHub {
    owner = "OpenTTD";
    repo = "OpenTTD";
    tag = finalAttrs.version;
    hash = "sha256-SeU2pqB//6i87Q8DJkxQfRToGZMYr+cOo/sAgrDFlYw=";
    # Only release bundles from OpenTTD's CDN provide a `.ottdrev` file with the
    # versioning information required for the build. When building from the
    # GitHub source tree, the file needs to be generated by `cmake`.
    # The generation script requires the `.git` directory to be present to
    # extract the rev/tag, commit hash, commit date, and Git tree status.
    leaveDotGit = true;
    nativeBuildInputs = [ cmake ];
    postFetch = ''
      cd $out
      # This is workaround. Above, you can use `fetchTags=true`, but that does
      # a deep clone, even with `deepClone=false`. That takes a long time, so
      # instead we manually create the tag for the script to use.
      git tag ${finalAttrs.src.tag} HEAD
      # No .git/index exists otherwise and the tree is dirty.
      git reset --mixed HEAD
      cmake -DGENERATE_OTTDREV=ON -P cmake/scripts/FindVersion.cmake
      rm -rf .git
    '';
  };

  patches = [
    # CMake 4.5 rejects the extra arguments to install(CODE)
    (fetchpatch {
      name = "install-code-doesnt-know-destination.patch";
      url = "https://github.com/OpenTTD/OpenTTD/commit/db494a6dcff8f1778af3ab10be5a47f67f8f864c.patch";
      hash = "sha256-JH1jY3dwtpAod7bPZObG+CzKibWkDm8f1QC2TX/NzrQ=";
    })
  ];

  postPatch =
    lib.optionalString withFluidSynth ''
      substituteInPlace src/music/fluidsynth.cpp \
        --replace-fail "/usr/share/soundfonts/default.sf2" \
                       "${soundfont-fluid}/share/soundfonts/${soundfont-name}.sf2"
    ''
    # bundle is assembled in postInstall, not by fixup_bundle
    # Info.plist copyright year from the release, not SOURCE_DATE_EPOCH
    + lib.optionalString stdenv.hostPlatform.isDarwin ''
      substituteInPlace cmake/PackageBundle.cmake \
        --replace-fail "fixup_bundle(" "message(STATUS " \
        --replace-fail 'string(TIMESTAMP CURRENT_YEAR "%Y")' \
                       "set(CURRENT_YEAR $(cut -f2 .ottdrev* | head -n1 | cut -c1-4))"
    '';

  nativeBuildInputs = [
    cmake
    pkg-config
  ]
  ++ lib.optionals (!stdenv.buildPlatform.canExecute stdenv.hostPlatform) [
    crossTools
  ];

  buildInputs = [
    SDL2
    curl
    fontconfig
    freetype
    harfbuzz
    icu
    libGL
    libogg
    libopus
    libpng
    lzo
    opusfile
    xz
    zlib
  ]
  ++ lib.optional withFluidSynth fluidsynth;

  # upstream defaults to an app bundle layout on darwin
  cmakeFlags = lib.optionals stdenv.hostPlatform.isDarwin [
    (lib.cmakeBool "OPTION_INSTALL_FHS" true)
    (lib.cmakeFeature "GLOBAL_DIR" "${placeholder "out"}/share/games/openttd")
  ];

  doCheck = true;
  # regression tests need a graphics set
  preCheck = ''
    ln -s ${openttd-opengfx}/* baseset
  '';
  postCheck = ''
    rm baseset/opengfx-*
  '';
  doInstallCheck = true;
  nativeInstallCheckInputs = [ versionCheckHook ];

  postInstall = ''
    ln -s $out/share/doc/${finalAttrs.pname}/* $out/share/games/openttd
  ''
  + lib.optionalString withOpenGFX ''
    cp -r ${openttd-opengfx}/* $out/share/games/openttd/baseset
  ''
  + lib.optionalString withOpenSFX ''
    cp ${openttd-opensfx}/*.tar $out/share/games/openttd/baseset
  ''
  + lib.optionalString withOpenMSX ''
    cp -r ${openttd-openmsx}/* $out/share/games/openttd/baseset
  ''
  + lib.optionalString stdenv.hostPlatform.isDarwin ''
    mkdir -p $out/Applications/OpenTTD.app/Contents/{MacOS,Resources}
    substitute Info.plist.in $out/Applications/OpenTTD.app/Contents/Info.plist \
      --replace-fail "#CPACK_PACKAGE_VERSION#" "${finalAttrs.version}"
    cp ../os/macosx/openttd.icns $out/Applications/OpenTTD.app/Contents/Resources/OpenTTD.icns
    ln -s $out/bin/openttd $out/Applications/OpenTTD.app/Contents/MacOS/openttd
  '';

  passthru.updateScript = _experimental-update-script-combinators.sequence (
    map
      (
        pkg:
        (nix-update-script {
          attrPath = pkg;
        })
      )
      [
        "openttd-opengfx"
        "openttd-opensfx"
        "openttd-openmsx"
        "openttd"
      ]
  );

  meta = {
    description = ''Open source clone of the Microprose game "Transport Tycoon Deluxe"'';
    longDescription = ''
      OpenTTD is a transportation economics simulator. In single player mode,
      players control a transportation business, and use rail, road, sea, and air
      transport to move goods and people around the simulated world.

      In multiplayer networked mode, players may:
        - play competitively as different businesses
        - play cooperatively controlling the same business
        - observe as spectators
    '';
    homepage = "https://www.openttd.org/";
    changelog = "https://cdn.openttd.org/openttd-releases/${finalAttrs.version}/changelog.md";
    license = lib.licenses.gpl2Only;
    maintainers = with lib.maintainers; [
      jcumming
      fpletz
      magicquark
      iedame
    ];
    platforms = lib.platforms.linux ++ lib.platforms.darwin;
    mainProgram = "openttd";
    downloadPage = "https://www.openttd.org/downloads/openttd-releases/latest";
  };
})
