diff --git a/src/c/util/time.c b/src/c/util/time.c
index 12aec56..0da1762 100644
--- a/src/c/util/time.c
+++ b/src/c/util/time.c
@@ -10,7 +10,15 @@
 #endif /* ifdef WIN32 */
 
 // PX4
-#if defined(__PX4_NUTTX) || defined(__PX4_POSIX) || defined(UCLIENT_PLATFORM_NUTTX) || defined(UCLIENT_PLATFORM_POSIX)
+// __PX4_POSIX is only ever injected by PX4-Autopilot's own in-tree build of
+// this submodule (it's never set by this repo's own CMakeLists.txt), so it
+// reliably distinguishes that from a standalone build of this library.
+// UCLIENT_PLATFORM_POSIX, by contrast, is this repo's own generic platform
+// autodetect (set for any Linux/macOS/NuttX/Zephyr host, including a
+// standalone build) and was never meant to imply "drivers/drv_hrt.h is
+// available" - drop it here so a standalone POSIX build doesn't require a
+// PX4-Autopilot-internal header it has no access to.
+#if defined(__PX4_NUTTX) || defined(__PX4_POSIX) || defined(UCLIENT_PLATFORM_NUTTX)
 
 #ifdef	__cplusplus
 # define __BEGIN_DECLS	extern "C" {
@@ -71,7 +79,7 @@ int64_t uxr_nanos(
     struct timespec ts;
     z_impl_clock_gettime(CLOCK_REALTIME, &ts);
     return (((int64_t)ts.tv_sec) * 1000000000) + ts.tv_nsec;
-#elif defined(__PX4_NUTTX) || defined(__PX4_POSIX) || defined(UCLIENT_PLATFORM_NUTTX) || defined(UCLIENT_PLATFORM_POSIX)
+#elif defined(__PX4_NUTTX) || defined(__PX4_POSIX) || defined(UCLIENT_PLATFORM_NUTTX)
 
     return (int64_t)(hrt_absolute_time() * 1000);
 #else
