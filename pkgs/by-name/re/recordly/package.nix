{
  lib,
  autoPatchelfHook,
  buildNpmPackage,
  copyDesktopItems,
  electron,
  ffmpeg-headless,
  fetchFromGitHub,
  libx11,
  libxrandr,
  libxt,
  libxtst,
  makeDesktopItem,
  makeWrapper,
  nix-update-script,
  nodejs_22,
}:
buildNpmPackage (finalAttrs: {
  pname = "recordly";
  version = "1.4.0";

  src = fetchFromGitHub {
    owner = "webadderallorg";
    repo = "Recordly";
    tag = "v${finalAttrs.version}";
    hash = "sha256-2vyaSpyfjQA8p9sfw5Gksj5jDTGKWu31FDLiPW9F+ow=";
  };

  nodejs = nodejs_22;

  __structuredAttrs = true;

  npmDepsHash = "sha256-GvW+VOaRyWVd2MMu9VRVQIktswGgeFJFpQVM5U+2PCw=";

  # uiohook-napi ships N-API prebuilts that autoPatchelfHook fixes up, and the
  # remaining install scripts only fetch sources for platforms we do not build.
  npmRebuildFlags = [ "--ignore-scripts" ];

  nativeBuildInputs = [
    autoPatchelfHook
    copyDesktopItems
    makeWrapper
  ];

  buildInputs = [
    libx11
    libxrandr
    libxt
    libxtst
  ];

  env.ELECTRON_SKIP_BINARY_DOWNLOAD = "1";

  buildPhase = ''
    runHook preBuild

    npm exec tsc
    npm exec vite build
    node scripts/normalize-electron-main-cjs.mjs
    node scripts/smoke-electron-main-cjs.mjs

    npm exec electron-builder -- \
      --dir \
      -c.electronDist=${electron.dist} \
      -c.electronVersion=${electron.version} \
      -c.npmRebuild=false

    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall

    mkdir -p $out/share/recordly
    cp -r release/linux*-unpacked/{locales,resources{,.pak}} $out/share/recordly

    makeWrapper ${lib.getExe electron} $out/bin/recordly \
      --add-flags $out/share/recordly/resources/app.asar \
      --add-flags "\''${NIXOS_OZONE_WL:+\''${WAYLAND_DISPLAY:+--ozone-platform-hint=auto --enable-features=WaylandWindowDecorations --enable-wayland-ime=true}}" \
      --prefix PATH : ${lib.makeBinPath [ ffmpeg-headless ]} \
      --set-default ELECTRON_IS_DEV 0 \
      --set-default RECORDLY_DISABLE_AUTO_UPDATES 1 \
      --inherit-argv0

    for size in 16 24 32 48 64 128 256 512 1024; do
      install -Dm644 icons/icons/png/''${size}x''${size}.png \
        $out/share/icons/hicolor/''${size}x''${size}/apps/recordly.png
    done

    runHook postInstall
  '';

  desktopItems = [
    (makeDesktopItem {
      name = "recordly";
      desktopName = "Recordly";
      comment = finalAttrs.meta.description;
      icon = "recordly";
      exec = "recordly %u";
      categories = [
        "AudioVideo"
        "Video"
        "Recorder"
      ];
      startupWMClass = "Recordly";
      terminal = false;
    })
  ];

  passthru.updateScript = nix-update-script { };

  meta = {
    description = "Creator-focused screen recorder with auto-zoom, cursor effects, and backgrounds";
    longDescription = ''
      Creator-focused screen recorder with auto-zoom, cursor effects,
      backgrounds and annotations.

      Automatic captions are generated by whisper.cpp, which is not installed
      alongside Recordly. Install the whisper-cpp package to enable them, or
      point Recordly at a whisper-cli executable under Caption settings.
    '';
    homepage = "https://recordly.dev";
    changelog = "https://github.com/webadderallorg/Recordly/releases/tag/v${finalAttrs.version}";
    license = lib.licenses.agpl3Only;
    mainProgram = "recordly";
    maintainers = with lib.maintainers; [ bittner ];
    platforms = lib.platforms.linux;
  };
})
