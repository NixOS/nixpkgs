 //! is silently capped at `kern.maxfilesperproc`.

 pub fn raise_nofile_limit() {
+    let (before, hard) = rlimit::Resource::NOFILE.get().unwrap();
     match rlimit::increase_nofile_limit(rlimit::INFINITY) {
