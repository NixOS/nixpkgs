From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexander Ried <ried@mytum.de>
Date: Thu, 26 May 2016 19:54:21 +0200
Subject: [PATCH] Disable methods that change files in /etc

Only if environment variable NIXOS_USERS_PURE is set.
---
 src/daemon.c | 10 ++++++++++
 src/user.c   | 55 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 65 insertions(+)

diff --git a/src/daemon.c b/src/daemon.c
index b5ee767..9c24ad3 100644
--- a/src/daemon.c
+++ b/src/daemon.c
@@ -1917,6 +1917,11 @@ daemon_create_user (AccountsAccounts      *accounts,
                     const gchar           *real_name,
                     gint                   account_type)
 {
+        if (getenv("NIXOS_USERS_PURE")) {
+                throw_error (context, ERROR_NOT_SUPPORTED, "Modifying users not supported without users.mutableUsers");
+                return TRUE;
+        }
+
         Daemon *daemon = (Daemon *) accounts;
         CreateUserData *data;
 
@@ -2159,6 +2164,11 @@ daemon_delete_user (AccountsAccounts      *accounts,
                     gint64                 uid,
                     gboolean               remove_files)
 {
+        if (getenv("NIXOS_USERS_PURE")) {
+                throw_error (context, ERROR_NOT_SUPPORTED, "Modifying users not supported without users.mutableUsers");
+                return TRUE;
+        }
+
         Daemon *daemon = (Daemon *) accounts;
         DeleteUserData *data;
 
diff --git a/src/user.c b/src/user.c
index 216c71e..4689990 100644
--- a/src/user.c
+++ b/src/user.c
@@ -1976,6 +1976,11 @@ user_set_real_name (AccountsUser          *auser,
                     GDBusMethodInvocation *context,
                     const gchar           *real_name)
 {
+        if (getenv("NIXOS_USERS_PURE")) {
+                throw_error (context, ERROR_NOT_SUPPORTED, "Modifying users not supported without users.mutableUsers");
+                return TRUE;
+        }
+
         User *user = (User *) auser;
         int uid;
         const gchar *action_id;
@@ -2053,6 +2058,11 @@ user_set_user_name (AccountsUser          *auser,
                     GDBusMethodInvocation *context,
                     const gchar           *user_name)
 {
+        if (getenv("NIXOS_USERS_PURE")) {
+                throw_error (context, ERROR_NOT_SUPPORTED, "Modifying users not supported without users.mutableUsers");
+                return TRUE;
+        }
+
         User *user = (User *) auser;
 
         if (user_get_uses_homed (user)) {
@@ -2645,6 +2655,11 @@ user_set_password_expiration_policy (AccountsUser          *auser,
                                      gint64                 days_to_warn,
                                      gint64                 days_after_expiration_until_lock)
 {
+        if (getenv("NIXOS_USERS_PURE")) {
+                throw_error (context, ERROR_NOT_SUPPORTED, "Modifying users not supported without users.mutableUsers");
+                return TRUE;
+        }
+
         User *user = (User *) auser;
         int uid;
         const gchar *action_id;
@@ -2762,6 +2777,11 @@ user_set_user_expiration_policy (AccountsUser          *auser,
                                  GDBusMethodInvocation *context,
                                  gint64                 user_expiration_time)
 {
+        if (getenv("NIXOS_USERS_PURE")) {
+                throw_error (context, ERROR_NOT_SUPPORTED, "Modifying users not supported without users.mutableUsers");
+                return TRUE;
+        }
+
         User *user = (User *) auser;
         int uid;
         const gchar *action_id;
@@ -2892,6 +2912,11 @@ user_set_home_directory (AccountsUser          *auser,
                          GDBusMethodInvocation *context,
                          const gchar           *home_dir)
 {
+        if (getenv("NIXOS_USERS_PURE")) {
+                throw_error (context, ERROR_NOT_SUPPORTED, "Modifying users not supported without users.mutableUsers");
+                return TRUE;
+        }
+
         User *user = (User *) auser;
 
         if (user_get_uses_homed (user)) {
@@ -2986,6 +3011,11 @@ user_set_shell (AccountsUser          *auser,
                 GDBusMethodInvocation *context,
                 const gchar           *shell)
 {
+        if (getenv("NIXOS_USERS_PURE")) {
+                throw_error (context, ERROR_NOT_SUPPORTED, "Modifying users not supported without users.mutableUsers");
+                return TRUE;
+        }
+
         User *user = (User *) auser;
 
         daemon_local_check_auth (user->daemon,
@@ -3593,6 +3623,11 @@ user_set_locked (AccountsUser          *auser,
                  GDBusMethodInvocation *context,
                  gboolean               locked)
 {
+        if (getenv("NIXOS_USERS_PURE")) {
+                throw_error (context, ERROR_NOT_SUPPORTED, "Modifying users not supported without users.mutableUsers");
+                return TRUE;
+        }
+
         User *user = (User *) auser;
 
         daemon_local_check_auth (user->daemon,
@@ -3789,6 +3824,11 @@ user_set_account_type (AccountsUser          *auser,
                        GDBusMethodInvocation *context,
                        gint                   account_type)
 {
+        if (getenv("NIXOS_USERS_PURE")) {
+                throw_error (context, ERROR_NOT_SUPPORTED, "Modifying users not supported without users.mutableUsers");
+                return TRUE;
+        }
+
         User *user = (User *) auser;
 
         if (account_type < 0 || account_type > ACCOUNT_TYPE_LAST) {
@@ -3929,6 +3969,11 @@ user_set_password_mode (AccountsUser          *auser,
                         GDBusMethodInvocation *context,
                         gint                   mode)
 {
+        if (getenv("NIXOS_USERS_PURE")) {
+                throw_error (context, ERROR_NOT_SUPPORTED, "Modifying users not supported without users.mutableUsers");
+                return TRUE;
+        }
+
         User *user = (User *) auser;
         const gchar *action_id;
         gint uid;
@@ -4027,6 +4072,11 @@ user_set_password (AccountsUser          *auser,
                    const gchar           *password,
                    const gchar           *hint)
 {
+        if (getenv("NIXOS_USERS_PURE")) {
+                throw_error (context, ERROR_NOT_SUPPORTED, "Modifying users not supported without users.mutableUsers");
+                return TRUE;
+        }
+
         User *user = (User *) auser;
         gchar **data;
         const gchar *action_id;
@@ -4165,6 +4215,11 @@ user_set_automatic_login (AccountsUser          *auser,
                           GDBusMethodInvocation *context,
                           gboolean               enabled)
 {
+        if (getenv("NIXOS_USERS_PURE")) {
+                throw_error (context, ERROR_NOT_SUPPORTED, "Modifying users not supported without users.mutableUsers");
+                return TRUE;
+        }
+
         User *user = (User *) auser;
 
         if (user_get_uses_homed (user)) {
