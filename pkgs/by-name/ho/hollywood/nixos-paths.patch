diff --git a/bin/hollywood b/bin/hollywood
index 8e5cc34..7dae73b 100755
--- a/bin/hollywood
+++ b/bin/hollywood
@@ -89,7 +89,7 @@ if [ -z "$TMUX" ]; then
 	else
 		tmux_launcher=tmux
 	fi
-	$tmux_launcher new-session -d -s $PKG "bash"
+	$tmux_launcher new-session -d -s $PKG "/usr/bin/env bash"
 	$tmux_launcher send-keys -t $PKG "$0 -s $SPLITS -d $DELAY"
 	$tmux_launcher send-keys -t $PKG Enter
 	exec $tmux_launcher attach-session -t $PKG
diff --git a/lib/hollywood/bat b/lib/hollywood/bat
index cc87965..f129455 100755
--- a/lib/hollywood/bat
+++ b/lib/hollywood/bat
@@ -18,7 +18,7 @@ command -v batcat >/dev/null 2>&1 || exit 1
 
 trap "pkill -9 -f lib/hollywood/ >/dev/null 2>&1; exit" INT
 while true; do
-	f=$(find /usr -name "*.py" -o -name "*.js" -o -name "*.c" -o -name "*.h" -o -name "*.sh" -o -name "*.pl" -o -name "*.rb" 2>/dev/null | sort -R | head -n1)
+	f=$(find /usr /run/current-system/sw -name "*.py" -o -name "*.js" -o -name "*.c" -o -name "*.h" -o -name "*.sh" -o -name "*.pl" -o -name "*.rb" 2>/dev/null | sort -R | head -n1)
 	[ -z "$f" ] && exit 1
 	clear
 	batcat --color=always --style=full --paging=never "$f" 2>/dev/null
diff --git a/lib/hollywood/code b/lib/hollywood/code
index f14c9d5..aa34717 100755
--- a/lib/hollywood/code
+++ b/lib/hollywood/code
@@ -21,7 +21,7 @@ command -v pygmentize >/dev/null 2>&1 && viewer="pygmentize" || viewer="cat"
 
 trap "pkill -9 -f lib/hollywood/ >/dev/null 2>&1; exit" INT
 while true; do
-	FILES=$(find /usr -readable -size +0 -type f \( -name \*.java -o -name \*.c -o -name \*.cpp -o -name \*.py \) 2>/dev/null | sort -R)
+	FILES=$(find /usr /run/current-system/sw -readable -size +0 -type f \( -name \*.java -o -name \*.c -o -name \*.cpp -o -name \*.py \) 2>/dev/null | sort -R)
 	for f in $FILES; do
 		$viewer "$f" 2>/dev/null || true
 		sleep 2
diff --git a/lib/hollywood/hexdump b/lib/hollywood/hexdump
index 954cc88..e812e6d 100755
--- a/lib/hollywood/hexdump
+++ b/lib/hollywood/hexdump
@@ -19,8 +19,8 @@ command -v ccze >/dev/null 2>&1 || exit 1
 
 trap "pkill -9 -f lib/hollywood/ >/dev/null 2>&1; exit" INT
 while true; do
-	for f in $(ls /usr/bin/ | sort -R); do
-		head -c 4096 "/usr/bin/$f" | hexdump -C | ccze -A -c default=green -c dir="bold green"
+	for f in $(find /usr/bin/ /run/current-system/sw/bin/ | sort -R); do
+		head -c 4096 "$f" | hexdump -C | ccze -A -c default=green -c dir="bold green"
 		sleep 0.7
 	done
 done
diff --git a/lib/hollywood/jp2a b/lib/hollywood/jp2a
index 27dc4f4..ef1274c 100755
--- a/lib/hollywood/jp2a
+++ b/lib/hollywood/jp2a
@@ -22,7 +22,7 @@ command -v jp2a >/dev/null 2>&1 || exit 1
 
 trap "pkill -9 -f lib/hollywood/ >/dev/null 2>&1; exit" INT
 while true; do
