+fn nix_markers_never_select_the_aur_update_source() {
+    for (marker, expected) in [
+        ("manager = \"Nix\"\npackage = \"strata\"", UpdateMethod::Nix),
+        (
+            "manager = \"pacman\"\npackage = \"strata-bin\"",
+            UpdateMethod::Aur,
+        ),
+        ("manager = \"apt\"", UpdateMethod::Aur),
+        ("", UpdateMethod::Aur),
+    ] {
+        let managed = toml::from_str(marker).expect("managed install marker");
+        let source = crate::services::InstallSource::Managed(managed);
+        assert_eq!(update_method_from_marker(&source), Some(expected));
+        assert!(expected.is_package_managed());
+    }
+    assert_eq!(
+        update_method_from_marker(&crate::services::InstallSource::SelfManaged),
+        None
+    );
+}
