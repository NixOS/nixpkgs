 pub(crate) fn resolve(name: &str) -> Result<PathBuf, String> {
-    let search: Vec<&Path> = SEARCH_ROOTS.iter().copied().map(Path::new).collect();
+    let mut search_roots: Vec<PathBuf> = SEARCH_ROOTS.iter().copied().map(PathBuf::from).collect();
