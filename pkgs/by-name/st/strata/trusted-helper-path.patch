+#[test]
+fn compiled_paths_ignore_empty_and_relative_components() {
+    let root = scratch();
+    let bundled = root.path().join("store/bin");
+    write_helper(&bundled, "bwrap");
+    let configured = format!("::relative/bin:{}:", bundled.display());
+    let mut search_roots = Vec::new();
+
+    append_compiled_search_paths(&mut search_roots, Some(&configured));
+
+    assert_eq!(search_roots, vec![bundled.clone()]);
+    let search: Vec<&Path> = search_roots.iter().map(PathBuf::as_path).collect();
+    assert_eq!(
+        resolve_in("bwrap", &search, &[root.path()]).expect("find bundled helper"),
+        bundled.join("bwrap")
+    );
+}
