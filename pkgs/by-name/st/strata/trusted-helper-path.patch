+#[test]
+fn compiled_runtime_helper_path_resolves_bwrap_when_configured() {
+    let Some(configured) = option_env!("STRATA_TRUSTED_COMMAND_PATH") else {
+        return;
+    };
+    let configured_roots: Vec<PathBuf> = std::env::split_paths(configured)
+        .filter(|path| !path.as_os_str().is_empty() && path.is_absolute())
+        .collect();
+    let bundle_root = configured_roots
+        .iter()
+        .find(|path| path.join("bwrap").is_file())
+        .expect("configured runtime paths include bwrap");
+
+    let actual = resolve("bwrap").expect("resolve bwrap from system or compiled runtime paths");
+    let system_roots: Vec<&Path> = SEARCH_ROOTS.iter().map(Path::new).collect();
+    let trust_roots: Vec<&Path> = TRUST_ROOTS.iter().map(Path::new).collect();
+    match resolve_in("bwrap", &system_roots, &trust_roots) {
+        Ok(system_path) => assert_eq!(actual, system_path),
+        Err(_) => assert_eq!(actual, bundle_root.join("bwrap")),
+    }
+}
+
+#[test]
+fn compiled_paths_are_appended_after_system_wrappers() {
+    let root = scratch();
+    let wrapper = root.path().join("run/wrappers/bin");
+    let system = root.path().join("usr/bin");
+    let bundled = root.path().join("store/bin");
+    write_helper(&wrapper, "bwrap");
+    write_helper(&system, "bwrap");
+    write_helper(&bundled, "bwrap");
+
+    let configured = bundled.to_string_lossy().into_owned();
+    let mut search_roots = vec![wrapper.clone(), system];
+    append_compiled_search_paths(&mut search_roots, Some(&configured));
+    let search: Vec<&Path> = search_roots.iter().map(PathBuf::as_path).collect();
+    let resolved = resolve_in("bwrap", &search, &[root.path()]).expect("find wrapper");
+
+    assert_eq!(resolved, wrapper.join("bwrap"));
+}
