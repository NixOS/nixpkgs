+// Build-configured runtime tools follow host roots and still use canonical trust checks.
+fn append_compiled_search_paths(roots: &mut Vec<PathBuf>, configured: Option<&str>) {
+    let Some(configured) = configured else {
+        return;
+    };
+
+    roots.extend(
+        std::env::split_paths(configured)
+            .filter(|root| !root.as_os_str().is_empty() && root.is_absolute()),
+    );
+}
+
 pub(crate) fn command(name: &str) -> Result<Command, String> {
     Ok(Command::new(resolve(name)?))
 }
