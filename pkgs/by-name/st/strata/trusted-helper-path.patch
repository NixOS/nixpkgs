+#[test]
+fn compiled_paths_keep_canonical_trust_and_basename_checks() {
+    let root = scratch();
+    let store = root.path().join("store");
+    let bundled = store.join("bin");
+    let outside = root.path().join("outside/bin");
+    write_helper(&bundled, "bwrap");
+    write_helper(&outside, "escaped");
+    write_helper(&outside, "outsider");
+    std::os::unix::fs::symlink(outside.join("escaped"), bundled.join("escaped"))
+        .expect("helper symlink");
+
+    let configured = format!("{}:{}", bundled.display(), outside.display());
+    let mut search_roots = Vec::new();
+    append_compiled_search_paths(&mut search_roots, Some(&configured));
+    let search: Vec<&Path> = search_roots.iter().map(PathBuf::as_path).collect();
+
+    assert_eq!(
+        resolve_in("bwrap", &search, &[store.as_path()]).expect("trusted bundled helper"),
+        bundled.join("bwrap")
+    );
+    assert!(resolve_in("escaped", &search, &[store.as_path()]).is_err());
+    assert!(resolve_in("outsider", &search, &[store.as_path()]).is_err());
+    for name in ["", ".", "..", "../bwrap", "store/bin/bwrap"] {
+        assert!(
+            resolve_in(name, &search, &[store.as_path()]).is_err(),
+            "{name:?}"
+        );
+    }
