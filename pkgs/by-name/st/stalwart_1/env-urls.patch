+const UPSTREAM_WEBUI_URL: &str =
+    "https://github.com/stalwartlabs/webui/releases/download/v2/webui.zip";
+
+const UPSTREAM_SPAM_FILTER_URL: &str =
+    "https://github.com/stalwartlabs/spam-filter/releases/latest/download/spam-filter-rules.json.gz";
+
+// Nixpkgs: get a URL from an environment variable
+#[cfg(not(stalwart_tests))]
+fn env_url(name: &str) -> Option<String> {
+    std::env::var(name).ok().filter(|url| !url.is_empty())
+}
+
+// Nixpkgs: find the URL of a file in the Nix store
+#[cfg(not(stalwart_tests))]
+fn is_nix_store_url(url: &str, file_name: &str) -> bool {
+    url.starts_with("file://@storeDir@/") && url.ends_with(file_name)
+}
