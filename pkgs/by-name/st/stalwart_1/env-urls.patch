+    // Nixpkgs: replace the upstream or Nix store web interface URL in the
+    // database with the URL in `STALWART_WEBUI_URL`
+    #[cfg(not(any(feature = "dev_mode", stalwart_tests)))]
+    if let Some(nix_url) = env_url("STALWART_WEBUI_URL") {
+        for app in bp.registry.list::<Application>().await? {
