{
  lib,
  stdenv,

  fetchurl,
  makeDesktopItem,

  _7zz,
  autoPatchelfHook,
  copyDesktopItems,
  makeBinaryWrapper,

  libx11,
  pipewire,
  vulkan-loader,

  waylandSupport ? true,
  libxkbcommon,
  wayland,
}:

stdenv.mkDerivation (finalAttrs: {
  pname = "septabee";
  version = "B_T28";

  strictDeps = true;
  __structuredAttrs = true;

  # We're using the offline variant which has the LLVM JIT runtime built-in
  src = fetchurl {
    url = "https://downloads.septabee.com/SEPTABEE_DOWNLOADS/septabee_linux_${finalAttrs.version}_offline.7z";
    hash = "sha256-J6oXQhoQkCs4UbrdWhiRjbO+PCDLdcLKmKVZ7fHuWHk=";
  };

  # This is not versioned, hopefully it doesn't change often
  icon = fetchurl {
    url = "https://septabee.nekoweb.org/important_stuff/icon.png";
    hash = "sha256-snq/nOYU2gPzC4VR558VjeQ8oXmQE82IolNDDixvtTU=";
  };

  nativeBuildInputs = [
    _7zz # automatically extracts the .7z archive
    autoPatchelfHook
    copyDesktopItems
    makeBinaryWrapper
  ];

  buildInputs = [
    stdenv.cc.cc.lib
  ];

  installPhase = ''
    runHook preInstall

    install -D ./* -t "$out/share/septabee/"

    # Note: the icon is 1000x1000, but it's close enough, I guess
    install -D "$icon" $out/share/icons/hicolor/1024x1024/apps/septabee.png

    runHook postInstall
  '';

  desktopItems = [
    (makeDesktopItem {
      # underscore used so that it doesn't conflict with the autogenerated hidden septabee.desktop file
      name = "septabee_";
      desktopName = "s e p t a b e e";
      exec = "septabee";
      icon = "septabee";
      comment = finalAttrs.meta.description;
      categories = [
        "AudioVideo"
        "Audio"
        "Music"
        "Midi"
      ];
      genericName = "Septabee Digital Audio Workstation";
    })
  ];

  septabeeLibrarbyPath = lib.makeLibraryPath (
    [
      stdenv.cc.cc.lib # already patched into the main binary automatically, but the watchdog also needs it
      libx11
      pipewire
      vulkan-loader
    ]
    ++ lib.optionals waylandSupport [
      wayland
      libxkbcommon
    ]
  );

  # SEPTABEE_LIBRARBY acts like LD_LIBRARY_PATH (Is there a difference?)
  # SEPTABEE_LINK_THINGY is used for the dynamic linker of the watchdog executable (generated at runtime, so we can't patch it during packaging)
  # Note: the "LIBRARBY" typo is intentional
  postFixup = ''
    makeWrapper "$out/share/septabee/septabee" "$out/bin/septabee" \
      --set-default SEPTABEE_LINK_THINGY "$(cat "$NIX_CC/nix-support/dynamic-linker")" \
      --prefix SEPTABEE_LIBRARBY : "$septabeeLibrarbyPath"
  '';

  meta = {
    changelog = "https://septabee.miraheze.org/wiki/Changelog";
    description = "Digital Audio Workstation"; # TODO: better description
    downloadPage = "https://septabee.nekoweb.org";
    homepage = "https://septabee.nekoweb.org";
    license = lib.licenses.mkLicense {
      shortName = "septabee";
      free = true; # It's actually false; TODO: change back to false after testing is done
      redistributable = true; # TODO: confirm upstream
    };
    mainProgram = "septabee";
    maintainers = with lib.maintainers; [ tomasajt ];
    platforms = [ "x86_64-linux" ];
    sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
  };
})
