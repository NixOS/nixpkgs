+// Prefer a plain internal require when the launcher passes
+// --expose-internals, falling back to the native addon otherwise.
+// node-addon-require-builtin's binary scan does not recognize
+// toolchain-built Node (e.g. nixpkgs) and fails every profile boot with
+// Unsupported/no-getter. The dsh wrapper always passes the flag.
+// Mirrors vendor/loader's requireInternal. Drop once upstream branches on
+// execArgv here.
+function requireInternalOrAddon(
+  load: (moduleId: string) => unknown,
+  moduleId: string,
+): unknown {
+  if (process.execArgv.includes('--expose-internals')) {
+    try {
+      return load(moduleId)
+    } catch {}
+  }
+  const addon = load('node-addon-require-builtin') as { requireBuiltin(moduleId: string): unknown }
+  return addon.requireBuiltin(moduleId)
+}
