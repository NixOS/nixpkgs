+        // Seed the initial theme from the platform's current values on every OS. On Linux,
+        // Avalonia populates these asynchronously from the desktop portal; in a portal-less
+        // X11 session no ColorValuesChanged event may arrive, so waiting for it prevents the
+        // main window (and initial image load) from ever starting. The listener is already
+        // registered above and reapplies the theme when portal values arrive later.
+        var info = PlatformSettings!.GetColorValues();
+        var isSystemDarkMode = info.ThemeVariant == PlatformThemeVariant.Dark;
+
+        // sync the global so later theme re-applies use the current platform appearance
+        Core.IsSystemDarkMode = isSystemDarkMode;
+
+        try
