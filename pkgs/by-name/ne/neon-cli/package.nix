{
  lib,
  buildNpmPackage,
  fetchurl,
  makeWrapper,
  testers,
  stdenv,
  nodejs,
}:

buildNpmPackage (finalAttrs: {
  __structuredAttrs = true;
  pname = "neon-cli";
  version = "4.12.0";

  # Source: pre-built npm tarball plus a vendored package-lock.json. The
  # tarball has the dist/ pre-built by tsdown (the monorepo's `pnpm build`
  # produces the same output, but building it from source in nix had a
  # pnpm-10 + offline-filter issue that left wsl-utils uninstalled for the
  # cli's `open` import). The lockfile is vendored because nixpkgs builds
  # are sandboxed and cannot run `npm install` to generate one.
  src = stdenv.mkDerivation {
    pname = "neon-cli-src";
    version = finalAttrs.version;
    dontUnpack = true;
    installPhase = ''
      mkdir -p $out
      tar -xzf ${
        fetchurl {
          url = "https://registry.npmjs.org/neon/-/neon-${finalAttrs.version}.tgz";
          hash = "sha256-Jpiv/2VdoQZvwKyVvqj611a7TBX+t/KgYOcAPk4QVoY=";
        }
      } -C $out --strip-components=1
      cp ${./package-lock.json} $out/package-lock.json
    '';
  };

  # The published package.json has unresolvable placeholder devDeps for
  # workspace-internal packages (e.g. @neon-internals/cli-core@0.0.0,
  # @neon-internals/env-core@0.0.6, @neon/e2e-harness@0.0.0). These don't
  # exist on the npm registry but the published package.json still lists
  # them in devDependencies, which makes npm refuse to resolve the dep
  # tree. Strip any devDep whose version starts with "0.0." (the
  # cli's prod deps are unaffected: all 1.x, 2.x, or 3.x).
  # Use `node` instead of `jq` so the postPatch works in the
  # npmDeps derivation too (jq isn't in that derivation's PATH).
  postPatch = ''
    ${lib.getExe nodejs} -e "
      const fs = require('fs');
      const p = JSON.parse(fs.readFileSync('package.json', 'utf8'));
      if (p.devDependencies) {
        for (const [k, v] of Object.entries(p.devDependencies)) {
          if (typeof v === 'string' && /^0\.0\./.test(v)) delete p.devDependencies[k];
        }
      }
      fs.writeFileSync('package.json', JSON.stringify(p, null, 2) + '\n');
    "
  '';

  dontNpmBuild = true;

  npmDepsHash = "sha256-W0nAe25o5EHDXhKUCN8Hjm5E+snLC6Ya4G9zKYm94nM=";

  nativeBuildInputs = [
    makeWrapper
  ];

  # buildNpmPackage installs prod deps to $out/lib/node_modules/neon/.
  # The bin is a shell script generated by buildNpmPackage that execs node;
  # rewrite it to use the Nix-store nodejs and point at the dist entry.
  postInstall = ''
    makeWrapper ${lib.getExe nodejs} $out/lib/node_modules/neon/bin/neon \
      --add-flags "$out/lib/node_modules/neon/dist/cli.js"
  '';

  passthru.tests.smoke = testers.testVersion {
    package = finalAttrs.finalPackage;
  };

  meta = {
    description = "CLI tool for Neon, the cloud backend primitives built around Lakebase Postgres";
    homepage = "https://github.com/neondatabase/neon-pkgs";
    license = lib.licenses.asl20;
    mainProgram = "neon";
    maintainers = [ lib.maintainers.randoneering ];
    platforms = lib.platforms.unix;
  };
})
