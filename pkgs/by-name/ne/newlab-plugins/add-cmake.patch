+cmake_minimum_required(VERSION 3.22)
+project(newlab-plugins VERSION 0.0.0 LANGUAGES C CXX)
+
+# Replacement for the upstream Projucer (.jucer) projects, which can't be
+# used for a sandboxed build. Source lists mirror the Linux export of each
+# .jucer file. VST2/AAX/AU are not built (VST2 SDK is not redistributable).
+
+set(JUCE_SRC_DIR "" CACHE PATH "Path to the JUCE source tree")
+set(NANOVG_SRC_DIR "" CACHE PATH "Path to the nanovg source tree")
+
+add_subdirectory(${JUCE_SRC_DIR} juce EXCLUDE_FROM_ALL)
+
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(FFTW3F REQUIRED IMPORTED_TARGET fftw3f)
+
+set(BL_LIB ${CMAKE_CURRENT_SOURCE_DIR}/src/libs/bluelab-lib)
+
+function(newlab_plugin NAME CODE DESC VERSION CXX_STD)
+  set(PDIR ${CMAKE_CURRENT_SOURCE_DIR}/src/plugins/${NAME})
+  cmake_parse_arguments(ARG "" "" "RESOURCES;SOURCES" ${ARGN})
+
+  juce_add_binary_data(${NAME}_data SOURCES ${ARG_RESOURCES})
+  set_target_properties(${NAME}_data PROPERTIES POSITION_INDEPENDENT_CODE ON)
+
+  juce_add_plugin(${NAME}
+    VERSION ${VERSION}
+    COMPANY_NAME "BlueLab | Audio Plugins"
+    COMPANY_WEBSITE "www.bluelab-plugins.com"
+    COMPANY_EMAIL "contact@bluelab-plugins.com"
+    PLUGIN_MANUFACTURER_CODE Blpl
+    PLUGIN_CODE ${CODE}
+    FORMATS VST3 LV2
+    PRODUCT_NAME ${NAME}
+    DESCRIPTION ${DESC}
+    LV2URI "https://www.bluelab-plugins.com/plugins/${NAME}"
+    IS_SYNTH FALSE
+    NEEDS_MIDI_INPUT FALSE
+    NEEDS_MIDI_OUTPUT FALSE)
+
+  target_sources(${NAME} PRIVATE
+    ${PDIR}/Source/PluginProcessor.cpp
+    ${PDIR}/Source/PluginEditor.cpp
+    ${NANOVG_SRC_DIR}/src/nanovg.c
+    ${ARG_SOURCES})
+
+  target_include_directories(${NAME} PRIVATE
+    ${PDIR}/Source ${BL_LIB} ${NANOVG_SRC_DIR}/src)
+
+  target_compile_definitions(${NAME} PRIVATE
+    AUDIOFFT_FFTW3=1
+    JUCE_DSP_USE_STATIC_FFTW=1
+    JUCE_DISABLE_JUCE_VERSION_PRINTING=1
+    JUCE_STRICT_REFCOUNTEDPOINTER=1
+    JUCE_VST3_CAN_REPLACE_VST2=0
+    JUCE_USE_CURL=0
+    JUCE_WEB_BROWSER=0
+    JUCE_MODAL_LOOPS_PERMITTED=1)
+
+  target_compile_features(${NAME} PRIVATE cxx_std_${CXX_STD})
+
+  target_link_libraries(${NAME}
+    PRIVATE
+      ${NAME}_data
+      PkgConfig::FFTW3F
+      juce::juce_audio_utils
+      juce::juce_audio_formats
+      juce::juce_dsp
+      juce::juce_opengl
+      juce::juce_gui_extra
+    PUBLIC
+      juce::juce_recommended_config_flags
+      juce::juce_recommended_warning_flags)
+
+  # The sources include <JuceHeader.h>, normally generated by Projucer.
+  juce_generate_juce_header(${NAME})
+endfunction()
+
