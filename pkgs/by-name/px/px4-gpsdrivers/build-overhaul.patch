diff --git a/CMakeLists.txt b/CMakeLists.txt
index ec078d6..ff06c08 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,11 +1,87 @@
 cmake_minimum_required(VERSION 3.16)
 
-project(gps-parser-test CXX)
+project(px4-gpsdrivers VERSION 1.0 LANGUAGES CXX)
 
 set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
+set(GPS_SOURCES
+    src/ashtech.cpp
+    src/crc.cpp
+    src/emlid_reach.cpp
+    src/femtomes.cpp
+    src/gps_helper.cpp
+    src/mtk.cpp
+    src/nmea.cpp
+    src/rtcm.cpp
+    src/sbf.cpp
+    src/ubx.cpp
+    src/unicore.cpp
+)
+
+add_library(gps ${GPS_SOURCES})
+
+target_include_directories(gps
+    PUBLIC
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src>
+        $<INSTALL_INTERFACE:include/${PROJECT_NAME}>
+)
+
+# Use our own definitions.h unless a consumer vendoring these sources directly
+# (e.g. PX4-Autopilot) overrides GPS_DEFINITIONS_HEADER itself. PUBLIC: some
+# consumers (e.g. QGroundControl) don't just link this library, they also
+# directly #include <gps_helper.h>/the driver headers in their own
+# translation units, which need the exact same macro value we used to
+# compile this library with.
+target_compile_definitions(gps PUBLIC GPS_DEFINITIONS_HEADER="definitions.h")
+
+set_target_properties(gps PROPERTIES POSITION_INDEPENDENT_CODE ON)
+
+add_library(${PROJECT_NAME}::gps ALIAS gps)
+
+install(TARGETS gps
+    EXPORT ${PROJECT_NAME}Targets
+    ARCHIVE DESTINATION lib
+    LIBRARY DESTINATION lib
+    RUNTIME DESTINATION bin
+)
+
+install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/src/
+    DESTINATION include/${PROJECT_NAME}
+    FILES_MATCHING PATTERN "*.h"
+)
+
+install(EXPORT ${PROJECT_NAME}Targets
+    FILE ${PROJECT_NAME}Targets.cmake
+    NAMESPACE ${PROJECT_NAME}::
+    DESTINATION lib/cmake/${PROJECT_NAME}
+)
+
+include(CMakePackageConfigHelpers)
+
+write_basic_package_version_file(
+    "${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_NAME}ConfigVersion.cmake"
+    VERSION ${PROJECT_VERSION}
+    COMPATIBILITY AnyNewerVersion
+)
+
+configure_package_config_file(
+    "${CMAKE_CURRENT_SOURCE_DIR}/cmake/${PROJECT_NAME}Config.cmake.in"
+    "${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_NAME}Config.cmake"
+    INSTALL_DESTINATION lib/cmake/${PROJECT_NAME}
+)
+
+install(FILES
+    "${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_NAME}Config.cmake"
+    "${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_NAME}ConfigVersion.cmake"
+    DESTINATION lib/cmake/${PROJECT_NAME}
+)
+
 include(CTest)
 enable_testing()
 
+# Upstream's own tests/ subdirectory builds its own test executables
+# (gps-parser-test, gps-time-test, gps-ubx-test) against their own sources
+# and their own tests/definitions.h, entirely independently of the `gps`
+# library target above; nothing further is needed here to make them build.
 add_subdirectory(tests)
