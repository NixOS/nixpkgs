-px4_add_git_submodule(TARGET git_gps_devices PATH "devices")
+# Consumed as a real, independently-built nixpkgs package (pkgs/by-name/px/px4-gpsdrivers)
+# via find_package() instead of vendoring the "devices" submodule, the same
+# way QGroundControl's own copy of this same library is consumed in this
+# nixpkgs tree (see use-px4-gpsdrivers.patch there). NOTE: gps.cpp's own
+# #include "devices/src/ubx.h" is a path relative to this vendored submodule
+# layout and is left untouched - it's irrelevant to configuring or building
+# uorb_headers (this module is never part of that target's dependency
+# graph), and only matters if this drivers__gps module is ever actually
+# compiled standalone.
+find_package(px4-gpsdrivers REQUIRED)
 
