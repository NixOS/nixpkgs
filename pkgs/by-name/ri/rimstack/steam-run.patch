Run SteamCMD and RimWorld in steam-run's FHS environment.
Include SteamCMD's stderr in download errors.

diff --git a/crates/core/src/base/program.rs b/crates/core/src/base/program.rs
--- a/crates/core/src/base/program.rs
+++ b/crates/core/src/base/program.rs
@@ -20,2 +20,13 @@
     command
+}
+
+/// Prefix the command with RIMSTACK_LAUNCHER if set.
+pub fn command_with_launcher(program: impl AsRef<OsStr>) -> Command {
+    if let Some(launcher) = std::env::var_os("RIMSTACK_LAUNCHER") {
+        let mut command = command(launcher);
+        command.arg(program);
+        command
+    } else {
+        command(program)
+    }
 }
