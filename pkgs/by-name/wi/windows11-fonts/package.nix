{
  lib,
  stdenvNoCC,
  curl,
  cacert,
  p7zip,
}:
let
  languages = import ./languages.nix;
  inherit (import ./ranges.nix) wimOffset wimSize ranges;
in
stdenvNoCC.mkDerivation (finalAttrs: {
  pname = "windows11-fonts";
  version = "10.0.26300.9457";

  # Fetches only the parts of the Windows 11 Enterprise evaluation ISO's install.wim that
  # hold the fonts (about 212 MiB of 8.2 GB). ranges.nix is generated by update.py and
  # depends on where 7z reads, so a p7zip bump can require rerunning it.
  src = stdenvNoCC.mkDerivation {
    name = "windows11-fonts-${finalAttrs.version}-src";
    url = "https://software-static.download.prss.microsoft.com/dbazure/26300.9457.260913-1737.26h2_ge_release_svc_refresh_CLIENTENTERPRISEEVAL_OEMRET_x64FRE_en-us.iso";

    nativeBuildInputs = [
      curl
      p7zip
    ];
    impureEnvVars = lib.fetchers.proxyImpureEnvVars;

    buildCommand = ''
      truncate -s ${toString wimSize} install.wim
      ${lib.concatMapStrings (
        r:
        let
          start = lib.elemAt r 0;
          end = lib.elemAt r 1;
        in
        ''
          curl --location --fail --silent --show-error --retry 5 --cacert ${cacert}/etc/ssl/certs/ca-bundle.crt \
            --range ${toString (wimOffset + start)}-${toString (wimOffset + end)} "$url" \
            | dd of=install.wim bs=4M seek=${toString start} oflag=seek_bytes conv=notrunc iflag=fullblock status=none
        ''
      ) ranges}

      mkdir -p $out
      cd $out
      7z x -y "$OLDPWD/install.wim" -r- \
        'Windows/Fonts/*.ttf' 'Windows/Fonts/*.ttc' \
        'Windows/System32/Licenses/neutral/*/*/license.rtf' >/dev/null
    '';

    outputHashMode = "recursive";
    outputHashAlgo = "sha256";
    outputHash = "sha256-2bo1oBY/XKbDEJ6tgO10oNspp1DCYIl8TdK+LJWvjVs=";
  };

  outputs = [ "out" ] ++ lib.attrNames languages;

  strictDeps = true;
  __structuredAttrs = true;

  fonts = lib.mapAttrs (_: lib.concatStringsSep " ") languages;

  installPhase = ''
    runHook preInstall

    for output in "''${!fonts[@]}"; do
      for font in ''${fonts[$output]}; do
        install -Dm644 "Windows/Fonts/$font" -t "''${outputs[$output]}/share/fonts/truetype"
        rm "Windows/Fonts/$font"
      done
      install -Dm644 Windows/System32/Licenses/neutral/*/*/license.rtf \
        -t "''${outputs[$output]}/share/licenses/windows11-fonts"
      mkdir -p $out/share/fonts/truetype
      ln -s "''${outputs[$output]}"/share/fonts/truetype/* $out/share/fonts/truetype/
    done
    install -Dm644 Windows/System32/Licenses/neutral/*/*/license.rtf -t $out/share/licenses/windows11-fonts

    # A font that languages.nix doesn't list would be dropped silently on an update.
    if [[ -n "$(ls Windows/Fonts)" ]]; then
      echo "fonts missing from languages.nix: $(ls Windows/Fonts)" >&2
      exit 1
    fi

    runHook postInstall
  '';

  passthru.updateScript = ./update.py;

  meta = {
    description = "TrueType fonts from Microsoft Windows 11";
    homepage = "https://learn.microsoft.com/typography/fonts/windows_11_font_list";
    # The evaluation terms in the image's license.rtf, installed to share/licenses
    license = lib.licenses.mkLicense {
      shortName = "microsoft-windows";
      fullName = "Microsoft Software License Terms for Windows";
      url = "https://www.microsoft.com/useterms";
      free = false;
    };
    platforms = lib.platforms.all;
    maintainers = [ lib.maintainers.kleinbem ];
  };
})
