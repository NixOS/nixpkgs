--- /dev/null
+++ b/apps/desktop/test/nix-installation.test.ts
@@ -0,0 +1,31 @@
+import { readdir, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { INSTALLATION_MARKER, updatesInApp } from "@mrstreamer/contracts/updates";
+import { installedDistribution } from "../src/main/platform/installation.ts";
+import { distributionLabel } from "../src/renderer/src/features/updates/distribution.ts";
+import { tempDir } from "./support.ts";
+
+// Nixpkgs launches the app with its shared Electron runtime. It must not fall
+// back to direct updates when Electron reports an unpackaged application.
+it.each([false, true])("uses Nix updates with packaged=%s", async (packaged) => {
+  const resources = await tempDir();
+  const distribution = await installedDistribution({
+    resources,
+    platform: "linux",
+    packaged,
+    store: false,
+  });
+  expect(distribution).toBe("nix");
+  expect(updatesInApp(distribution)).toBe(false);
+  expect(distributionLabel(distribution)).toBe("Nix");
+  expect(await readdir(resources)).toEqual([]);
+});
+
+it("does not use a foreign installation marker to select an updater", async () => {
+  const resources = await tempDir();
+  await writeFile(join(resources, INSTALLATION_MARKER), '{"schema":1,"updates":"pacman"}');
+  expect(
+    await installedDistribution({ resources, platform: "linux", packaged: true, store: false }),
+  ).toBe("nix");
+});
