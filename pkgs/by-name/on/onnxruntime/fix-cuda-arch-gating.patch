+      message(STATUS "Excluding SM ${_ort_sm}")
+    endif()
+    unset(_ort_keep_sm${_ort_sm})
+  endforeach()
+  unset(_ort_sm)
+
   message(STATUS "CMAKE_CUDA_ARCHITECTURES: ${CMAKE_CUDA_ARCHITECTURES}")
 endmacro()
