+    #[test]
+    fn archive_extraction_accepts_entries_under_a_leading_current_directory() {
+        use bzip2::write::BzEncoder;
+        use bzip2::Compression;
+
+        // sherpa-onnx release archives name entries `./<directory>/<file>`.
+        let root = tempfile::tempdir().expect("temporary directory");
+        let archive_path = root.path().join("fixture.tar.bz2");
+        let archive_file = fs::File::create(&archive_path).expect("create archive");
+        let encoder = BzEncoder::new(archive_file, Compression::fast());
+        let mut archive = tar::Builder::new(encoder);
+        let mut header = tar::Header::new_gnu();
+        let name = b"./bundle/keep";
+        header.as_gnu_mut().expect("gnu header").name[..name.len()].copy_from_slice(name);
+        header.set_size(4);
+        header.set_mode(0o644);
+        header.set_entry_type(tar::EntryType::Regular);
+        header.set_cksum();
+        archive
+            .append(&header, &b"keep"[..])
+            .expect("append pinned entry");
+        let encoder = archive.into_inner().expect("finish tar");
+        encoder.finish().expect("finish compression");
+
+        let destination = root.path().join("output");
+        super::extract_exact_tar_bz2(
+            &archive_path,
+            &destination,
+            "bundle",
+            &[(
+                "keep",
+                4,
+                "6ca7ea2feefc88ecb5ed6356ed963f47dc9137f82526fdd25d618ea626d0803f",
+            )],
+        )
+        .expect("extract dot-prefixed manifest");
+        assert_eq!(
+            fs::read(destination.join("keep")).expect("pinned output"),
+            b"keep"
+        );
+    }
+
