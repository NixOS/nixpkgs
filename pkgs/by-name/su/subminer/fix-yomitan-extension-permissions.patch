+function makeDirectoriesOwnerWritable(rootPath: string): void {
+  const entries = fs.readdirSync(rootPath, { recursive: true, withFileTypes: true });
+  const directories = entries
+    .filter((entry) => entry.isDirectory())
+    .map((entry) => path.join(entry.parentPath, entry.name));
+
+  for (const directory of [rootPath, ...directories]) {
+    const stat = fs.statSync(directory);
+    fs.chmodSync(directory, stat.mode | 0o200);
+  }
+}
+
+async function makeDirectoriesOwnerWritableAsync(rootPath: string): Promise<void> {
+  const entries = await fs.promises.readdir(rootPath, { recursive: true, withFileTypes: true });
+  const directories = entries
+    .filter((entry) => entry.isDirectory())
+    .map((entry) => path.join(entry.parentPath, entry.name));
+
+  await Promise.all(
+    [rootPath, ...directories].map(async (directory) => {
+      const stat = await fs.promises.stat(directory);
+      await fs.promises.chmod(directory, stat.mode | 0o200);
+    }),
+  );
+}
