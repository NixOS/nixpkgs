{
  lib,
  stdenv,
  fetchurl,
  unzip,
  dpkg,
  runCommand,
  writeScript,
  buildFHSEnv,
  symlinkJoin,
  makeDesktopItem,
  jdk17,
  nss,
  nspr,
  openssl,
}:

let
  version = "1.9";

  # Each release is published under a versioned directory (e.g.
  # .../descargas-software/autofirma19/...); older releases such as 1.8.3
  # live in unversioned URLs that cannot be tracked.
  # https://firmaelectronica.gob.es/Home/Descargas.html
  srcZip = fetchurl {
    url = "https://firmaelectronica.gob.es/content/dam/firmaelectronica/descargas-software/autofirma19/Autofirma_Linux_Debian.zip";
    hash = "sha256-wpwlHy7p8A38h/lYJnfb1DaoNWWYarBBf/Blzq5xZ5g=";
  };

  autofirmaJars = stdenv.mkDerivation {
    pname = "autofirma-jars";
    inherit version;
    src = srcZip;

    nativeBuildInputs = [
      unzip
      dpkg
    ];

    unpackPhase = ''
      unzip $src
      # The archive holds exactly one .deb whose filename casing varies
      # between releases.
      dpkg-deb -x *.deb unpacked
    '';

    installPhase = ''
      mkdir -p $out/lib/Autofirma $out/share/Autofirma
      cp unpacked/usr/lib/Autofirma/autofirma.jar $out/lib/Autofirma/
      cp unpacked/usr/lib/Autofirma/autofirmaConfigurador.jar $out/lib/Autofirma/
      cp unpacked/usr/lib/Autofirma/Autofirma.png $out/lib/Autofirma/
      cp unpacked/usr/share/Autofirma/Autofirma.svg $out/share/Autofirma/
    '';
  };

  # AutoFirma looks for NSS libraries in /usr/lib/firefox* — expose nixpkgs'
  # nss/nspr under that path so the FHS environment finds them without
  # patching the JARs.
  nssFirefoxCompat = runCommand "nss-firefox-compat" { } ''
    mkdir -p $out/lib/firefox
    for f in ${nss}/lib/lib*.so* ${nspr}/lib/lib*.so*; do
      ln -s "$f" $out/lib/firefox/
    done
  '';

  # AutoFirma needs to write autofirma.pfx next to its JARs, which is
  # impossible in the read-only Nix store: copy the JARs to a user-writable
  # directory on first run (re-copied when the package version changes).
  setupScript = ''
    APP_DIR="$HOME/.local/share/autofirma"
    mkdir -p "$APP_DIR"
    MARKER="$APP_DIR/.nix-version"
    if [ ! -f "$MARKER" ] || [ "$(cat "$MARKER")" != "${version}" ]; then
      cp -f ${autofirmaJars}/lib/Autofirma/*.jar "$APP_DIR/"
      cp -f ${autofirmaJars}/lib/Autofirma/*.png "$APP_DIR/"
      echo "${version}" > "$MARKER"
    fi
    cd "$APP_DIR"
  '';

  fhsTargetPkgs = _: [
    jdk17
    nss
    nss.tools
    nspr
    openssl
    nssFirefoxCompat
  ];

  autofirmaBin = buildFHSEnv {
    name = "autofirma";
    targetPkgs = fhsTargetPkgs;
    # An empty /opt prevents bwrap from mounting the host's /opt inside
    # the sandbox.
    extraBuildCommands = "mkdir -p $out/opt";
    runScript = writeScript "autofirma-run" ''
      #!/bin/bash
      ${setupScript}
      exec java -Djdk.tls.maxHandshakeMessageSize=65536 \
           -Dswing.defaultlaf=javax.swing.plaf.metal.MetalLookAndFeel \
           -jar "$APP_DIR/autofirma.jar" "$@"
    '';
  };

  autofirmaSetupBin = buildFHSEnv {
    name = "autofirma-setup";
    targetPkgs = fhsTargetPkgs;
    extraBuildCommands = "mkdir -p $out/opt";
    runScript = writeScript "autofirma-setup-run" ''
      #!/bin/bash
      ${setupScript}
      java -jar "$APP_DIR/autofirmaConfigurador.jar" "$@"

      # On NixOS, Firefox keeps its profiles under ~/.config/mozilla/firefox/
      # instead of the ~/.mozilla/firefox/ path that AutoFirmaConfigurador
      # assumes, so the configurator fails to inject its root certificate and
      # Firefox rejects AutoFirma's secure WebSocket. Work around it by
      # installing the certificate into every detected NSS database.
      #
      # NOTE: with a Firefox Primary Password enabled, this will prompt for it
      # in order to write to the NSS database.
      #
      # The root certificate generated by the configurator has been named
      # AutoFirma_ROOT.cer (up to 1.8.x) and autofirma_ROOT.cer (1.9.x).
      CERT_FILE="$APP_DIR/autofirma_ROOT.cer"
      if [ ! -f "$CERT_FILE" ]; then
        CERT_FILE="$APP_DIR/AutoFirma_ROOT.cer"
      fi
      if [ -f "$CERT_FILE" ]; then
        CERT_NAME="SocketAutoFirma"
        PASS_FILE=$(mktemp)
        trap 'rm -f "$PASS_FILE"' EXIT
        printf '\n' > "$PASS_FILE"
        PROMPTED=false

        install_cert() {
          local db_dir="$1"
          # Remove any previous installation, then import the root
          # certificate as a CA with an empty password first.
          certutil -d sql:"$db_dir" -D -n "$CERT_NAME" -f "$PASS_FILE" 2>/dev/null || true
          if certutil -d sql:"$db_dir" -A -n "$CERT_NAME" -i "$CERT_FILE" -t "C,," -f "$PASS_FILE" 2>/dev/null; then
            echo "[AutoFirma NixOS] Certificate installed in: $db_dir"
            return 0
          fi
          if [ "$PROMPTED" = false ]; then
            read -r -s -p "[AutoFirma NixOS] Firefox primary password: " user_pass
            echo
            printf '%s\n' "$user_pass" > "$PASS_FILE"
            PROMPTED=true
          fi
          certutil -d sql:"$db_dir" -D -n "$CERT_NAME" -f "$PASS_FILE" 2>/dev/null || true
          if certutil -d sql:"$db_dir" -A -n "$CERT_NAME" -i "$CERT_FILE" -t "C,," -f "$PASS_FILE"; then
            echo "[AutoFirma NixOS] Certificate installed in: $db_dir"
            return 0
          fi
          echo "[AutoFirma NixOS] Error: could not install certificate in $db_dir" >&2
          return 1
        }

        for cert_db in $(find \
            "$HOME/.config/mozilla/firefox" \
            "$HOME/.mozilla/firefox" \
            -name "cert9.db" 2>/dev/null); do
          install_cert "$(dirname "$cert_db")"
        done

        if [ -d "$HOME/.pki/nssdb" ]; then
          install_cert "$HOME/.pki/nssdb"
        fi
      fi
    '';
  };

  desktopItem = makeDesktopItem {
    name = "autofirma";
    desktopName = "AutoFirma";
    genericName = "Herramienta de firma electrónica";
    comment = "Cliente de firma electrónica del Gobierno de España";
    exec = "${autofirmaBin}/bin/autofirma %u";
    icon = "${autofirmaJars}/lib/Autofirma/Autofirma.png";
    mimeTypes = [ "x-scheme-handler/afirma" ];
    categories = [ "Office" ];
    startupNotify = true;
    startupWMClass = "autofirma";
    extraConfig = {
      "Name[es_ES]" = "AutoFirma";
    };
  };

  autofirma = symlinkJoin {
    name = "autofirma-${version}";
    paths = [
      autofirmaBin
      autofirmaSetupBin
      desktopItem
    ];

    strictDeps = true;
    __structuredAttrs = true;

    passthru.tests.smoke = runCommand "autofirma-smoke-test" { } ''
      test -x ${autofirma}/bin/autofirma
      test -x ${autofirma}/bin/autofirma-setup
      test -f ${autofirma}/share/applications/autofirma.desktop
      touch $out
    '';

    meta = {
      description = "Spanish government electronic signature application";
      homepage = "https://firmaelectronica.gob.es/Home/Descargas.html";
      license = with lib.licenses; [
        gpl2Plus
        eupl11
      ];
      platforms = lib.platforms.linux;
      sourceProvenance = with lib.sourceTypes; [ binaryBytecode ];
      mainProgram = "autofirma";
      maintainers = with lib.maintainers; [ vendul0g ];
    };
  };
in
autofirma
