diff --git a/config.nims b/config.nims
index 3ee4842..c692663 100644
--- a/config.nims
+++ b/config.nims
@@ -2,6 +2,13 @@
 --define:useStdLib
 --threads:off
 
+# allow linking openssl from a non-standard lib dir when provided; Nix's
+# propagated openssl on macOS, for instance, where the SDK has no libcrypto
+when defined(macosx):
+  let opensslLib = getEnv("OPENSSL_LIB_DIR")
+  if opensslLib.len > 0:
+    switch("passL", "-L" & opensslLib)
+
 # workaround httpbeast file upload bug
 --assertions:off
 
