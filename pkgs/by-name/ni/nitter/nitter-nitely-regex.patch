diff --git a/src/experimental/parser/user.nim b/src/experimental/parser/user.nim
index 866973c..06c7c85 100644
--- a/src/experimental/parser/user.nim
+++ b/src/experimental/parser/user.nim
@@ -1,14 +1,17 @@
-import std/[algorithm, unicode, re, strutils, strformat, options, nre]
+import std/[algorithm, unicode, strutils, strformat, options]
 import jsony
+import regex
 import utils, slices
 import ../types/user as userType
 from ../../types import Result, User, Error
 
 let
-  unRegex = re.re"(^|[^A-z0-9-_./?])@([A-z0-9_]{1,15})"
+  unRegex = re2"(^|[^A-z0-9-_./?])@([A-z0-9_]{1,15})"
   unReplace = "$1<a href=\"/$2\">@$2</a>"
 
-  htRegex = nre.re"""(*U)(^|[^\w-_.?])([#＃$])([\w_]*+)(?!</a>|">|#)"""
+  # nitely regex has no possessive quantifiers; (?![\w_]) anchors the word run
+  # so it cannot shrink on backtrack (same effect as PCRE's [\w_]*+)
+  htRegex = re2"""(^|[^\w.?-])([#＃$])([\w_]*(?![\w_]))(?!</a>|">|#)"""
   htReplace = "$1<a href=\"/search?f=tweets&q=%23$3\">$2$3</a>"
 
