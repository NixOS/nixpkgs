       result = pairs[pairs.high]
-    doAssert result.rev != "", url
+    if result.rev == "":
+      quit("no refs found at " & url)
 
 proc collectMetadata(data: JsonNode) =
   let storePath = data{"path"}.getStr
@@ -153,7 +154,8 @@ proc collectMetadata(data: JsonNode) =
   data{"srcDir"} = %pkg.srcDir
 
 proc prefetchGit(cloneUrl: string; pair: GitPair; subDir = ""): JsonNode =
-  assert pair.rev != ""
+  if pair.rev == "":
+    quit("no revision to fetch for " & cloneUrl)
   var archiveUri = cloneUrl.parseUri
   archiveUri.scheme = "https"
   archiveUri.path.removeSuffix ".git"
@@ -177,7 +179,8 @@ proc prefetchGit(cloneUrl: string; pair: GitPair; subDir = ""): JsonNode =
     if lines.len <= off:
       quit("failed to parse nix-prefetch-url output: " & lines)
     off.inc parseUntil(lines, storePath, {'\n'}, off).succ
-    doAssert off == lines.len, "unrecognized nix-prefetch-url output:\n" & lines
+    if off != lines.len:
+      quit("unrecognized nix-prefetch-url output:\n" & lines)
     result = %*
       {
         "method":  "fetchzip",
@@ -226,10 +229,17 @@ proc selectGitCommit(url: string): GitPair =
   stdout.writeLine "select a tag from ", url, ":"
   for pair in pairs:
     stdout.writeLine "\t", pair.`rev`, "\t", pair.`ref`
-  let choice = stdin.readLine.strip
+  var choice: string
+  try:
+    choice = stdin.readLine.strip
+  except CatchableError:
+    quit("no selection could be read from stdin for " & url)
+  if choice == "":
+    quit("no ref or revision selected for " & url)
   for pair in pairs:
     if choice == pair.`ref` or choice == pair.`rev`:
       return pair
+  quit("no ref or revision matched \"" & choice & "\" for " & url)
 
 proc containsPackageUri(lockAttrs: JsonNode; pkgUrl: string): bool =
   for e in lockAttrs.items:
@@ -238,7 +248,9 @@ proc containsPackageUri(lockAttrs: JsonNode; pkgUrl: string): bool =
 
 proc containsPackage(lockAttrs: JsonNode; pkgName: string): bool =
   for e in lockAttrs.items:
-    for other in e{"packages"}.items:
+    let pkgs = e{"packages"}
+    if pkgs.isNil: continue
+    for other in pkgs.items:
       if other.getStr == pkgName:
         return true
 
@@ -273,6 +285,7 @@ proc getPackageUrl(name: string): tuple[url: Uri, meth: string] =
         let client = newHttpClient()
         var raw = client.getContent(githubPackagesUrl)
         close(client)
+        createDir(registryPath.parentDir)
         writeFile(registryPath, raw)
         globalRegistry = parseJson(raw)
     var
@@ -334,11 +347,14 @@ proc generateLockfile(directoryPath: string): JsonNode =
   return %*{"depends": deps}
 
