From bea6c26304845a8d12cdf14728399c39afa146e5 Mon Sep 17 00:00:00 2001
From: Naomi Roberts <mia@naomieow.xyz>
Date: Thu, 4 Dec 2025 19:59:48 +0000
Subject: [PATCH] Remove Windows-specific dep

Signed-off-by: Naomi Roberts <mia@naomieow.xyz>
---
 electron/package.json       |  3 +--
 electron/src/main/app.js    | 17 +----------------
 electron/webpack.config.cjs |  6 ++----
 pnpm-lock.yaml              | 11 -----------
 4 files changed, 4 insertions(+), 33 deletions(-)

diff --git a/electron/package.json b/electron/package.json
index 609bb41e..cae63530 100644
--- a/electron/package.json
+++ b/electron/package.json
@@ -30,7 +30,6 @@
     "js-yaml": "^5.5.0"
   },
   "dependencies": {
-    "@paymoapp/electron-shutdown-handler": "^1.2.0",
     "@xhayper/discord-rpc": "1.3.4",
     "utp-native": "^2.5.3"
   },
@@ -44,4 +43,4 @@
       "node"
     ]
   }
-}
\ No newline at end of file
+}
diff --git a/electron/src/main/app.js b/electron/src/main/app.js
index 9db3ae20..267b491c 100644
--- a/electron/src/main/app.js
+++ b/electron/src/main/app.js
@@ -4,7 +4,6 @@ import process from 'node:process'
 import { youtubeServer } from './youtube.js'
 
 import { BrowserWindow, MessageChannelMain, Notification, Tray, Menu, nativeImage, app, dialog, ipcMain, powerMonitor, shell, session } from 'electron'
-import electronShutdownHandler from '@paymoapp/electron-shutdown-handler'
 
 import { development, windowBounds, timeouts, getImage, getWindowState, saveWindowState, getDefaultBounds, toXmlString } from './util.js'
 import Debug from './debugger.js'
@@ -178,21 +177,7 @@ export default class App {
       notification.show()
     })
 
-    if (process.platform === 'win32') {
-      app.setAppUserModelId('com.github.rockinchaos.shiru')
-      // this message usually fires in dev-mode from the parent process
-      process.on('message', data => {
-        if (data === 'graceful-exit') this.destroy()
-      })
-      electronShutdownHandler.setWindowHandle(this.mainWindow.getNativeWindowHandle())
-      electronShutdownHandler.blockShutdown('Saving torrent data...')
-      electronShutdownHandler.on('shutdown', async () => {
-        await this.destroy()
-        electronShutdownHandler.releaseShutdown()
-      })
-    } else {
-      process.on('SIGTERM', () => this.destroy())
-    }
+    process.on('SIGTERM', () => this.destroy())
 
     this.mainWindow.loadURL(development ? 'http://localhost:5000/app.html' : `file://${join(__dirname, '/app.html')}`)
 
diff --git a/electron/webpack.config.cjs b/electron/webpack.config.cjs
index 79fb7d8f..755e2a57 100644
--- a/electron/webpack.config.cjs
+++ b/electron/webpack.config.cjs
@@ -111,9 +111,7 @@ module.exports = [
       path: join(__dirname, 'build'),
       filename: 'main.js'
     },
-    externals: {
-      '@paymoapp/electron-shutdown-handler': 'require("@paymoapp/electron-shutdown-handler")'
-    },
+    externals: {},
     resolve: {
       aliasFields: [],
       alias: {
@@ -123,4 +121,4 @@ module.exports = [
     mode,
     target: 'electron45.0-main'
   }
-]
\ No newline at end of file
+]
diff --git a/pnpm-lock.yaml b/pnpm-lock.yaml
index 37e9c967..ef1f6240 100644
--- a/pnpm-lock.yaml
+++ b/pnpm-lock.yaml
@@ -418,9 +418,6 @@ importers:
 
   electron:
     dependencies:
-      '@paymoapp/electron-shutdown-handler':
-        specifier: ^1.2.0
-        version: 1.2.0
       '@xhayper/discord-rpc':
         specifier: 1.3.4
         version: 1.3.4(patch_hash=bf4d75980edcb02a75b239adcb24ef2d15e46bc139a2869fe0c66801237a4370)(bufferutil@4.1.0)(utf-8-validate@6.0.6)
@@ -1097,10 +1094,6 @@ packages:
   '@obsidize/rx-console@6.2.1':
     resolution: {integrity: sha512-UXa8S8pNoDmyZ9x2UjU/GJmqEhJ/LGmAI/2V/3njNBQRIxmDFCIPJIavsRv6x+JueNZ4mU1wHE0gU7paT5iWrA==}
 
-  '@paymoapp/electron-shutdown-handler@1.2.0':
-    resolution: {integrity: sha512-5mQE21J880AI9KWvAAzstaIEPjKBn8iQvM1Hk4H+jwiV5iVHL8N6M7EZXXnOplOnJPul64xY3/TDNp8IfYAkOw==}
-    engines: {node: '>=20.11'}
-
   '@peculiar/asn1-cms@2.7.0':
     resolution: {integrity: sha512-hew63shtzzvBcSHbhm+cyAmKe6AIfinT9hzEqSPjDC6opTTMKmTkQ0gHuN2KsWlvqiKw1S/fS94fhag/FJkioQ==}
 
@@ -5980,10 +5973,6 @@ snapshots:
 
   '@obsidize/rx-console@6.2.1': {}
 
-  '@paymoapp/electron-shutdown-handler@1.2.0':
-    dependencies:
-      node-gyp-build: 4.8.4
-
   '@peculiar/asn1-cms@2.7.0':
     dependencies:
       '@peculiar/asn1-schema': 2.7.0
-- 
