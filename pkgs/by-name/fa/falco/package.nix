{
  lib,
  stdenv,
  fetchFromGitHub,
  fetchurl,
  cmake,
  pkg-config,
  perl,
  falco-plugin-container,
  clang,
  bpftools,
  libbpf,
  elfutils,
  zlib,
  openssl,
  curl,
  onetbb,
  yaml-cpp,
  nlohmann_json,
  jsoncpp,
  re2,
  cxxopts,
  uthash,
  valijson,
  httplib,
  versionCheckHook,
  nix-update-script,
}:

let
  # Compare with https://github.com/falcosecurity/falco/blob/0.45.1/cmake/modules/falcosecurity-libs.cmake
  libs = fetchFromGitHub {
    owner = "falcosecurity";
    repo = "libs";
    tag = "0.26.1";
    hash = "sha256-Ki+OcxdXytmPSgj2q/FFPb269ZOti1Dzcln3wmbT/SQ=";
  };

  # Compare with https://github.com/falcosecurity/libs/blob/0.26.1/cmake/modules/bs_threadpool.cmake
  bsThreadPool = fetchFromGitHub {
    owner = "bshoshany";
    repo = "thread-pool";
    tag = "v4.1.0";
    hash = "sha256-zhRFEmPYNFLqQCfvdAaG5VBNle9Qm8FepIIIrT9sh88=";
  };

  # Compare with https://github.com/falcosecurity/falco/blob/0.45.1/cmake/modules/rules.cmake
  rules = fetchurl {
    url = "https://download.falco.org/rules/falco-rules-5.2.0.tar.gz";
    hash = "sha256-eiXX8eir+97JAKo7SPzIprAi6G84SXI/f+PIKqVRZBU=";
  };
in
stdenv.mkDerivation (finalAttrs: {
  pname = "falco";
  version = "0.45.1";

  strictDeps = true;
  __structuredAttrs = true;

  src = fetchFromGitHub {
    owner = "falcosecurity";
    repo = "falco";
    tag = finalAttrs.version;
    hash = "sha256-zLuNFJc82bfu8um+hWVss+rp46RgMeig52ykbNz4UXM=";
  };

  postPatch = ''
    # Supplying the sources makes cmake report both as 0.0.0-local
    substituteInPlace cmake/modules/falcosecurity-libs.cmake \
      --replace-fail 'set(FALCOSECURITY_LIBS_VERSION "0.0.0-local")' 'set(FALCOSECURITY_LIBS_VERSION "0.26.1")'
    substituteInPlace cmake/modules/driver.cmake \
      --replace-fail 'set(DRIVER_VERSION "0.0.0-local")' 'set(DRIVER_VERSION "11.0.1+driver")'

    # The build downloads the plugin; it is installed from falco-plugin-container below.
    perl -0pi -e 's/\tset\(CONTAINER_VERSION.*?COMPONENT "\$\{FALCO_COMPONENT_NAME\}"\n\t\)\n(?=endif\(\))//s' CMakeLists.txt
    if grep -q container_plugin CMakeLists.txt; then
      echo "container plugin block not removed, update postPatch"
      exit 1
    fi
  '';

  nativeBuildInputs = [
    cmake
    pkg-config
    perl
    # modern eBPF probe: compiled with clang, skeleton generated by bpftool
    clang
    bpftools
  ];

  buildInputs = [
    libbpf
    elfutils
    zlib
    openssl
    curl
    onetbb
    yaml-cpp
    nlohmann_json
    jsoncpp
    re2
    cxxopts
    uthash
    valijson
    httplib
  ];

  # clang's bpf target rejects these
  hardeningDisable = [
    "stackprotector"
    "zerocallusedregs"
  ];

  preConfigure = ''
    # the libs build writes into its source tree
    cp -r ${libs} libs-src
    chmod -R +w libs-src

    mkdir falco-rules
    tar -xzf ${rules} -C falco-rules

    cmakeFlagsArray+=(
      "-DFALCOSECURITY_LIBS_SOURCE_DIR=$(pwd)/libs-src"
      "-DDRIVER_SOURCE_DIR=$(pwd)/libs-src/driver"
      "-DFALCOSECURITY_RULES_FALCO_PATH=$(pwd)/falco-rules/falco_rules.yaml"
    )
  '';

  cmakeFlags = [
    (lib.cmakeBool "USE_BUNDLED_DEPS" false)
    # falco turns these on by default even without USE_BUNDLED_DEPS
    (lib.cmakeBool "USE_BUNDLED_TBB" false)
    (lib.cmakeBool "USE_BUNDLED_JSONCPP" false)
    (lib.cmakeBool "USE_BUNDLED_VALIJSON" false)
    (lib.cmakeBool "USE_BUNDLED_RE2" false)
    (lib.cmakeBool "USE_BUNDLED_UTHASH" false)
    (lib.cmakeBool "USE_DYNAMIC_LIBELF" true)
    # the kernel module and legacy probe are separate; the modern eBPF probe is built in
    (lib.cmakeBool "BUILD_DRIVER" false)
    (lib.cmakeBool "BUILD_BPF" false)
    (lib.cmakeBool "BUILD_FALCO_MODERN_BPF" true)
    (lib.cmakeBool "ADD_FALCOCTL_DEPENDENCY" false)
    (lib.cmakeBool "BUILD_WARNINGS_AS_ERRORS" false)
    (lib.cmakeFeature "FALCO_VERSION" finalAttrs.version)
    (lib.cmakeFeature "VALIJSON_INCLUDE" "${valijson}/include")
    (lib.cmakeFeature "BS_THREADPOOL_INCLUDE" "${bsThreadPool}/include")
  ];

  postInstall = ''
    # the build also installs libscap, libsinsp, libpman and the driver sources
    rm -r $out/include $out/lib $out/src

    # The stock rules need the plugin. Upstream enables it from /etc/falco/config.d, which
    # is not where this package's configuration lives.
    install -Dm755 ${falco-plugin-container}/lib/libcontainer.so -t $out/share/falco/plugins
    substituteInPlace $out/etc/falco/falco.yaml \
      --replace-fail 'load_plugins: []' 'load_plugins: [container]'
  '';

  doInstallCheck = true;
  nativeInstallCheckInputs = [ versionCheckHook ];

  postInstallCheck = ''
    $out/bin/falco -c $out/etc/falco/falco.yaml --validate $out/etc/falco/falco_rules.yaml
  '';

  passthru.updateScript = nix-update-script { };

  meta = {
    description = "Cloud native runtime security: detects unexpected behavior from kernel events";
    longDescription = ''
      Falco watches system calls through the built-in modern eBPF probe and
      evaluates them against a rule set. This package ships the rules from
      falcosecurity/rules, but not the container plugin (prebuilt binary
      upstream) and not the kernel module or legacy eBPF probe.
    '';
    homepage = "https://falco.org";
    changelog = "https://github.com/falcosecurity/falco/blob/${finalAttrs.version}/CHANGELOG.md";
    license = lib.licenses.asl20;
    mainProgram = "falco";
    platforms = [
      "x86_64-linux"
      "aarch64-linux"
    ];
    maintainers = with lib.maintainers; [ happysalada ];
  };
})
