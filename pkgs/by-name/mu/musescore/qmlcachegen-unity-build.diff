diff --git a/src/framework/cmake/MuseCreateModule.cmake b/src/framework/cmake/MuseCreateModule.cmake
index 6e9a3e7d92..19dcbd3019 100644
--- a/src/framework/cmake/MuseCreateModule.cmake
+++ b/src/framework/cmake/MuseCreateModule.cmake
@@ -210,4 +210,45 @@ function(fixup_qml_module_dependencies target_name)
         # don't seem to have this problem.
         add_dependencies(${target_name}_qmltyperegistration ${target_name})
     endif()
+
+    # Qt generates one C++ file per QML file with qmlcachegen and adds them to
+    # the QML module target without excluding them from unity builds - unlike
+    # the files generated by qmltc, which it does exclude. Since Qt 6.12 those
+    # files contain an expectedLookupSignatures() function which refers to the
+    # types of the QQmlPrivate::AOTLookupValidation namespace unqualified, so a
+    # file scope "using namespace" of one of our own sources that ends up in
+    # the same unity translation unit can make these names ambiguous, and the
+    # build fails with e.g:
+    #
+    #   .rcc/qmlcache/muse_extensions_qml_ExtensionErrorMessage_qml.cpp:27:19:
+    #   error: reference to 'Type' is ambiguous
+    #      27 |         { Lookup{ Type{ u"Muse.UiComponents"_s, ...
+    #         |                   ^~~~
+    #     there are 2 candidates
+    #       candidate 1: 'enum class muse::extensions::Type'
+    #       candidate 2: 'struct QQmlPrivate::AOTLookupValidation::Type'
+    #
+    # Arguably a Qt bug - it should exclude these files from unity builds just
+    # like it does the ones generated by qmltc. We could find no report for it
+    # at https://bugreports.qt.io, and as of Qt 6.12.0 neither the 6.12 nor the
+    # dev branch of qtdeclarative excludes them, so it still needs reporting.
+    #
+    # Compile the files generated by qmlcachegen separately so that they are
+    # not affected by what our own sources pull into scope.
+    get_target_property(all_sources ${target_name} SOURCES)
+    if (all_sources)
+        set(qmlcache_sources "")
+        foreach (source IN LISTS all_sources)
+            if (source MATCHES "/\\.rcc/qmlcache/")
+                list(APPEND qmlcache_sources ${source})
+            endif()
+        endforeach()
+        if (qmlcache_sources)
+            set_source_files_properties(${qmlcache_sources}
+                TARGET_DIRECTORY ${target_name}
+                PROPERTIES
+                SKIP_UNITY_BUILD_INCLUSION ON
+            )
+        endif()
+    endif()
 endfunction()
