+++ b/funkwhale_api/common/storage.py
@@ -1,5 +1,6 @@
 import functools
 import os
+import re
 import shutil
 
 import slugify
@@ -9,8 +10,18 @@ from django.core.files.storage import FileSystemStorage
 def asciionly(name):
     """
     Convert unicode characters in name to ASCII characters.
+    Using separator="" drops non-whitelisted characters without turning them into
+    hyphens, while re.sub converts whitespace to hyphens.
     """
-    return slugify.slugify(name, ok=slugify.SLUG_OK + ".", only_ascii=True)
+    return re.sub(
+        r"[\s]+",
+        "-",
+        slugify.slugify(
+            name,
+            regex_pattern=r"[^\s\-_~\.a-zA-Z0-9]+",
+            separator="",
+        ),
+    )
 
 
 class ASCIIFileSystemStorage(FileSystemStorage):
