+def test_track_filter_artist_no_duplicates(factories, mocker, anonymous_user):
+    artist = factories["music.Artist"]()
+    credit1 = factories["music.ArtistCredit"](artist=artist)
+    credit2 = factories["music.ArtistCredit"]()
+    album = factories["music.Album"]()
+    album.artist_credit.set([credit1])
+
+    # track with artist credited on both track and album
+    track1 = factories["music.Track"](album=album)
+    track1.artist_credit.set([credit1, credit2])
+
+    # standalone track without album
+    track2 = factories["music.Track"](album=None)
+    track2.artist_credit.set([credit1])
+
+    # track with artist only on album
+    track3 = factories["music.Track"](album=album)
+    track3.artist_credit.set([credit2])
+
+    # unrelated track
+    factories["music.Track"]()
+
+    qs = models.Track.objects.all().order_by("id")
+    filterset = filters.TrackFilter(
+        {"artist": artist.pk},
+        request=mocker.Mock(user=anonymous_user),
+        queryset=qs,
+    )
+
+    result = list(filterset.qs)
+    assert len(result) == 3
+    assert set(result) == {track1, track2, track3}
+
+
+def test_album_filter_artist_no_duplicates(factories, mocker, anonymous_user):
+    artist = factories["music.Artist"]()
+    credit1 = factories["music.ArtistCredit"](artist=artist)
+    credit2 = factories["music.ArtistCredit"]()
+
+    album1 = factories["music.Album"]()
+    album1.artist_credit.set([credit1, credit2])
+
+    factories["music.Album"]()
+
+    qs = models.Album.objects.all().order_by("id")
+    filterset = filters.AlbumFilter(
+        {"artist": artist.pk},
+        request=mocker.Mock(user=anonymous_user),
+        queryset=qs,
+    )
+
+    result = list(filterset.qs)
+    assert result == [album1]
+
+
