+def test_get_album_list2_alphabetical_by_artist_no_duplicates(
+    db, logged_in_api_client, factories
+):
+    url = reverse("api:subsonic:subsonic-get_album_list2")
+    artist1 = factories["music.Artist"](name="Avicii")
+    artist2 = factories["music.Artist"](name="Rita Ora")
+    credit1 = factories["music.ArtistCredit"](artist=artist1)
+    credit2 = factories["music.ArtistCredit"](artist=artist2)
+    album = factories["music.Album"](title="AVICI (01)", playable=True)
+    album.artist_credit.set([credit1, credit2])
+
+    response = logged_in_api_client.get(
+        url, {"f": "json", "type": "alphabeticalByArtist"}
+    )
+
+    assert response.status_code == 200
+    albums = response.data["albumList2"]["album"]
+    assert len(albums) == 1
+    assert albums[0]["id"] == album.id
+
+
+def test_get_album_list2_alphabetical_by_name(db, logged_in_api_client, factories):
+    url = reverse("api:subsonic:subsonic-get_album_list2")
+    artist1 = factories["music.Artist"](name="Avicii")
+    artist2 = factories["music.Artist"](name="Rita Ora")
+    credit1 = factories["music.ArtistCredit"](artist=artist1)
+    credit2 = factories["music.ArtistCredit"](artist=artist2)
+    album_b = factories["music.Album"](title="B Album", playable=True)
+    album_b.artist_credit.set([credit1, credit2])
+    album_a = factories["music.Album"](title="A Album", playable=True)
+    album_a.artist_credit.set([credit1])
+
+    response = logged_in_api_client.get(
+        url, {"f": "json", "type": "alphabeticalByName"}
+    )
+
+    assert response.status_code == 200
+    albums = response.data["albumList2"]["album"]
+    assert len(albums) == 2
+    assert [a["id"] for a in albums] == [album_a.id, album_b.id]
+
+
