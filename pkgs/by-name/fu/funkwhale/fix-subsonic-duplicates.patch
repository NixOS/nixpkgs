+def test_get_songs_by_genre_no_duplicates(db, logged_in_api_client, factories):
+    url = reverse("api:subsonic:subsonic-get_songs_by_genre")
+    artist1 = factories["music.Artist"](set_tags=["Rock"])
+    artist2 = factories["music.Artist"](set_tags=["Rock"])
+    credit1 = factories["music.ArtistCredit"](artist=artist1)
+    credit2 = factories["music.ArtistCredit"](artist=artist2)
+    album = factories["music.Album"](set_tags=["Rock"])
+    album.artist_credit.set([credit1, credit2])
+
+    track = factories["music.Track"](album=album, playable=True, set_tags=["Rock"])
+    track.artist_credit.set([credit1, credit2])
+
+    response = logged_in_api_client.get(url, {"f": "json", "genre": "rock"})
+
+    assert response.status_code == 200
+    songs = response.data["songsByGenre"]["song"]
+    assert len(songs) == 1
+    assert songs[0]["id"] == track.id
+
