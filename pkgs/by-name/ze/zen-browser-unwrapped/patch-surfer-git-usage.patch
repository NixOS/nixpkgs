+// did, an already applied patch is reverted first so it can be re-applied.
+// GNU patch exits non-zero when it fails to reverse the patch, which means it
+// was not applied yet.
 export async function apply(path: string): Promise<void> {
   try {
-    await execa('git', ['apply', '-R', ...PATCH_ARGS, path], {
-      cwd: ENGINE_DIR,
-    })
+    await execa(
+      'patch',
+      [...PATCH_ARGS, '--quiet', '--reverse', '-i', path],
+      { cwd: ENGINE_DIR }
+    )
   } catch {
-    // If the patch has already been applied, we want to revert it. Because
-    // there is no good way to check this we are just going to catch and
-    // discard the error
+    // The patch has not been applied yet, so there is nothing to revert
     undefined
   }
 
   const { stdout, exitCode } = await execa(
-    'git',
-    ['apply', ...PATCH_ARGS, path],
-    { cwd: ENGINE_DIR }
+    'patch',
+    [...PATCH_ARGS, '--forward', '-i', path],
+    { cwd: ENGINE_DIR, all: true }
