+
+  const tasks = [
+    ...(nixAppliesPatches ? [] : [await importInternalPatch()]),
+    ...(canDoBrandingPatch ? [importMelonPatches()] : []),
+    ...(nixAppliesPatches ? [] : [await importFolders()]),
+    ...(nixAppliesPatches ? [] : [await importGitPatch()]),
     await importCertPatches(),
-  ].filter((task) => task !== undefined) as Task[]
+  ]
