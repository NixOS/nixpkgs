diff --git a/src/nvbroadcast/core/dependency_installer.py b/src/nvbroadcast/core/dependency_installer.py
--- a/src/nvbroadcast/core/dependency_installer.py
+++ b/src/nvbroadcast/core/dependency_installer.py
@@ -39,3 +39,36 @@ from nvbroadcast.core.platform import (
+RUNTIME_SITE = Path(
+    os.environ.get(
+        "NVBROADCAST_RUNTIME_SITE",
+        Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share"))
+        / "nvbroadcast"
+        / "runtime"
+        / "@version@"
+        / f"python{sys.version_info.major}.{sys.version_info.minor}",
+    )
+)
+
+
+def _activate_runtime_site() -> Path:
+    if not RUNTIME_SITE.is_dir():
+        return RUNTIME_SITE
+    runtime_site = str(RUNTIME_SITE)
+    if runtime_site not in sys.path:
+        sys.path.insert(0, runtime_site)
+    pythonpath = os.environ.get("PYTHONPATH", "")
+    paths = [path for path in pythonpath.split(os.pathsep) if path]
+    if runtime_site not in paths:
+        os.environ["PYTHONPATH"] = os.pathsep.join([runtime_site, *paths])
+    return RUNTIME_SITE
+
+
+def _ensure_runtime_site() -> Path:
+    RUNTIME_SITE.mkdir(mode=0o700, parents=True, exist_ok=True)
+    return _activate_runtime_site()
+
+
+_activate_runtime_site()
+
+
 CUDA_RUNTIME_PACKAGES = [
