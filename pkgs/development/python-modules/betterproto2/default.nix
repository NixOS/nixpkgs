{
  lib,
  buildPythonPackage,
  fetchFromGitHub,

  # build-system
  uv-build,

  # dependencies
  python-dateutil,
  typing-extensions,

  # optional-dependencies
  grpcio,
  grpclib,
  protobuf,
  pydantic,

  # tests
  pytest-asyncio,
  pytest-mock,
  pytestCheckHook,
}:

buildPythonPackage (finalAttrs: {
  pname = "betterproto2";
  version = "0.10.0";
  pyproject = true;

  src = fetchFromGitHub {
    owner = "betterproto";
    repo = "python-betterproto2";
    tag = "lib-v${finalAttrs.version}";
    hash = "sha256-w8gzeFuEl00BBITu4vULIkqlMTMsBn0ZIrAy9xqS8f8=";
  };

  # The repository is a uv workspace containing both the library and the compiler
  sourceRoot = "${finalAttrs.src.name}/betterproto2";

  build-system = [ uv-build ];

  dependencies = [
    python-dateutil
    typing-extensions
  ];

  optional-dependencies = {
    grpcio = [ grpcio ];
    grpclib = [ grpclib ];
    pydantic = [ pydantic ];
    protobuf = [ protobuf ];
  };

  nativeCheckInputs = [
    pytest-asyncio
    pytest-mock
    pytestCheckHook
  ];

  # Most of the test suite needs code generated by betterproto2-compiler,
  # which itself depends on this package. Only run the self-contained tests.
  enabledTestPaths = [
    "tests/test_casing.py"
    "tests/test_map.py"
    "tests/test_version_check.py"
  ];

  pythonImportsCheck = [ "betterproto2" ];

  meta = {
    description = "Library for Protobuf 3 and gRPC with idiomatic, typed Python code";
    homepage = "https://github.com/betterproto/python-betterproto2";
    changelog = "https://github.com/betterproto/python-betterproto2/releases/tag/${finalAttrs.src.tag}";
    license = lib.licenses.mit;
    maintainers = with lib.maintainers; [ lennartmueh ];
  };
})
