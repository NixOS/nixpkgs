+            acc_dtype = torch.float32 if result_dtype in (torch.half, torch.bfloat16) else result_dtype
+            reference = dense.to(result_dtype).to(acc_dtype)
+            if operation == "sum":
+                expected = reference.sum(dim=normalized, keepdim=True)
+            elif len(normalized) == 2:
+                expected = reference.flatten().prod().reshape(1, 1)
+            else:
+                expected = reference.prod(dim=normalized[0], keepdim=True)
+            result = op(csr, dim, True, dtype=requested)
+            self.assertEqual(result.dtype, result_dtype)
+            self.assertEqual(result.to_dense(), expected.to(result_dtype))
