 aten/src/ATen/SparseCsrTensorUtils.h          |  6 +--
 .../native/sparse/SparseCsrTensorMath.cpp     | 40 ++++++++---------
 .../native/sparse/cuda/SparseCsrTensorMath.cu | 43 ++++++++++---------
 test/test_sparse_csr.py                       | 12 ++++++
 .../_internal/opinfo/definitions/sparse.py    |  5 ---
 5 files changed, 56 insertions(+), 50 deletions(-)

