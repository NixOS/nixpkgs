From 65b33eca108b63915486f0f80a8bbe05ade04128 Mon Sep 17 00:00:00 2001
From: Connor Baker <ConnorBaker01@gmail.com>
Date: Sat, 31 Oct 2026 08:12:31 -0700
Subject: [PATCH] [AOTI] Mark generated assembly as not needing an executable
 stack

With the default `aot_inductor.use_consts_asm_build=True`, AOTI writes the
model constants to a `weights.S` file. Hand-written assembly gets no
`.note.GNU-stack` section unless it declares one, and on x86-64 GNU ld then
assumes the object needs an executable stack. The linked `.so` gets a
`PT_GNU_STACK` header with `RWE` flags, and glibc 2.41+ refuses to dlopen it:

    RuntimeError: Error in dlopen: .../<hash>.wrapper.so: cannot enable
    executable stack as shared object requires: Invalid argument

So on x86-64 with glibc 2.41+, `aoti_load_package` fails for every model
compiled with the default config. Older glibc silently made the stack
executable instead.

Add the `.note.GNU-stack` section to the assembly that AOTI generates on
Linux: the asm constants (`weights.S`), the zero-size constants used with
`use_consts_asm_build=False`, and the `.incbin` cubin object used with
`embed_kernel_binary=True`. The per-cubin `ld -r -b binary` fallback already
passes `-z noexecstack`, and so did the `ld`-based constants build before the
asm build replaced it (#136924). macOS (Mach-O) and Windows are unaffected.

Test Plan:

```
python test/inductor/test_aot_inductor.py -k test_so_does_not_need_executable_stack
```

The new test checks that every `.so` in the package has a non-executable
`GNU_STACK` header, then loads and runs the package.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 test/inductor/test_aot_inductor.py | 57 ++++++++++++++++++++++++++++++
 torch/_inductor/codecache.py       |  8 +++++
 torch/_inductor/cpp_builder.py     | 10 ++++++
 3 files changed, 75 insertions(+)

diff --git a/test/inductor/test_aot_inductor.py b/test/inductor/test_aot_inductor.py
index 89119b7..eac3105 100644
--- a/test/inductor/test_aot_inductor.py
+++ b/test/inductor/test_aot_inductor.py
@@ -8897,6 +8897,63 @@ class AOTInductorTestsTemplate:
                         for lib in torch_libs:
                             self.assertTrue(lib not in line)
 
+    @unittest.skipIf(sys.platform != "linux", "PT_GNU_STACK is specific to ELF")
+    @common_utils.parametrize("use_consts_asm_build", [True, False])
+    @common_utils.parametrize("has_constants", [True, False])
+    def test_so_does_not_need_executable_stack(
+        self, use_consts_asm_build, has_constants
+    ):
+        # The constants (and, with embed_kernel_binary, the GPU kernels) are
+        # linked in from generated assembly. Without a .note.GNU-stack
+        # section, the linker may mark the .so as needing an executable stack,
+        # which glibc 2.41+ refuses to dlopen.
+        class Model(torch.nn.Module):
+            def __init__(self) -> None:
+                super().__init__()
+                self.linear = torch.nn.Linear(10, 10)
+
+            def forward(self, x):
+                return self.linear(x) if has_constants else x.sin() + 1
+
+        example_inputs = (torch.randn(10, 10, device=self.device),)
+        model = Model().to(self.device)
+        ep = torch.export.export(model, example_inputs)
+        package_path = torch._inductor.aoti_compile_and_package(
+            ep,
+            inductor_configs={
+                "aot_inductor.use_consts_asm_build": use_consts_asm_build,
+                "aot_inductor.embed_kernel_binary": True,
+            },
+        )
+
+        with tempfile.TemporaryDirectory() as tmpdir:
+            with zipfile.ZipFile(package_path, "r") as zf:
+                zf.extractall(tmpdir)
+
+            so_files = list(pathlib.Path(tmpdir).rglob("*.so"))
+            self.assertTrue(len(so_files) > 0)
+
+            for so_file in so_files:
+                result = subprocess.run(
+                    ["readelf", "-lW", str(so_file)],
+                    check=True,
+                    capture_output=True,
+                    text=True,
+                )
+                stack_headers = [
+                    line.split()
+                    for line in result.stdout.splitlines()
+                    if line.split()[:1] == ["GNU_STACK"]
+                ]
+                self.assertEqual(len(stack_headers), 1, result.stdout)
+                # Type, Offset, VirtAddr, PhysAddr, FileSiz, MemSiz, Flg, Align;
+                # Flg may contain spaces, e.g. "R E".
+                flags = "".join(stack_headers[0][6:-1])
+                self.assertNotIn("E", flags, f"{so_file}:\n{result.stdout}")
+
+        compiled = torch._inductor.aoti_load_package(package_path)
+        self.assertEqual(compiled(*example_inputs), model(*example_inputs))
+
     def test_unbounded_expr_substitutions(self):
         class Model(torch.nn.Module):
             def forward(self, x, y, a, b):
diff --git a/torch/_inductor/codecache.py b/torch/_inductor/codecache.py
index 53d5b52..f06e644 100644
--- a/torch/_inductor/codecache.py
+++ b/torch/_inductor/codecache.py
@@ -81,6 +81,7 @@ from torch._inductor.cpp_builder import (
     get_cpp_compiler,
     get_ld_and_objcopy,
     get_name_and_dir_from_output_file_path,
+    GNU_STACK_NOTE_ASM,
     normalize_path_separator,
     run_asm_build_object,
 )
@@ -2822,11 +2823,16 @@ class AotCodeCompiler:
                 else:
                     section_attr = '.lrodata, "a"'
                 symbol_prefix = ""
+                # Without this, the .so may need an executable stack, which
+                # glibc 2.41+ refuses to dlopen.
+                asm_epilogue = GNU_STACK_NOTE_ASM
             elif platform == "darwin":
                 section_attr = "__DATA,__data"
                 symbol_prefix = "_"
+                asm_epilogue = ""
             elif platform == "win32":
                 symbol_prefix = ""
+                asm_epilogue = ""
                 # ASM build is not supported on Windows, force use CPP build.
                 use_asm_build = False
             else:
@@ -2862,6 +2868,7 @@ class AotCodeCompiler:
                     consts_asm += f"\t.space {len(consts) - 8}\n"
                 consts_asm += f".globl\t{symbol_prefix}_binary_constants_bin_end\n"
                 consts_asm += f"{symbol_prefix}_binary_constants_bin_end:\n"
+                consts_asm += asm_epilogue
                 return consts_asm, "weights.S"
 
             # Use c++ to convert consts to object file can support more compilers, such as msvc and icx.
@@ -2932,6 +2939,7 @@ end
                     asm_code += f"{symbol_prefix}_binary_constants_bin_start:\n"
                     asm_code += f".globl\t{symbol_prefix}_binary_constants_bin_end\n"
                     asm_code += f"{symbol_prefix}_binary_constants_bin_end:\n"
+                    asm_code += asm_epilogue
                     asm_ext = "S"
                 return asm_code, asm_ext
 
diff --git a/torch/_inductor/cpp_builder.py b/torch/_inductor/cpp_builder.py
index abb14bc..df83b7b 100644
--- a/torch/_inductor/cpp_builder.py
+++ b/torch/_inductor/cpp_builder.py
@@ -482,6 +482,14 @@ def convert_cubin_to_obj(
     return obj_file
 
 
+# Hand-written assembly has no .note.GNU-stack section unless it declares one.
+# Without it, GNU ld assumes on some targets (e.g. x86-64) that the object needs
+# an executable stack, and marks the whole shared library as needing one
+# (PT_GNU_STACK with PF_X). glibc 2.41+ refuses to dlopen such a library, so
+# every .S file that gets linked into an AOTI .so on Linux must end with this.
+GNU_STACK_NOTE_ASM = '\t.section\t.note.GNU-stack,"",@progbits\n'
+
+
 def batch_convert_cubins_to_obj(
     cubins: list[tuple[str, str]],
     output_dir: str,
@@ -522,6 +530,8 @@ def batch_convert_cubins_to_obj(
                 f".set __{kernel_name}_size, "
                 f"__{kernel_name}_end - __{kernel_name}_start\n"
             )
+        if _IS_LINUX:
+            f.write(GNU_STACK_NOTE_ASM)
 
     subprocess.run(
         _compiler_command(cpp_compiler, "-c", asm_path, "-o", obj_path),
