Subject: [PATCH] Open ROS2 directories ending in .bag

Ouster gives ROS2 output directories a .bag suffix. AnyReader uses that
suffix to select a ROS1 file reader, so reopening the recording fails.

Select the ROS2 reader for directory inputs in both BagPacketSource and
the CLI info command. Exercise those paths with a ROS2 directory named
recording.bag, its standalone MCAP file, and the original ROS1 fixture.

---
diff --git a/python/src/ouster/sdk/bag/bag_packet_source.py b/python/src/ouster/sdk/bag/bag_packet_source.py
--- a/python/src/ouster/sdk/bag/bag_packet_source.py
+++ b/python/src/ouster/sdk/bag/bag_packet_source.py
@@ -127,6 +127,17 @@
     self.tmpdir = None


+def _make_anyreader(paths, default_typestore=None):
+    from rosbags.rosbag2 import Reader as Reader2
+
+    reader = AnyReader(paths, default_typestore=default_typestore)
+    # ROS2 output directories may end in .bag, which AnyReader treats as ROS1.
+    if not reader.is2 and all(path.is_dir() for path in paths):
+        reader.is2 = True
+        reader.readers = [Reader2(path) for path in paths]
+    return reader
+
+
 class BagPacketSource(_PacketSource):
     """Read a sensors packet streams out of a bag file as an iterator."""

@@ -179,7 +190,7 @@
         self._typestore.register(get_types_from_msg(msg_text, "ouster_sensor_msgs/msg/PacketMsg"))
         self._typestore.register(get_types_from_msg(msg_text, "ouster_msgs/msg/PacketMsg"))

-        self._reader = AnyReader([Path(self._bag_path)], default_typestore=self._typestore)
+        self._reader = _make_anyreader([Path(self._bag_path)], default_typestore=self._typestore)
         self._reader.open()

         connections = self._reader.connections
