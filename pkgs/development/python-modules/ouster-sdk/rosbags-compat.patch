+def _make_anyreader(paths, default_typestore=None):
+    from rosbags.rosbag2 import Reader as Reader2
+
+    reader = AnyReader(paths, default_typestore=default_typestore)
+    # ROS2 output directories may end in .bag, which AnyReader treats as ROS1.
+    if not reader.is2 and all(path.is_dir() for path in paths):
+        reader.is2 = True
+        reader.readers = [Reader2(path) for path in paths]
+    return reader
+
