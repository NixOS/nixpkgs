+def test_native_mcap(tmp_path, test_bag_file):
+    from rosbags.highlevel import AnyReader
+    from rosbags.rosbag2 import Reader, StoragePlugin, Writer
+
+    anyreader_init, reader_init = AnyReader.__init__, Reader.__init__
+    bag = tmp_path / "test.bag"
+    with AnyReader([Path(test_bag_file)]) as reader, Writer(
+            bag, version=8, storage_plugin=StoragePlugin.MCAP) as writer:
+        connections = {
+            conn.id: writer.add_connection(conn.topic, conn.msgtype, typestore=reader.typestore)
+            for conn in reader.connections
+        }
+        for conn, timestamp, data in reader.messages():
+            message = reader.deserialize(data, conn.msgtype)
+            cdr = reader.typestore.serialize_cdr(message, conn.msgtype)
+            writer.write(connections[conn.id], timestamp, cdr)
+
+    for path in (bag, next(bag.glob("*.mcap"))):
+        source = BagPacketSource(str(path))
+        try:
+            packets = [packet for _, packet in source]
+        finally:
+            source.close()
+        assert sum(isinstance(packet, LidarPacket) for packet in packets) == 32
+        assert sum(isinstance(packet, ImuPacket) for packet in packets) == 10
+
+        result = CliRunner().invoke(core.cli, CliArgs(['source', str(path), 'info']).args)
+        assert result.exit_code == 0, result.output
+        assert "Message Count: 43" in result.output
+        assert AnyReader.__init__ is anyreader_init
+        assert Reader.__init__ is reader_init
+
+
