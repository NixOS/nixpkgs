diff --git a/symforce/opt/internal/fmt_formatters.h b/symforce/opt/internal/fmt_formatters.h
new file mode 100644
index 0000000..e537d66
--- /dev/null
+++ b/symforce/opt/internal/fmt_formatters.h
@@ -0,0 +1,170 @@
+/* ----------------------------------------------------------------------------
+ * SymForce - Copyright 2022, Skydio, Inc.
+ * This source code is under the Apache 2.0 license found in the LICENSE file.
+ * ---------------------------------------------------------------------------- */
+
+#pragma once
+
+// fmt 9 stopped automatically formatting any type with an `operator<<` the moment
+// <fmt/ostream.h> is included -- that implicit behavior now lives behind the
+// (off-by-default) FMT_DEPRECATED_OSTREAM macro (see detail::has_fallback_formatter in
+// fmt/core.h). Without it, every type that should be formatted via its `operator<<` needs its
+// own explicit opt-in:
+//
+//   template <> struct fmt::formatter<T> : fmt::ostream_formatter {};
+//
+// This header provides that opt-in for every symforce type that gets passed directly to
+// fmt::format/fmt::print (as opposed to one of its fields/members) somewhere in symforce/opt or
+// symforce/pybind.
+//
+// Separately, fmt 9's <fmt/ranges.h> auto-detects "range-like" types by checking that
+// `.begin()`/`.end()` are callable (via decltype), and then separately computes a "range
+// reference type" as `decltype(*range_begin(...))` to decide how to format each element.
+// Eigen::DenseBase<Derived> unconditionally declares `begin()`/`end()` member functions for
+// every dense expression (see Eigen/src/Core/DenseBase.h), but their return type is aliased to
+// `void` for anything that isn't a compile-time vector (Eigen's STL-style iterators are only
+// supported for vectors; a dynamically-sized MxN matrix has `IsVectorAtCompileTime == false`).
+// `decltype(obj.begin())` is still perfectly well-formed when `begin()` returns `void`, so fmt's
+// range detection wrongly concludes these matrix types are ranges. It then hard-errors (this is
+// *not* a SFINAE-friendly failure -- it happens while computing a type alias, not while checking
+// an enable_if) trying to dereference that `void` result, which is exactly the "void value not
+// ignored as it ought to be" compile error.
+//
+// (Eigen types that genuinely are vector-shaped at compile time -- e.g. `VectorXd`, or the
+// `Eigen::Transpose<...>` of one -- really do have working begin()/end() iterators over their
+// scalar elements, and format fine as fmt ranges; they're deliberately left alone below.)
+//
+// For the (non-vector) Eigen matrix types, giving them an explicit `fmt::formatter<T>`
+// specialization backed by their `operator<<` also fixes this: an explicit (full) specialization
+// always wins over fmt/ranges.h's partial specialization regardless of whether the range
+// detection above would succeed or hard-error for T, so this sidesteps the broken detection
+// entirely for exactly these types instead of trying to suppress it more broadly. This only works
+// for a *full* specialization (concrete Scalar); see the note below about why these aren't
+// templated on Scalar like the others.
+//
+// All the other types forward-declared below are plain (non-range) classes with their own
+// `operator<<`, so a single specialization templated on Scalar covers both the double and float
+// instantiation without the ranges.h ambiguity concern above.
+
+#include <fmt/ostream.h>
+
+#include <Eigen/Core>
+#include <Eigen/SparseCore>
+
+// Forward declarations only -- every file that includes this header to format one of these
+// already includes the real definition first for other reasons.
+namespace eigen_lcm {
+class MatrixXd;
+class MatrixXf;
+}  // namespace eigen_lcm
+
+namespace sym {
+class Key;
+class key_t;
+class optimization_status_t;
+class levenberg_marquardt_solver_failure_reason_t;
+
+template <typename Scalar>
+class Factor;
+
+template <typename Scalar>
+class Values;
+
+template <typename ScalarType>
+class Rot2;
+template <typename ScalarType>
+class Rot3;
+template <typename ScalarType>
+class Pose2;
+template <typename ScalarType>
+class Pose3;
+template <typename ScalarType>
+class Unit3;
+template <typename ScalarType>
+class ATANCameraCal;
+template <typename ScalarType>
+class DoubleSphereCameraCal;
+template <typename ScalarType>
+class EquirectangularCameraCal;
+template <typename ScalarType>
+class LinearCameraCal;
+template <typename ScalarType>
+class PolynomialCameraCal;
+template <typename ScalarType>
+class SphericalCameraCal;
+template <typename ScalarType>
+class OrthographicCameraCal;
+}  // namespace sym
+
+// Non-vector Eigen matrix types that get formatted directly (see the big comment above for why
+// these need to be full specializations on a concrete Scalar rather than templated on Scalar).
+template <>
+struct fmt::formatter<Eigen::Matrix<double, Eigen::Dynamic, Eigen::Dynamic>>
+    : fmt::ostream_formatter {};
+template <>
+struct fmt::formatter<Eigen::Matrix<float, Eigen::Dynamic, Eigen::Dynamic>>
+    : fmt::ostream_formatter {};
+template <>
+struct fmt::formatter<eigen_lcm::MatrixXd> : fmt::ostream_formatter {};
+template <>
+struct fmt::formatter<eigen_lcm::MatrixXf> : fmt::ostream_formatter {};
+
+// Eigen::SparseMatrix doesn't have the range-detection problem described above (it has no
+// begin()/end() members at all), but it still needs the explicit opt-in like every other
+// streamable type under fmt 9.
+template <>
+struct fmt::formatter<Eigen::SparseMatrix<double>> : fmt::ostream_formatter {};
+template <>
+struct fmt::formatter<Eigen::SparseMatrix<float>> : fmt::ostream_formatter {};
+
+// values.cc formats an Eigen::Map over a dynamic vector (values.cc's MatrixFormatHelper); unlike
+// a plain vector-shaped Eigen type, fmt's range detection doesn't pick this up as formattable
+// (its iterator type differs enough from a plain Eigen::Matrix's that whatever condition lets
+// VectorXd etc. format fine as ranges doesn't hold here), so it needs the same explicit opt-in.
+template <>
+struct fmt::formatter<Eigen::Map<const Eigen::Matrix<double, Eigen::Dynamic, 1>>>
+    : fmt::ostream_formatter {};
+template <>
+struct fmt::formatter<Eigen::Map<const Eigen::Matrix<float, Eigen::Dynamic, 1>>>
+    : fmt::ostream_formatter {};
+
+// Plain (non-range) symforce types with their own `operator<<`.
+template <>
+struct fmt::formatter<sym::Key> : fmt::ostream_formatter {};
+template <>
+struct fmt::formatter<sym::key_t> : fmt::ostream_formatter {};
+template <>
+struct fmt::formatter<sym::optimization_status_t> : fmt::ostream_formatter {};
+template <>
+struct fmt::formatter<sym::levenberg_marquardt_solver_failure_reason_t> : fmt::ostream_formatter {
+};
+
+template <typename Scalar>
+struct fmt::formatter<sym::Factor<Scalar>> : fmt::ostream_formatter {};
+template <typename Scalar>
+struct fmt::formatter<sym::Values<Scalar>> : fmt::ostream_formatter {};
+
+template <typename ScalarType>
+struct fmt::formatter<sym::Rot2<ScalarType>> : fmt::ostream_formatter {};
+template <typename ScalarType>
+struct fmt::formatter<sym::Rot3<ScalarType>> : fmt::ostream_formatter {};
+template <typename ScalarType>
+struct fmt::formatter<sym::Pose2<ScalarType>> : fmt::ostream_formatter {};
+template <typename ScalarType>
+struct fmt::formatter<sym::Pose3<ScalarType>> : fmt::ostream_formatter {};
+template <typename ScalarType>
+struct fmt::formatter<sym::Unit3<ScalarType>> : fmt::ostream_formatter {};
+template <typename ScalarType>
+struct fmt::formatter<sym::ATANCameraCal<ScalarType>> : fmt::ostream_formatter {};
+template <typename ScalarType>
+struct fmt::formatter<sym::DoubleSphereCameraCal<ScalarType>> : fmt::ostream_formatter {};
+template <typename ScalarType>
+struct fmt::formatter<sym::EquirectangularCameraCal<ScalarType>> : fmt::ostream_formatter {};
+template <typename ScalarType>
+struct fmt::formatter<sym::LinearCameraCal<ScalarType>> : fmt::ostream_formatter {};
+template <typename ScalarType>
+struct fmt::formatter<sym::PolynomialCameraCal<ScalarType>> : fmt::ostream_formatter {};
+template <typename ScalarType>
+struct fmt::formatter<sym::SphericalCameraCal<ScalarType>> : fmt::ostream_formatter {};
+template <typename ScalarType>
+struct fmt::formatter<sym::OrthographicCameraCal<ScalarType>> : fmt::ostream_formatter {};
