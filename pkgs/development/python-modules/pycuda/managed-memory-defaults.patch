From 0507b86ae5398e0f73143bc0c904ea3767dba9da Mon Sep 17 00:00:00 2001
From: Connor Baker <ConnorBaker01@gmail.com>
Date: Sat, 26 Sep 2026 14:28:49 -0700
Subject: [PATCH] driver: use a valid default for managed memory allocation

cuMemAllocManaged requires an attachment flag; zero is not a valid
default. Use CU_MEM_ATTACH_GLOBAL across the allocation APIs while
preserving explicitly supplied flags and document that default.

Related issue: https://github.com/inducer/pycuda/issues/222
---
 doc/driver.rst               | 11 ++++++-----
 pycuda/driver.py             |  6 +++---
 src/cpp/cuda.hpp             |  4 ++--
 src/wrapper/wrap_cudadrv.cpp |  2 +-
 4 files changed, 12 insertions(+), 11 deletions(-)

diff --git a/doc/driver.rst b/doc/driver.rst
index d1fb596..b0a210d 100644
--- a/doc/driver.rst
+++ b/doc/driver.rst
@@ -1183,11 +1183,12 @@ to and from the device.
 Managed Memory Allocation
 ~~~~~~~~~~~~~~~~~~~~~~~~~
 
-.. function:: managed_empty(shape, dtype, order="C", mem_flags=0)
+.. function:: managed_empty(shape, dtype, order="C", mem_flags=mem_attach_flags.GLOBAL)
 
     Allocate a managed :class:`numpy.ndarray` of *shape*, *dtype* and *order*.
 
-    *mem_flags* may be one of the values in :class:`mem_attach_flags`.
+    *mem_flags* must be :attr:`mem_attach_flags.GLOBAL` (the default) or
+    :attr:`mem_attach_flags.HOST`.
 
     For the meaning of the other parameters, please refer to the :mod:`numpy`
     documentation.
@@ -1196,7 +1197,7 @@ Managed Memory Allocation
 
     .. versionadded:: 2014.1
 
-.. function:: managed_zeros(shape, dtype, order="C", mem_flags=0)
+.. function:: managed_zeros(shape, dtype, order="C", mem_flags=mem_attach_flags.GLOBAL)
 
     Like :func:`managed_empty`, but initialized to zero.
 
@@ -1204,13 +1205,13 @@ Managed Memory Allocation
 
     .. versionadded:: 2014.1
 
-.. function:: managed_empty_like(array, mem_flags=0)
+.. function:: managed_empty_like(array, mem_flags=mem_attach_flags.GLOBAL)
 
     Only available on CUDA 6.0 and newer.
 
     .. versionadded:: 2014.1
 
-.. function:: managed_zeros_like(array, mem_flags=0)
+.. function:: managed_zeros_like(array, mem_flags=mem_attach_flags.GLOBAL)
 
     Only available on CUDA 6.0 and newer.
 
diff --git a/pycuda/driver.py b/pycuda/driver.py
index 36a1c3f..1fcabf5 100644
--- a/pycuda/driver.py
+++ b/pycuda/driver.py
@@ -778,13 +778,13 @@ def aligned_zeros_like(array, alignment=4096):
 # {{{ managed numpy arrays (CUDA Unified Memory)
 
 
-def managed_zeros(shape, dtype, order="C", mem_flags=0):
+def managed_zeros(shape, dtype, order="C", mem_flags=mem_attach_flags.GLOBAL):
     result = managed_empty(shape, dtype, order, mem_flags)
     result.fill(0)
     return result
 
 
-def managed_empty_like(array, mem_flags=0):
+def managed_empty_like(array, mem_flags=mem_attach_flags.GLOBAL):
     if array.flags.c_contiguous:
         order = "C"
     elif array.flags.f_contiguous:
@@ -795,7 +795,7 @@ def managed_empty_like(array, mem_flags=0):
     return managed_empty(array.shape, array.dtype, order, mem_flags)
 
 
-def managed_zeros_like(array, mem_flags=0):
+def managed_zeros_like(array, mem_flags=mem_attach_flags.GLOBAL):
     result = managed_empty_like(array, mem_flags)
     result.fill(0)
     return result
diff --git a/src/cpp/cuda.hpp b/src/cpp/cuda.hpp
index 685216d..b06c340 100644
--- a/src/cpp/cuda.hpp
+++ b/src/cpp/cuda.hpp
@@ -1889,7 +1889,7 @@ namespace pycuda
   }
 
 #if CUDAPP_CUDA_VERSION >= 6000
-  inline CUdeviceptr mem_managed_alloc(size_t size, unsigned flags=0)
+  inline CUdeviceptr mem_managed_alloc(size_t size, unsigned flags=CU_MEM_ATTACH_GLOBAL)
   {
     CUdeviceptr m_data;
     CUDAPP_CALL_GUARDED(cuMemAllocManaged, (&m_data, size, flags));
@@ -2044,7 +2044,7 @@ namespace pycuda
   struct managed_allocation : public device_allocation
   {
     public:
-      managed_allocation(size_t bytesize, unsigned flags=0)
+      managed_allocation(size_t bytesize, unsigned flags=CU_MEM_ATTACH_GLOBAL)
         : device_allocation(mem_managed_alloc(bytesize, flags))
       { }
 
diff --git a/src/wrapper/wrap_cudadrv.cpp b/src/wrapper/wrap_cudadrv.cpp
index e881d68..00e331e 100644
--- a/src/wrapper/wrap_cudadrv.cpp
+++ b/src/wrapper/wrap_cudadrv.cpp
@@ -1455,7 +1455,7 @@ BOOST_PYTHON_MODULE(_driver)
 #if CUDAPP_CUDA_VERSION >= 6000
   py::def("managed_empty", numpy_empty<managed_allocation>,
       (py::arg("shape"), py::arg("dtype"), py::arg("order")="C",
-       py::arg("mem_flags")=0));
+       py::arg("mem_flags")=CU_MEM_ATTACH_GLOBAL));
 #endif
 
 #if CUDAPP_CUDA_VERSION >= 4000
