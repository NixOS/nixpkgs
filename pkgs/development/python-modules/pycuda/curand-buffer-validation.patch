 #if CUDAPP_CUDA_VERSION >= 3020
+  template <class T>
+  class curand_table_buffer
+  {
+    py_buffer_wrapper m_buffer;
+    int m_count;
+
+    public:
+      curand_table_buffer(py::object dst, int count) : m_count(count)
+      {
+        m_buffer.get(dst.ptr(), PyBUF_ANY_CONTIGUOUS | PyBUF_WRITABLE);
+        // Divide the byte capacity before comparing, avoiding count * sizeof(T)
+        // overflow. Direction-vector elements are themselves arrays.
+        if (count < 0 || count > m_buffer.m_buf.len
+            / static_cast<PYCUDA_BUFFER_SIZE_T>(sizeof(T)))
+        {
+          PyErr_SetString(PyExc_ValueError,
+              "count must be non-negative and fit in the destination buffer");
+          throw py::error_already_set();
+        }
+      }
+
+      void copy(const T *table)
+      {
+        char *dst = static_cast<char *>(m_buffer.m_buf.buf);
+        int remaining = m_count;
+        // cuRAND supplies 20,000 dimensions. Preserve PyCUDA's existing
+        // repetition of that table when more entries are requested.
+        while (remaining > 0)
+        {
+          int entries = remaining > 20000 ? 20000 : remaining;
+          size_t bytes = entries * sizeof(T);
+          memcpy(dst, table, bytes);
+          dst += bytes;
+          remaining -= entries;
+        }
+      }
+  };
+
