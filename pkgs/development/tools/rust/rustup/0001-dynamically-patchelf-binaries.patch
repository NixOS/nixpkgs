+/// Directory, relative to a toolchain, of symlinks to the Nix store paths that
+/// the toolchain's files are patched to use.  Going through these symlinks
+/// lets any later build of rustup retarget them to its own store paths, so
+/// the toolchain survives garbage collection of the rustup that installed it.
+const NIX_LINKS_DIR: &str = "lib/rustlib/nix-support";
+
+/// The symlinks in `NIX_LINKS_DIR` and their targets for this build of rustup.
+/// `@libPath@` is a single directory, so it can be linked to.
+fn nix_links() -> Result<[(&'static str, PathBuf); 3]> {
+    let ld_wrapper = std::env::current_exe()
+        .context("failed to locate rustup")?
+        .parent()
+        .context("failed to get parent directory")?
+        .with_file_name("nix-support")
+        .join("ld-wrapper.sh");
+    Ok([
+        ("ld.so", PathBuf::from("@dynamicLinker@")),
+        ("lib", PathBuf::from("@libPath@")),
+        ("ld-wrapper.sh", ld_wrapper),
+    ])
+}
+
+fn nix_link_path(toolchain_dir: &Path, name: &str) -> PathBuf {
+    toolchain_dir.join(NIX_LINKS_DIR).join(name)
+}
+
+/// Point a toolchain's Nix symlinks at this build of rustup's store paths.
+/// Unless `create` is set, toolchains without the symlinks (installed before
+/// they were introduced) are left alone.
+pub(crate) fn nix_update_links(toolchain_dir: &Path, create: bool) -> Result<()> {
+    use std::fs;
+    use tracing::debug;
+
+    let dir = toolchain_dir.join(NIX_LINKS_DIR);
+    if create {
+        fs::create_dir_all(&dir).with_context(|| format!("failed to create {dir:?}"))?;
+    } else if !fs::exists(&dir).with_context(|| format!("failed to check {dir:?}"))? {
+        // The toolchain was installed before these symlinks were introduced, so
+        // its files refer to store paths directly and wouldn't use them.
+        return Ok(());
+    }
+    for (name, target) in nix_links()? {
+        let link = dir.join(name);
+        if fs::read_link(&link).is_ok_and(|old| old == target) {
+            continue;
+        }
+        debug!("pointing {link:?} at {target:?}");
+        // Replace the symlink atomically, as other processes may be using it.
+        tempfile::Builder::new()
+            .make_in(&dir, |tmp| std::os::unix::fs::symlink(&target, tmp))
+            .and_then(|tmp| Ok(tmp.persist(&link)?))
+            .with_context(|| format!("failed to update {link:?}"))?;
+    }
+    Ok(())
+}
+
+fn nix_wrap_lld(toolchain_dir: &Path, dest_lld_path: &Path) -> Result<()> {
+    use std::fs;
+    use std::io::Write;
+    use std::os::unix::fs::PermissionsExt;
+
+    let path = dest_lld_path.parent().unwrap();
+    let mut unwrapped_name = path.file_name().unwrap().to_string_lossy().to_string();
+    unwrapped_name.push_str("-unwrapped");
+    let unwrapped_dir = path.with_file_name(unwrapped_name);
+    fs::create_dir_all(&unwrapped_dir).context("failed to create unwrapped directory")?;
+    let mut unwrapped_lld = unwrapped_dir;
+    unwrapped_lld.push(dest_lld_path.file_name().unwrap());
+    fs::rename(dest_lld_path, &unwrapped_lld).context("failed to move file")?;
+    let ld_wrapper_path = nix_link_path(toolchain_dir, "ld-wrapper.sh");
+    let mut file = fs::File::create(dest_lld_path)?;
+
+    let wrapped_script = format!(
+        "#!/usr/bin/env bash
+set -eu -o pipefail +o posix
+shopt -s nullglob
+export PROG=\"{}\"
+\"{}\" \"$@\"",
+        unwrapped_lld.to_string_lossy().to_string(),
+        ld_wrapper_path.to_string_lossy().to_string(),
+    );
+    file.write_all(wrapped_script.as_bytes())?;
+    let mut permissions = file.metadata()?.permissions();
+    permissions.set_mode(0o755);
+    file.set_permissions(permissions)?;
+    Ok(())
+}
