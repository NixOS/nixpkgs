{
  lib,
  buildOpenSCADPackage,
  fetchFromGitHub,
  stdenv,
  runCommand,
  openscad,
  libName ? "plot-function",
}:
buildOpenSCADPackage (finalAttrs: {
  pname = "plot-function";
  version = "unstable-2025-06-26";
  inherit libName;

  installTargets = [ "plot_function.scad" ];

  src = fetchFromGitHub {
    owner = "rcolyer";
    repo = "plot-function";
    rev = "5f78d0399632ded49a03edb7b695c443056ebbbd";
    hash = "sha256-Dewh6apkMy31ZsHTzFDdVbW+gjFC9b9N2/CyTYxF6DA=";
  };

  passthru = {
    tests = lib.optionalAttrs (!stdenv.hostPlatform.isDarwin) {
      functionality =
        runCommand "test-functionality-${finalAttrs.name}"
          {
            nativeBuildInputs = [
              (openscad.withPackages (ps: [ finalAttrs.finalPackage ]))
            ];
          }
          ''
            set -eu -o pipefail
            mkdir -p "$out"
            openscad -o "$out"/test.3mf - <<EOF
            use <plot-function/plot_function.scad>

            DemoFunc = function(x, y) 2*(1.5 + cos(x*x + y*y/4));
            PlotFunction(DemoFunc, [-40, 0.4, 40], [-40, 0.4, 40]);
            EOF
            if ! [[ -f "$out/test.3mf" ]]; then
              echo "ERROR: $name: test.3mf file not generated by openscad" >&2
              exit 1
            fi
          '';
    };
  };
  meta = {
    description = "OpenSCAD Function Plotting Library";
    longDescription = ''
      plot-function's upstream installation instructions can cause namespace
      conflicts. This package installs it under a `plot-function/` namespace, so
      import paths in the upstream documentation may differ. More info at
      https://wiki.nixos.org/wiki/OpenSCAD#Namespace_conflicting_libraries
    '';
    homepage = "https://github.com/rcolyer/plot-function";
    license = lib.licenses.cc0;
    maintainers = with lib.maintainers; [ xoconoch ];
  };
})
