{
  buildPecl,
  lib,
  fetchFromGitHub,
}:

let
  version = "1.1.4";
in
buildPecl {
  inherit version;
  pname = "ast";

  src = fetchFromGitHub {
    owner = "nikic";
    repo = "php-ast";
    tag = "v${version}";
    hash = "sha256-Kg1ukY4Ysw6/2yqv4oV9NEavvSZaiE6UZNE5BSBW7vw=";
  };

  meta = {
    changelog = "https://github.com/nikic/php-ast/releases/tag/v${version}";
    description = "Exposes the abstract syntax tree generated by PHP";
    license = lib.licenses.bsd3;
    homepage = "https://pecl.php.net/package/ast";
    teams = [ lib.teams.php ];
  };
}
