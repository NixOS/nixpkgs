--- /dev/null
+++ b/cmake/cudnn_frontend-dependencies.cmake.in
@@ -0,0 +1,43 @@
+include(CMakeFindDependencyMacro)
+# Outside find_package, preserve the producer's required dependency checks.
+set(_cudnn_frontend_required REQUIRED)
+if(CMAKE_FIND_PACKAGE_NAME STREQUAL "cudnn_frontend")
+    set(_cudnn_frontend_required "")
+endif()
+find_dependency(CUDAToolkit ${_cudnn_frontend_required})
+if(NOT TARGET CUDNN::cudnn OR
+   (TARGET CUDNN::cudnn_all AND DEFINED CUDNN_FOUND AND NOT CUDNN_FOUND))
+    if(CMAKE_FIND_PACKAGE_NAME STREQUAL "cudnn_frontend")
+        set(CUDNN_FIND_REQUIRED "${cudnn_frontend_FIND_REQUIRED}")
+        set(CUDNN_FIND_QUIETLY "${cudnn_frontend_FIND_QUIETLY}")
+    endif()
+    include(${CMAKE_CURRENT_LIST_DIR}/cuDNN.cmake)
+    if(NOT CUDNN_FOUND)
+        set(cudnn_frontend_FOUND FALSE)
+        set(cudnn_frontend_NOT_FOUND_MESSAGE "cuDNN headers or required libraries were not found")
+        return()
+    endif()
+endif()
+if(NOT @CUDNN_FRONTEND_SKIP_JSON_LIB@)
+    find_dependency(nlohmann_json CONFIG ${_cudnn_frontend_required})
+endif()
+
+# FindCUDAToolkit assumes NVRTC and CUDART share an include directory. NVIDIA's
+# component packages may install them separately. Discover the public header
+# here, without exporting the producer's resolved directory to consumers.
+if(NOT TARGET cudnn_frontend::nvrtc)
+    find_path(cudnn_frontend_NVRTC_INCLUDE_DIR nvrtc.h
+              HINTS ${CUDAToolkit_INCLUDE_DIRS} ${_cudnn_frontend_required})
+    if(NOT cudnn_frontend_NVRTC_INCLUDE_DIR OR NOT TARGET CUDA::nvrtc)
+        if(_cudnn_frontend_required)
+            message(FATAL_ERROR "NVRTC headers and library are required")
+        endif()
+        set(cudnn_frontend_FOUND FALSE)
+        set(cudnn_frontend_NOT_FOUND_MESSAGE "NVRTC headers or library were not found")
+        return()
+    endif()
+    add_library(cudnn_frontend::nvrtc INTERFACE IMPORTED)
+    set_target_properties(cudnn_frontend::nvrtc PROPERTIES
+        INTERFACE_INCLUDE_DIRECTORIES "${cudnn_frontend_NVRTC_INCLUDE_DIR}"
+        INTERFACE_LINK_LIBRARIES CUDA::nvrtc)
+endif()
