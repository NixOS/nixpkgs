index b7701d9..ea9193e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -45,15 +45,16 @@ target_include_directories(
     $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
 )
 
-# Find the cuda compiler
-find_package(CUDAToolkit REQUIRED)
-find_package(CUDNN REQUIRED)
-
-target_link_libraries(
-    cudnn_frontend INTERFACE
-    CUDA::toolkit
-    CuDNN::CuDNN
-)
+# Resolve the same imported dependencies for this build and installed consumers.
+configure_file(cmake/cudnn_frontend-dependencies.cmake.in
+               cudnn_frontend-dependencies.cmake @ONLY)
+configure_file(cmake/cuDNN.cmake CUDNNConfig.cmake COPYONLY)
+include(${CMAKE_CURRENT_BINARY_DIR}/cudnn_frontend-dependencies.cmake)
+target_link_libraries(cudnn_frontend INTERFACE
+    CUDA::cudart CUDNN::cudnn cudnn_frontend::nvrtc)
+if(NOT CUDNN_FRONTEND_SKIP_JSON_LIB)
+    target_link_libraries(cudnn_frontend INTERFACE nlohmann_json::nlohmann_json)
+endif()
 
 target_compile_features(cudnn_frontend INTERFACE cxx_std_17)
 
@@ -115,5 +116,7 @@ configure_package_config_file(
 )
 install(
     FILES "${CMAKE_CURRENT_BINARY_DIR}/cudnn_frontend-config.cmake"
+          "${CMAKE_CURRENT_BINARY_DIR}/cudnn_frontend-dependencies.cmake"
+          "${CMAKE_CURRENT_BINARY_DIR}/CUDNNConfig.cmake"
     DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/cudnn_frontend"
 )
