 examineStatus :: (Shape.C sh) =>
    Query sh a -> sh -> Ptr Highs -> Highs.Status -> IO (ModelStatus, Maybe a)
-examineStatus (Query query) shape model status =
-   liftA2 (,) (fmap modelStatusFromC $ Highs.getModelStatus model) $
-   Trav.for (guard (status /= Highs.statusError)) $ \() ->
-      MR.runReaderT query (shape,model)
+examineStatus (Query query) shape model status = do
+   modelStatus <- Highs.getModelStatus model
+   {-
+   HiGHs considers a proof of infeasibility as success
+   and returns kHighsStatusOk.
+   However, in case of infeasibility we must not query a solution.
+   -}
+   result <-
+      Trav.traverse (MR.runReaderT query) $
+      toMaybe
+         (status /= Highs.statusError &&
+          modelStatus /= Highs.modelStatusInfeasible &&
+          modelStatus /= Highs.modelStatusUnboundedOrInfeasible)
+         (shape,model)
+
+   return (modelStatusFromC modelStatus, result)
