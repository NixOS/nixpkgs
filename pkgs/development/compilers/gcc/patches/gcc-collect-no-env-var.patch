     }

-  char *collect_gcc_options = getenv ("COLLECT_GCC_OPTIONS");
+  const char *collect_gcc_options = read_collect_gcc_options ();
   if (collect_gcc_options)
     {
       /* Support -fno-use-linker-plugin by failing to load the plugin
