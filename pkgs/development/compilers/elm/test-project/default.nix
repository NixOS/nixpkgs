{
  stdenv,
  pkgs,
  elmPackages,
  python3,
  nodejs,
}:

let
  graphQlTestSchema = pkgs.fetchurl {
    url = "https://raw.githubusercontent.com/dillonkearns/elm-graphql/refs/tags/v4.3.2-beta.0/ete_tests/edge-cases.gql";
    hash = "sha256-HRiCXmmS/P5NpgNKDyZH/BnE9qrAR5fWoq2pnEbIwKc=";
  };

  inherit (elmPackages)
    elm

    # known not to work with 0.19.1
    # https://github.com/stil4m/elm-analyse/issues/223
    # elm-analyse

    # does not work with 0.19.1
    # for unknown reasons
    # elm-doc-preview

    # would require a local git repo to clone
    # elm-git-install

    elm-format

    elm-graphql

    elm-json

    elm-language-server

    elm-live

    elm-optimize-level-2

    elm-review

    elm-spa

    elm-test

    elm-test-rs

    # not tested because the 0.18 -> 0.19 upgrade cycle was 8 years ago at time of writing
    # elm-upgrade

    elm-verify-examples

    elm-xref

    # WRAP_OFFLINE_MODE=1 does not appear to work
    # elm-wrap
    ;
in

stdenv.mkDerivation {
  name = "elm-test-project";
  version = elm.version;

  src = ./.;

  dontUnpack = true;

  preBuild = elmPackages.fetchElmDeps {
    elmVersion = "0.19.1";
    elmPackages = import ./nix/elm-srcs.nix;
    registryDat = ./nix/registry.dat;
  };

  buildPhase = ''
    runHook preBuild

    # elm-application.json needed by elm-doc-preview
    cp -v $src/elm{,-application}.json .;
    cp -v $src/lsp-test.py .;
    mkdir src;
    cp -v $src/src/*.elm src/;
    chmod +w src/*.elm;

    # elm-json still uses a versions.dat file like 0.19.0
    # (hasn't migrated to a registry.dat like 0.19.1 yet)
    mkdir $ELM_HOME/elm-json;
    cp -v $src/nix/versions.dat $ELM_HOME/elm-json/versions.dat;
    chmod +w $ELM_HOME/elm-json/versions.dat;

    # --- some utils can run before the compiler

    echo confirming that elm-format transforms the file as expected
    echo y | ${elm-format}/bin/elm-format src/Main.elm;
    # cksum -a sha2 -l 256 --base64 src/Main.elm
    echo "SHA256 (src/Main.elm) = 4+3LnUq5IhCuKHnBZfv8pfZrJ1TXh9MvOs5gl/lCTIw=" | cksum --check

    echo confirming that elm-graphql generates Elm code from a schema
    # elm-graphql generates many files; we just confirm one is correct as a sanity check
    ${elm-graphql}/bin/elm-graphql --schema-file ${graphQlTestSchema} --skip-elm-format;
    echo "SHA256 (src/Api/Query.elm) = BGOjhuPZDD7xFvFskTZs9mPuOfldgAuM8jiHDg8DpJo=" | cksum --check
    # no need to compile it all
    rm -rf src/Api;

    echo confirming that elm-json can read the dependency tree
    ${elm-json}/bin/elm-json --offline tree;

    cp -vR $src/review .;
    chmod -R ugo+w review/;
    # nix-shell -I nixpkgs=$(pwd) -p pkgs.elmPackages.elm pkgs.elmPackages.elm-review --run 'cd pkgs/development/compilers/elm/test-project; elm-review prepare-offline'
    cp -vR $src/nix/elm-stuff .;
    chmod -R ugo+w elm-stuff;
    echo confirming that elm-review enforces code quality rules
    PATH=${elm}/bin:''${PATH} ${elm-review}/bin/elm-review;

    (
      mkdir elm-spa;
      cd elm-spa;
      echo confirming that elm-spa generates a new project
      echo 'y' | PATH=${elm}/bin:''${PATH} ${elm-spa}/bin/elm-spa new;
      echo "SHA256 (src/Pages/Home_.elm) = /epLn9J3wbuhVv7PIoFMBpgdJrfXFSArfQ6MrJRflpI=" | cksum --check
      # building complains about being offline, despite $ELM_HOME being set properly AFAICT
      # echo building elm-spa app
      # PATH=${elm}/bin:''${PATH} ${elm-spa}/bin/elm-spa build;
    )
    rm -rf elm-spa;

    echo confirming that elm-xref can find usages of a symbol
    ${elm-xref}/bin/elm-xref Html.text | grep Main.main;

    # elm-verify-examples generates tests
    cp -v $src/README.md .;
    cp -vR $src/tests .;
    chmod -R ugo+w tests;
    echo running elm-verify-examples
    ${elm-verify-examples}/bin/elm-verify-examples # --run-tests # ./src/Main.elm;

    # both variants of elm-test execute the tests generated by elm-verify-examples
    # as well as those in tests/Example.elm
    echo running tests with elm-test
    PATH=${elm}/bin:''${PATH} ${elm-test}/bin/elm-test;
    echo running tests with elm-test-rs
    PATH=${elm}/bin:${nodejs}/bin:''${PATH} ${elm-test-rs}/bin/elm-test-rs --offline;

    # --- here is the invocation of the compiler itself

    echo running the compiler
    ${elm}/bin/elm make src/Main.elm;

    # --- a few need the results of the compiler to do their jobs

    echo;
    echo "starting lsp test";
    echo "if this appears to hang, decrease the number of messages expected in lsp-test.py"
    echo "if this fails, especially after introducing new elm source files (e.g. via elm-srcs.nix),"
    echo "increase the number of messages expected in lsp-test.py"
    echo;
    PATH=${elm}/bin:${elm-test}/bin:''${PATH} ${python3}/bin/python lsp-test.py ${elm-language-server}/bin/elm-language-server $(pwd) | grep "A definition was requested"

    # TODO fix elm-doc-preview build to embed /nix/store/...-elm/bin/elm directly
    # even with the PATH fixed and an elm-application.json supplied, this does
    # not currently work
    # PATH=$PATH:${elm}/bin ''${elm-doc-preview}/bin/elm-doc-preview --debug --output doc-preview;

    # -- these utils re-invoke the compiler

    # elm-live just waits and watches, so we have to run it in the background and kill it
    echo confirming that elm-live starts a server
    ${elm-live}/bin/elm-live src/Main.elm --path-to-elm=${elm}/bin/elm &
    pid=$!
    sleep 2
    if kill -0 "$pid" 2>/dev/null; then
      # elm-live survived for 2 seconds, that probably means it works fine; kill it and move on
      kill -9 "$pid"
      wait "$pid" || true;
    else
      # elm-live exited some other way; fail the test
      exit 1;
    fi

    echo confirming that elm-optimize-level-2 builds the test project
    PATH=${elm}/bin:''${PATH} ${elm-optimize-level-2}/bin/elm-optimize-level-2 src/Main.elm

    echo "all elm tooling executed successfully!"
    touch $out;
  '';
}
