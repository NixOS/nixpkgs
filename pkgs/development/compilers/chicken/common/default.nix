{
  lib,
  stdenv,
  newScope,
  generateSplicesForMkScope,
  splicePackages,
  fetchurl,

  # Release-specific arguments, supplied by the per-release directory.
  version,
  hash,
  binaryVersion,
  # Where this package set lives in pkgs, so that its counterparts for other
  # platforms can be found when cross-compiling.
  attrPath,
  postPatch ? "",
  # Generated by ./update.sh; see the CHICKEN section of the Nixpkgs manual.
  depsFile,
  overridesFile,
  # Modules which are part of chicken itself, but which some eggs declare as
  # dependencies. They need not (and cannot) be installed as eggs, so they are
  # removed from the dependency lists instead of marking those eggs as broken.
  # Which modules are built in changes between releases, hence the argument.
  invalidDependencies,
  # Packages to add to the set, such as tools written in CHICKEN.
  extraPackages ? (_self: { }),
}:
let
  # Upstream serves eggs per major release, so the major version selects both
  # the egg channel and the documentation it is described in.
  majorVersion = lib.versions.major version;

  isCross = stdenv.hostPlatform != stdenv.buildPlatform;

  # Makes a package set as lib.makeScopeWithSplicing' does, with packages
  # taking the sets for the other platforms and returning f. Unlike there,
  # overrideScope applies to the sets for the other platforms, too, so that
  # overrides hold when cross-compiling. Those sets are made anew with the
  # extension rather than extended, so that an extension they already have,
  # such as from an overlay, is not applied twice.
  makeScope =
    {
      newScope,
      otherSplices,
      packages,
    }:
    let
      withExtension =
        extension:
        let
          splices =
            if extension == null then
              otherSplices
            else
              # selfTargetTarget is empty where there are no target packages.
              lib.mapAttrs (
                _: splice: if splice ? __withExtension then splice.__withExtension extension else splice
              ) otherSplices;
          f = packages splices;
        in
        lib.makeScopeWithSplicing' { inherit splicePackages newScope; } {
          otherSplices = splices;
          f = if extension == null then f else lib.extends extension f;
        }
        // {
          overrideScope =
            g: withExtension (if extension == null then g else lib.composeExtensions extension g);
          __withExtension = withExtension;
        };
    in
    withExtension null;
in
makeScope {
  inherit newScope;
  otherSplices = generateSplicesForMkScope attrPath;
  packages =
    otherSplices: self:
    {
      fetchegg =
        {
          pname,
          version,
          sha256,
          ...
        }:
        fetchurl {
          inherit sha256;
          url = "https://code.call-cc.org/egg-tarballs/${majorVersion}/${pname}/${pname}-${version}.tar.gz";
        };

      eggDerivation = self.callPackage ./eggDerivation.nix { inherit overridesFile; };

      chicken = self.callPackage ./chicken.nix {
        inherit
          version
          hash
          binaryVersion
          postPatch
          ;
        # When it is a cross chicken, the runtime it compiles against, and the
        # chicken that compiles its tools anew.
        targetChicken = otherSplices.selfTargetTarget.chicken;
        buildChicken = otherSplices.selfBuildHost.chicken;
      };

      chickenEggs = lib.recurseIntoAttrs (makeScope {
        inherit (self) newScope;
        otherSplices = lib.mapAttrs (_: splice: splice.chickenEggs or { }) otherSplices;
        packages =
          eggSplices: eggself:
          lib.mapAttrs (
            pname:
            eggData@{
              version,
              synopsis,
              dependencies,
              license,
              ...
            }:
            let
              eggDependencies = lib.subtractLists invalidDependencies dependencies;
            in
            self.eggDerivation {
              inherit pname version;
              src = self.fetchegg (eggData // { inherit pname; });
              propagatedBuildInputs = map (x: eggself.${x}) eggDependencies;
              # When cross-compiling, this egg built for the build platform.
              buildPlatformEgg = if isCross then eggSplices.selfBuildHost.${pname} else null;
              meta.homepage = "https://wiki.call-cc.org/eggref/${majorVersion}/${pname}";
              meta.description = synopsis;
              meta.license =
                (
                  lib.licenses
                  // {
                    "agpl" = lib.licenses.agpl3Only;
                    "artistic" = lib.licenses.artistic2;
                    "bsd" = lib.licenses.bsd3;
                    "bsd-0-clause" = lib.licenses.bsd0;
                    "bsd-1-clause" = lib.licenses.bsd1;
                    "bsd-2" = lib.licenses.bsd2;
                    "bsd-2-clause" = lib.licenses.bsd2;
                    "bsd-3" = lib.licenses.bsd3;
                    "bsd-3-clause" = lib.licenses.bsd3;
                    "gpl" = lib.licenses.gpl3Only;
                    "gpl-2" = lib.licenses.gpl2Only;
                    "gplv2" = lib.licenses.gpl2Only;
                    "gpl-3" = lib.licenses.gpl3Only;
                    "gpl-3.0" = lib.licenses.gpl3Only;
                    "gplv3" = lib.licenses.gpl3Only;
                    "lgpl" = lib.licenses.lgpl3Only;
                    "lgpl-2" = lib.licenses.lgpl2Only;
                    "lgpl-2.0+" = lib.licenses.lgpl2Plus;
                    "lgpl-2.1" = lib.licenses.lgpl21Only;
                    "lgpl-2.1-or-later" = lib.licenses.lgpl21Plus;
                    "lgpl-3" = lib.licenses.lgpl3Only;
                    "lgplv3" = lib.licenses.lgpl3Only;
                    "lgpl-3.0-or-later" = lib.licenses.lgpl3Plus;
                    "public-domain" = lib.licenses.publicDomain;
                    "srfi" = lib.licenses.bsd3;
                    "unicode" = lib.licenses.ucd;
                    "unknown" = lib.licenses.free;
                    "zlib-acknowledgement" = lib.licenses.zlib;
                  }
                ).${license} or license;
            }
          ) (lib.importTOML depsFile);
      });
    }
    // extraPackages self;
}
