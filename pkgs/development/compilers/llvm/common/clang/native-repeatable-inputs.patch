From: Nixpkgs contributors <nixpkgs@users.noreply.github.com>
Subject: [PATCH] clang: bound repeatable input checks to driver preparation

Driver framing rereads response/configuration inputs and initial toolchain
metadata. Refuse nonregular inputs before opening them during preparation,
allowing the empty null device. Queries retain that filesystem throughout.
Final immediate actions and job construction use the original filesystem:
their one-time reads must not inherit a preparation-only restriction.
Frontend/source reads stay native. A speculative probe's resource error
remains speculative; the selected native lexer still owns its diagnostics.

Assisted-by: Codex

--- a/tools/driver/driver.cpp
+++ b/tools/driver/driver.cpp
@@ -237,6 +237,39 @@
   return 1;
 }
 
+// A framed invocation interprets response/configuration inputs more than once.
+// Refuse streams before opening: a query must not consume a FIFO or stdin that
+// a later interpretation would then block on or observe as empty. Keep this
+// filesystem local to driver preparation; actual frontend/source reads stay native.
+class PrimaryInputFileSystem final : public llvm::vfs::ProxyFileSystem {
+  class InputCategory final : public std::error_category {
+  public:
+    const char *name() const noexcept override { return "nix-primary-input"; }
+    std::string message(int) const override {
+      return "Nix compiler framing requires a repeatable regular "
+             "response/configuration file";
+    }
+  };
+
+public:
+  PrimaryInputFileSystem()
+      : ProxyFileSystem(llvm::vfs::getRealFileSystem()) {}
+
+  llvm::ErrorOr<std::unique_ptr<llvm::vfs::File>>
+  openFileForRead(const llvm::Twine &Path) override {
+    auto Status = status(Path);
+    if (Status && !Status->isRegularFile()) {
+      // /dev/null and its aliases are repeatable empty inputs.
+      auto Null = status("/dev/null");
+      if (!Null || Status->getUniqueID() != Null->getUniqueID()) {
+        static InputCategory Category;
+        return std::error_code(1, Category);
+      }
+    }
+    return ProxyFileSystem::openFileForRead(Path);
+  }
+};
+
 struct PrimarySegments {
   std::array<SmallVector<const char *, 16>, 4> Args;
   int CallerDelimiter = -1;
