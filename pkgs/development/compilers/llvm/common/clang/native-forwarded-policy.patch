     unsigned MissingIndex, MissingCount;
     auto Parsed = getDriverOptTable().ParseArgs(ArrayRef(Joined).drop_front(),
-        MissingIndex, MissingCount, llvm::opt::Visibility(options::ClangOption));
+        MissingIndex, MissingCount, llvm::opt::Visibility(primaryOptionVisibility(Mode)));
     Request.CallerDelimiter = -1;
     if (Arg *Delimiter = Parsed.getLastArg(options::OPT__DASH_DASH)) {
       unsigned Index = Delimiter->getIndex(), Begin = Expanded[0].size();
@@ -443,8 +540,6 @@ static bool preparePrimarySegments(const char *Program, PrimarySegments &Request
       driver::applyOverrideOptions(Selection, Override, SelectionStrings,
                                    "CCC_OVERRIDE_OPTIONS", nullptr);
     StringRef Mode = getDriverMode(Program, ArrayRef(Selection).drop_front());
-    if (!Mode.empty() && Mode != "gcc" && Mode != "g++" && Mode != "cpp")
