+  // Configured defaults yield only to an explicitly requested target. Mode
+  // options such as -m32 select a variant of the configured target and keep
+  // them, as the wrapper's own -target prefix did.
+  if (!NativeDefaultTarget.empty()) {
+    llvm::Triple Expected(llvm::Triple::normalize(NativeDefaultTarget));
+    llvm::Triple Requested = Expected;
+    if (const Arg *A = Args.getLastArg(options::OPT_target))
+      Requested = llvm::Triple(llvm::Triple::normalize(A->getValue()));
+    if (Expected.isMacOSX()) Expected.setOS(llvm::Triple::MacOSX);
+    if (Requested.isMacOSX()) Requested.setOS(llvm::Triple::MacOSX);
+    if (Expected == Requested) {
+      bool DefaultsError = false;
+      SmallVector<const char *, 32> HostDefaults;
+      for (const char *Flag : NativeTargetDefaults) {
+        HostDefaults.push_back("-Xarch_host");
+        HostDefaults.push_back(Flag);
+      }
+      InputArgList Defaults = ParseArgStrings(HostDefaults,
+          /*UseDriverMode=*/false, DefaultsError);
+      ContainsError |= DefaultsError;
+      for (auto *A : Args) appendOneArg(Defaults, A);
+      Args = std::move(Defaults);
+    } else if (!PrimaryQueryFD) {
+      int Suppress = 0;
+      if (const char *Value = ::getenv("NIX_CC_WRAPPER_SUPPRESS_TARGET_WARNING"))
+        if (StringRef(Value).getAsInteger(10, Suppress)) Suppress = 0;
+      if (Suppress < 1)
+        llvm::errs() << "warning: configured target defaults omitted for "
+                     << Requested.str() << " (configured "
+                     << NativeDefaultTarget << ")\n";
+    }
+  }
