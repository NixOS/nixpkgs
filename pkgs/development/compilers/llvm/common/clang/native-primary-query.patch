+
+static bool readPrimarySegments(unsigned FD, llvm::StringSaver &Saver,
+                                PrimarySegments &Request) {
+  auto Close = llvm::make_scope_exit([&] { ::close(FD); });
+  std::string Bytes;
+  char Buffer[4096];
+  while (true) {
+    ssize_t Count = ::read(FD, Buffer, sizeof(Buffer));
+    if (Count < 0 && errno == EINTR) continue;
+    if (Count < 0) return false;
+    if (!Count) break;
+    Bytes.append(Buffer, Count);
+  }
+  StringRef Rest(Bytes);
+  auto Token = [&]() -> std::optional<StringRef> {
+    size_t End = Rest.find('\0');
+    if (End == StringRef::npos) return std::nullopt;
+    StringRef Value = Rest.take_front(End);
+    Rest = Rest.drop_front(End + 1);
+    return Value;
+  };
+  auto Magic = Token();
+  if (!Magic || *Magic != "nix-primary-v3") return false;
+  auto Pure = Token(), NoNative = Token(), SDK = Token(), Target = Token();
+  if (!Pure || !NoNative || !SDK || !Target ||
+      (*Pure != "0" && *Pure != "1") ||
+      (*NoNative != "0" && *NoNative != "1")) return false;
+  Request.Pure = *Pure == "1";
+  Request.NoNative = *NoNative == "1";
+  Request.SDK = Saver.save(*SDK);
+  Request.DefaultTarget = Saver.save(*Target);
+  std::array<SmallVector<const char *, 16> *, 6> Groups{
+      &Request.Args[0], &Request.Args[1], &Request.Args[2], &Request.Args[3],
+      &Request.TargetDefaults, &Request.AllowedPrefixes};
+  std::array<unsigned, 6> Counts;
+  for (auto &Count : Counts) {
+    auto Value = Token();
+    if (!Value || Value->empty() || Value->getAsInteger(10, Count)) return false;
+  }
+  for (unsigned I = 0; I != 6; ++I)
+    for (unsigned J = 0; J != Counts[I]; ++J) {
+      auto Value = Token();
+      if (!Value) return false;
+      Groups[I]->push_back(Saver.save(*Value).data());
+    }
+  return Rest.empty();
+}
+
+// Apply caller policy using native option ownership and consumed spans.
+static void filterCallerPolicy(
+    std::array<SmallVector<const char *, 16>, 4> &Segments,
+    bool Pure, bool NoNative, ArrayRef<const char *> AllowedPrefixes,
+    StringRef SDK, unsigned Visibility = options::ClangOption) {
+  if (!Pure && !NoNative) return;
+  SmallVector<const char *, 256> Joined;
+  for (const auto &Segment : Segments) llvm::append_range(Joined, Segment);
+  llvm::opt::InputArgList Raw(Joined.data(), Joined.data() + Joined.size());
+  SmallVector<bool, 256> Keep(Joined.size(), true);
+  const unsigned Begin = Segments[0].size(), End = Begin + Segments[1].size();
+  auto BadPath = [&](StringRef Path) {
+    SmallString<256> SDKPath;
+    if (!SDK.empty()) {
+      SDKPath = SDK;
+      SDKPath += '/';
+      SDKPath += Path;
+      if (llvm::sys::fs::exists(SDKPath)) Path = SDKPath;
+    }
+    if (!Path.starts_with("/") || Path == "/dev/null") return false;
+    return llvm::none_of(AllowedPrefixes, [&](StringRef Prefix) {
+      return !Prefix.empty() && Path.starts_with(Prefix);
+    });
+  };
+  for (unsigned I = 0; I < Joined.size();) {
+    const unsigned Start = I;
+    auto Arg = getDriverOptTable().ParseOneArg(
+        Raw, I, llvm::opt::Visibility(Visibility));
+    if (!Arg || Start < Begin || Start >= End) continue;
+    const auto &Option = Arg->getOption();
+    bool Drop = Pure && (Option.matches(options::OPT_I) ||
+                        Option.matches(options::OPT_L) ||
+                        Option.matches(options::OPT_isystem)) &&
+                BadPath(Arg->getValue());
+    const bool Native = NoNative && Option.matches(options::OPT_m_Group) &&
+                        Arg->getNumValues() == 1 &&
+                        StringRef(Arg->getValue()) == "native";
+    if (Native)
+      llvm::errs() << "warning: Skipping impure flag " << Arg->getAsString(Raw)
+                   << " because NIX_ENFORCE_NO_NATIVE is set\n";
+    else if (Drop) {
+      int Debug = 0;
+      if (const char *Value = ::getenv("NIX_DEBUG"))
+        if (StringRef(Value).getAsInteger(10, Debug)) Debug = 0;
+      if (Debug >= 1) llvm::errs() << "skipping impure path " << Arg->getValue() << '\n';
+    }
+    Drop |= Native;
+    if (Drop)
+      for (unsigned J = Start; J < std::min<unsigned>(I, Joined.size()); ++J)
+        Keep[J] = false;
+  }
+  unsigned Offset = 0;
+  for (auto &Segment : Segments) {
+    SmallVector<const char *, 16> Kept;
+    for (const char *Token : Segment)
+      if (Keep[Offset++]) Kept.push_back(Token);
+    Segment = std::move(Kept);
+  }
+}
