+      driver::applyOverrideOptions(Selection, Override, SelectionStrings,
+                                   "CCC_OVERRIDE_OPTIONS", nullptr);
+    StringRef Mode = getDriverMode(Program, ArrayRef(Selection).drop_front());
+    if (!Mode.empty() && Mode != "gcc" && Mode != "g++" && Mode != "cpp")
+      return false;
+    Request.CXX = Mode == "g++";
+    if (Request.CXX && !Request.Args[3].empty() &&
+        !Interpret(true, Frontend)) return false;
+  }
+  return true;
+}
