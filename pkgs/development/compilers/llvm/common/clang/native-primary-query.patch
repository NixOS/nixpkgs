+                                              : Request.CallerDelimiter;
+    Args.assign({Program});
+    llvm::append_range(Args, Expanded[0]);
+    llvm::append_range(Args, ArrayRef(Expanded[1]).take_front(Split));
+    llvm::append_range(Args, Expanded[2]);
+    llvm::append_range(Args, Expanded[3]);
+    llvm::append_range(Args, ArrayRef(Expanded[1]).drop_front(Split));
+    return Args.size() < 2 || !StringRef(Args[1]).starts_with("-cc1");
+  };
