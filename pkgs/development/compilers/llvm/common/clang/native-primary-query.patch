+struct PrimarySegments {
+  std::array<SmallVector<const char *, 16>, 4> Args;
+  int CallerDelimiter = -1;
+  bool CXX = false, Pure = false, NoNative = false;
+  StringRef SDK, DefaultTarget;
+  SmallVector<const char *, 16> TargetDefaults, AllowedPrefixes;
