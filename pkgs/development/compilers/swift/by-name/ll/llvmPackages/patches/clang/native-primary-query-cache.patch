From e24dcdea44d596108f75eeaee2aa3a251231a799 Mon Sep 17 00:00:00 2001
From: Connor Baker <ConnorBaker01@gmail.com>
Date: Thu, 8 Oct 2026 16:40:56 -0700
Subject: [PATCH] driver: reject unsupported query cache mode before cache
 execution

Assisted-by: Codex (gpt-6-astra)
---
 tools/driver/driver.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/tools/driver/driver.cpp b/tools/driver/driver.cpp
index 14bc5f2..1064161 100644
--- a/tools/driver/driver.cpp
+++ b/tools/driver/driver.cpp
@@ -450,6 +450,7 @@ int clang_main(int Argc, char **Argv, const llvm::ToolContext &ToolContext) {
   const char *ProgName =
       ToolContext.NeedsPrependArg ? ToolContext.PrependArg : ToolContext.Path;
   StringRef DriverMode = getDriverMode(ProgName, llvm::ArrayRef(Args).slice(1));
+  if (PrimaryArgsFD && isClangCache(DriverMode)) return 1;
   if (isClangCache(DriverMode)) {
     if (std::optional<int> ExitCode = handleClangCacheInvocation(Args, Saver))
       return *ExitCode;
