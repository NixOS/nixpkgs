diff --git a/include/swift/Nixpkgs/NixCC.h b/include/swift/Nixpkgs/NixCC.h
new file mode 100644
index 00000000000..4669c2c4486
--- /dev/null
+++ b/include/swift/Nixpkgs/NixCC.h
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#pragma once
+
+#include "llvm/ADT/StringRef.h"
+#include "llvm/Support/CommandLine.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/Process.h"
+#include "llvm/Support/VirtualFileSystem.h"
+
+#include <filesystem>
+#include <functional>
+#include <unordered_map>
+#include <optional>
+#include <string>
+
+using nixsupportcache_t = std::unordered_map<std::string, std::vector<std::string>>;
+extern void accessNixSupportCache(std::function<void(nixsupportcache_t&)>&& fn);
+
+template<typename T>
+void addFlagsFromNixCC(std::vector<T> &invocationArgStrs, const char* flagFile) {
+  if (flagFile == nullptr) return;
+  const std::string flagFileName{flagFile};
+  
+  accessNixSupportCache([&](nixsupportcache_t& nixSupportCache) {
+    const auto [argIterator, didInsert] = nixSupportCache.insert({flagFileName, std::vector<std::string>{}});
+    auto& argVector = argIterator->second;
+
+    if (didInsert) {
+      // Prefer the `clang` next to the running binary but fall back to the one next to `swift` on the path.
+      std::function<std::optional<std::string>()> paths[] = {
+        []() -> std::optional<std::string> {
+          auto result = llvm::sys::fs::getMainExecutable(nullptr, nullptr);
+          if (result == "") return {}; else return result;
+        },
+        []() { return llvm::sys::Process::FindInEnvPath("PATH", "swiftc"); },
+      };
+
+      llvm::BumpPtrAllocator allocator;
+      llvm::StringSaver saver(allocator);
+
+      for (const auto& maybePathFn : paths) {
+        auto maybePath = maybePathFn();
+        if (!maybePath.has_value()) continue;
+        
+        const std::filesystem::path path = maybePath.value();
+        const auto clang = path.parent_path() / "clang";
+
+        if (exists(clang)) {
+          const auto realClang = canonical(clang);
+          const auto flagFilePath = realClang.parent_path().parent_path() / "nix-support" / flagFileName;
+          
+          // Treat `flagFile` as a response file for Clang. Because Clang expects response
+          // files to be expanded already at this point, it has to be expanded manually.
+          if (auto buffer = llvm::vfs::getRealFileSystem()->getBufferForFile(llvm::StringRef(flagFilePath))) {
+            const auto contents = (*buffer)->getMemBufferRef().getBuffer();
+
+            llvm::SmallVector<const char*> args;
+            llvm::cl::TokenizeGNUCommandLine(contents, saver, args);
+
+            for (const auto& arg : args) {
+              argVector.emplace_back(arg);
+            }
+
+            break; // We have an `argVector` with the args. Short-circuit the loop and don’t check further.
+          }
+        }
+      }
+    }
+    
+    // At this point, `argVector` is either the cached vector or the freshly populated one.
+    // Either way, it has the requested flags.
+    for (const auto& arg : argVector) {
+      invocationArgStrs.emplace_back(arg.c_str());
+    }
+  });
+}
