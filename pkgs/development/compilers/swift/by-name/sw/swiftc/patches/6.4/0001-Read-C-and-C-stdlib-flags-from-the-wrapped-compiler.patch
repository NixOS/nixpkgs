 lib/ClangImporter/ClangIncludePaths.cpp | 10 ++++
 lib/Nixpkgs/CMakeLists.txt              |  4 ++
 lib/Nixpkgs/NixCC.cpp                   | 15 +++++
 7 files changed, 117 insertions(+), 1 deletion(-)
