From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Randy Eckenrode <randy@largeandhighquality.com>
Date: Sun, 4 Jan 2026 14:37:05 -0500
Subject: [PATCH] Read C and C++ stdlib defaults from the wrapped compiler
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

On most platforms supported by Nixpkgs, the C and C++ standard libraries
are located separately and are not part of the sysroot, but Swift’s
ClangImporter assumes they are part of the sysroot by default.

While it is possible to create a sysroot for use with Swift, this has
negative affects on every package that wants to use Swift and compile
C++ code. The C++ library must be removed from the standard platform
configuration, which makes adding Swift as a dependency too disruptive.

Prefer the selected provider config before explicit arguments in both driver
interpretation paths. Keep the original support-file fallback for older
wrappers, and only add its C++ headers when interoperation is enabled. Cache
file presence separately from its tokens so an empty config remains valid.
---
 include/swift/ClangImporter/ClangImporter.h |  3 +-
 include/swift/Nixpkgs/NixCC.h               | 82 +++++++++++++++++++++++++++++
 lib/CMakeLists.txt                          |  1 +
 lib/ClangImporter/CMakeLists.txt            |  3 +-
 lib/ClangImporter/ClangImporter.cpp         | 11 ++++
 lib/ClangImporter/ClangIncludePaths.cpp     | 20 +++++--
 lib/Frontend/CompilerInvocation.cpp         |  2 +-
 lib/Nixpkgs/CMakeLists.txt                  |  4 ++
 lib/Nixpkgs/NixCC.cpp                       | 15 ++++++
 9 files changed, 134 insertions(+), 7 deletions(-)

diff --git a/include/swift/ClangImporter/ClangImporter.h b/include/swift/ClangImporter/ClangImporter.h
index feff598..ebeab94 100644
--- a/include/swift/ClangImporter/ClangImporter.h
+++ b/include/swift/ClangImporter/ClangImporter.h
@@ -259,7 +259,8 @@ public:
   static llvm::opt::InputArgList
   createClangArgs(const ClangImporterOptions &ClangImporterOpts,
                   const SearchPathOptions &SearchPathOpts,
-                  clang::driver::Driver &clangDriver);
+                  clang::driver::Driver &clangDriver,
+                  bool enableCXXInterop);
 
   ClangImporter(const ClangImporter &) = delete;
   ClangImporter(ClangImporter &&) = delete;
diff --git a/include/swift/Nixpkgs/NixCC.h b/include/swift/Nixpkgs/NixCC.h
new file mode 100644
index 0000000..08edbfe
--- /dev/null
+++ b/include/swift/Nixpkgs/NixCC.h
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#pragma once
+
+#include "llvm/ADT/StringRef.h"
+#include "llvm/Support/CommandLine.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/Process.h"
+#include "llvm/Support/VirtualFileSystem.h"
+
+#include <filesystem>
+#include <functional>
+#include <unordered_map>
+#include <optional>
+#include <string>
+
+using nixsupportcache_t = std::unordered_map<std::string, std::optional<std::vector<std::string>>>;
+extern void accessNixSupportCache(std::function<void(nixsupportcache_t&)>&& fn);
+
+template<typename T>
+bool addFlagsFromNixCC(std::vector<T> &invocationArgStrs, const char* flagFile) {
+  if (flagFile == nullptr) return false;
+  const std::string flagFileName{flagFile};
+
+  bool found = false;
+  accessNixSupportCache([&](nixsupportcache_t& nixSupportCache) {
+    const auto [argIterator, didInsert] = nixSupportCache.try_emplace(flagFileName, std::nullopt);
+    auto& argVector = argIterator->second;
+
+    if (didInsert) {
+      // Prefer the `clang` next to the running binary but fall back to the one next to `swift` on the path.
+      std::function<std::optional<std::string>()> paths[] = {
+        []() -> std::optional<std::string> {
+          auto result = llvm::sys::fs::getMainExecutable(nullptr, nullptr);
+          if (result == "") return {}; else return result;
+        },
+        []() { return llvm::sys::Process::FindInEnvPath("PATH", "swiftc"); },
+      };
+
+      llvm::BumpPtrAllocator allocator;
+      llvm::StringSaver saver(allocator);
+
+      for (const auto& maybePathFn : paths) {
+        auto maybePath = maybePathFn();
+        if (!maybePath.has_value()) continue;
+
+        const std::filesystem::path path = maybePath.value();
+        const auto clang = path.parent_path() / "clang";
+
+        if (exists(clang)) {
+          const auto realClang = canonical(clang);
+          const auto flagFilePath = realClang.parent_path().parent_path() / "nix-support" / flagFileName;
+
+          // Treat `flagFile` as a response file for Clang. Because Clang expects response
+          // files to be expanded already at this point, it has to be expanded manually.
+          if (auto buffer = llvm::vfs::getRealFileSystem()->getBufferForFile(llvm::StringRef(flagFilePath))) {
+            const auto contents = (*buffer)->getMemBufferRef().getBuffer();
+
+            llvm::SmallVector<const char*> args;
+            llvm::cl::TokenizeGNUCommandLine(contents, saver, args);
+
+            argVector.emplace();
+            for (const auto& arg : args) {
+              argVector->emplace_back(arg);
+            }
+
+            break; // We have an `argVector` with the args. Short-circuit the loop and don’t check further.
+          }
+        }
+      }
+    }
+
+    // At this point, `argVector` is either the cached vector or the freshly populated one.
+    // Either way, it has the requested flags.
+    found = argVector.has_value();
+    if (found) {
+      for (const auto& arg : *argVector) {
+        invocationArgStrs.emplace_back(arg.c_str());
+      }
+    }
+  });
+  return found;
+}
