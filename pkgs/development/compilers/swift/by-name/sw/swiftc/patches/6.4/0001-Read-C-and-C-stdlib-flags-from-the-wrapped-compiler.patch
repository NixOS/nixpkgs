--- /dev/null
+++ b/lib/Nixpkgs/NixCC.cpp
@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "swift/Nixpkgs/NixCC.h"
+
+#include <functional>
+#include <map>
+#include <mutex>
+#include <string>
+
+static nixsupportcache_t NixSupportCache;
+
+extern void accessNixSupportCache(std::function<void(nixsupportcache_t&)>&& fn) {
+  static std::mutex nixSupportCacheMutex;
+  std::lock_guard<std::mutex> lock{nixSupportCacheMutex};
+  fn(NixSupportCache);
+}
