diff --git a/lib/ClangImporter/ClangImporter.cpp b/lib/ClangImporter/ClangImporter.cpp
index 2815b8b..12f1a86 100644
--- a/lib/ClangImporter/ClangImporter.cpp
+++ b/lib/ClangImporter/ClangImporter.cpp
@@ -50,6 +50,7 @@
 #include "swift/ClangImporter/ClangImporterRequests.h"
 #include "swift/ClangImporter/ClangModule.h"
 #include "swift/Frontend/CachingUtils.h"
+#include "swift/Nixpkgs/NixCC.h"
 #include "swift/Parse/ParseVersion.h"
 #include "swift/Strings.h"
 #include "swift/Subsystems.h"
@@ -624,7 +625,17 @@ void importer::getNormalInvocationArguments(
     });
   }
 
+  // Ensure libc is available. The C standard library is separate from the sysroot
+  // on most platforms in Nixpkgs. (Darwin is a prominent exception.)
+  bool hasDriverDefaults = addFlagsFromNixCC(invocationArgStrs, "cc-importer.cfg");
+  if (!hasDriverDefaults)
+    addFlagsFromNixCC(invocationArgStrs, "libc-cflags");
+
   if (LangOpts.EnableCXXInterop) {
+    // Older wrappers expose the C++ provider through a separate support file.
+    if (!hasDriverDefaults)
+      addFlagsFromNixCC(invocationArgStrs, "libcxx-cxxflags");
+
     if (auto path = getCxxShimModuleMapPath(searchPathOpts, LangOpts, triple)) {
       invocationArgStrs.push_back((Twine("-fmodule-map-file=") + *path).str());
     }
diff --git a/lib/ClangImporter/ClangIncludePaths.cpp b/lib/ClangImporter/ClangIncludePaths.cpp
index 5bc7258..94804ce 100644
--- a/lib/ClangImporter/ClangIncludePaths.cpp
+++ b/lib/ClangImporter/ClangIncludePaths.cpp
@@ -18,6 +18,7 @@
 #include "swift/Basic/Assertions.h"
 #include "swift/Basic/Platform.h"
 #include "swift/ClangImporter/ClangImporter.h"
+#include "swift/Nixpkgs/NixCC.h"
 #include "clang/Driver/Driver.h"
 #include "clang/Driver/ToolChain.h"
 #include "clang/Frontend/CompilerInstance.h"
@@ -184,13 +185,24 @@ static std::optional<Path> findFirstIncludeDir(
 llvm::opt::InputArgList
 ClangImporter::createClangArgs(const ClangImporterOptions &ClangImporterOpts,
                                const SearchPathOptions &SearchPathOpts,
-                               clang::driver::Driver &clangDriver) {
+                               clang::driver::Driver &clangDriver,
+                               bool enableCXXInterop) {
   // Flags passed to Swift with `-Xcc` might affect include paths.
   std::vector<const char *> clangArgs;
   clangArgs.reserve(ClangImporterOpts.ExtraArgs.size());
+  bool hasDriverDefaults = addFlagsFromNixCC(clangArgs, "cc-importer.cfg");
   for (const auto &each : ClangImporterOpts.ExtraArgs) {
     clangArgs.push_back(each.c_str());
   }
+
+  // Ensure libc is available. The C standard library is separate from the sysroot
+  // on most platforms in Nixpkgs. (Darwin is a prominent exception.)
+  if (!hasDriverDefaults)
+    addFlagsFromNixCC(clangArgs, "libc-cflags");
+
+  if (enableCXXInterop && !hasDriverDefaults)
+    addFlagsFromNixCC(clangArgs, "libcxx-cxxflags");
+
   llvm::opt::InputArgList clangDriverArgs =
       parseClangDriverArgs(clangDriver, clangArgs);
   // If a sysroot was explicitly passed to Swift, make sure to pass it to the
@@ -223,7 +235,7 @@ getLibcFileMapping(const ASTContext &ctx, StringRef modulemapFileName,
       ClangImporter::createClangDriver(ctx.LangOpts, ctx.ClangImporterOpts,
                                        vfs);
   auto clangDriverArgs = ClangImporter::createClangArgs(
-      ctx.ClangImporterOpts, ctx.SearchPathOpts, clangDriver);
+      ctx.ClangImporterOpts, ctx.SearchPathOpts, clangDriver, ctx.LangOpts.EnableCXXInterop);
 
   llvm::opt::ArgStringList includeArgStrings;
   const auto &clangToolchain =
@@ -303,7 +315,7 @@ static void getLibStdCxxFileMapping(
       ClangImporter::createClangDriver(ctx.LangOpts, ctx.ClangImporterOpts,
                                        vfs);
   auto clangDriverArgs = ClangImporter::createClangArgs(
-      ctx.ClangImporterOpts, ctx.SearchPathOpts, clangDriver);
+      ctx.ClangImporterOpts, ctx.SearchPathOpts, clangDriver, ctx.LangOpts.EnableCXXInterop);
 
   llvm::opt::ArgStringList stdlibArgStrings;
   const auto &clangToolchain =
@@ -505,7 +517,7 @@ void GetWindowsFileMappings(
       ClangImporter::createClangDriver(Context.LangOpts,
                                        Context.ClangImporterOpts, driverVFS);
   const llvm::opt::InputArgList Args = ClangImporter::createClangArgs(
-      Context.ClangImporterOpts, Context.SearchPathOpts, Driver);
+      Context.ClangImporterOpts, Context.SearchPathOpts, Driver, Context.LangOpts.EnableCXXInterop);
   const clang::driver::ToolChain &ToolChain = Driver.getToolChain(Args, Triple);
   llvm::vfs::FileSystem &VFS = ToolChain.getVFS();
 
diff --git a/lib/Frontend/CompilerInvocation.cpp b/lib/Frontend/CompilerInvocation.cpp
index 933165c..d058c3b 100644
--- a/lib/Frontend/CompilerInvocation.cpp
+++ b/lib/Frontend/CompilerInvocation.cpp
@@ -411,7 +411,7 @@ void CompilerInvocation::computeCXXStdlibOptions() {
     auto [clangDriver, clangDiagEngine, clangDiagOpts] =
         ClangImporter::createClangDriver(LangOpts, ClangImporterOpts);
     auto clangDriverArgs = ClangImporter::createClangArgs(
-        ClangImporterOpts, SearchPathOpts, clangDriver);
+        ClangImporterOpts, SearchPathOpts, clangDriver, LangOpts.EnableCXXInterop);
     auto &clangToolchain =
         clangDriver.getToolChain(clangDriverArgs, LangOpts.Target);
     auto cxxStdlibKind = clangToolchain.GetCXXStdlibType(clangDriverArgs);
