+  -- Get compiler settings.
+  --
+  -- `GHC_BOOT_SETTINGS` is the JSON spelling of what `HADRIAN_SETTINGS` has
+  -- always carried. Both are accepted: the value is parsed as a JSON object of
+  -- string values if it looks like one, and as the `Read` of a
+  -- `[(String, String)]` otherwise, so existing callers are unaffected.
+  --
+  -- JSON because this is the same string-to-string map as `lib/settings`, and
+  -- anything that is not a Haskell program should be able to write it.
+  settings <- do
+    mEnv <- do
+      json <- lookupEnv "GHC_BOOT_SETTINGS"
+      case json of
+        Just _ -> pure json
+        Nothing -> lookupEnv "HADRIAN_SETTINGS"
+    case mEnv of
+      Just s -> pure $ Left $ parseSettings s
+      Nothing -> do
+        (ghc,withPrograms) <- requireProgram normal ghcProgram withPrograms
+        Right . parseSettings <$> getProgramOutput normal ghc ["--info"]
 
