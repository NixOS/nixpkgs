# The nixpkgs-specific half of the GHC packages.
#
# Each package is a directory under `./packages/`:
#
#     <version>/packages/rts/generated-package.nix   <- verbatim cabal2nix
#     <version>/packages/rts/*.patch                 <- diffs against that .cabal
#     common/packages/rts/overrides.nix              <- everything else
#
# `generated-package.nix` is regenerated by
# `maintainers/scripts/haskell/regenerate-ghc-ng-packages.sh` and is never
# hand-edited. Everything nixpkgs needs on top of it is applied here with
# `overrideCabal`:
#
#   o `src`, which the generated files deliberately omit -- cabal2nix would
#     otherwise pin the store path of whichever tree was realised when the
#     script ran.
#   o `postUnpack`, selecting the package's subdirectory of the GHC tree. The
#     same idiom `pkgs/development/tools/haskell/hadrian/ghc-toolchain.nix`
#     already uses today.
#   o every `*.patch` sitting beside it.
#   o the occasional metadata fix, e.g. a `license` upstream's .cabal omits.
#
# ## Patches are per-component
#
# A patch lives with the one package it touches, and is rooted at that package's
# directory -- `a/Main.hs`, not `a/utils/ghc-toolchain/exe/Main.hs` -- because
# that is where the package is unpacked.
#
# That is not just tidiness. These are meant to go upstream, and upstream will
# take them one component at a time: the `ghc-toolchain` half of the JSON
# settings work stands on its own, and so does the `ghc-boot` parser. Neither
# should have to wait for the other.
#
# It also means there is no patch-splitting machinery of the sort the freebsd
# and illumos trees carry. Nothing needs splitting, because nothing was ever
# pooled.
{
  lib,
  stdenv,
  callPackage,
  python3,
  libffi,
  autoreconfHook,
  ncurses,
  haskellLib,
  ghcSrc,

  # Which Cabal the packages' `Setup.hs` files are written against. This is a
  # per-version fact, not a "newer is better" one: 9.14's `ghc-boot/Setup.hs`
  # does not compile against 3.16 (the `Distribution.Utils.Path` types changed),
  # and HEAD's does not compile against 3.12 (it calls
  # `interpretSymbolicPathLBI`, which 3.12 does not export).
  setupCabalVersion,

  # The generated expressions for *this* GHC version. They are version-specific:
  # cabal2nix bakes the version into each one, so a 9.14 expression against a
  # 9.15 tree produces a `ghc-boot-9.14.1` that does not match the .cabal it is
  # building from.
  packagesDir,
}:

let

  # Which subdirectory of the GHC tree each package is built from. This is the
  # only per-package fact the overlay has to state; patches are discovered.
  subdirs = {
    # Build-platform tools.
    deriveConstants = "utils/deriveConstants";
    genapply = "utils/genapply";
    genprimopcode = "utils/genprimopcode";
    unlit = "utils/unlit";
    ghc-toolchain = "utils/ghc-toolchain";
    ghc-toolchain-bin = "utils/ghc-toolchain/exe";

    # Boot libraries.
    ghc-platform = "libraries/ghc-platform";
    ghc-boot = "libraries/ghc-boot";
    ghc-boot-th = "libraries/ghc-boot-th";
    # Generated by `./src.nix` from the same `.cabal.in`, exactly as hadrian's
    # `Rules.Generate` does, with `Suffix = "-next"` and
    # `SourceRoot = "../ghc-boot-th"`. It exists so stage1 can use a newer
    # `ghc-boot-th` than the bootstrap compiler ships without the two colliding.
    ghc-boot-th-next = "libraries/ghc-boot-th-next";
    ghc-heap = "libraries/ghc-heap";
    ghc-compact = "libraries/ghc-compact";
    ghc-bignum = "libraries/ghc-bignum";
    ghc-internal = "libraries/ghc-internal";
    ghc-experimental = "libraries/ghc-experimental";
    ghc-prim = "libraries/ghc-prim";
    base = "libraries/base";
    ghci = "libraries/ghci";
    template-haskell = "libraries/template-haskell";
    integer-gmp = "libraries/integer-gmp";

    # NB: `system-cxx-std-lib` is deliberately absent. It is not a source
    # package at all -- it is `mk/system-cxx-std-lib-1.0.conf.in`, a hand-written
    # package.conf registered straight into the db, whose `@CXX_STD_LIB_LIBS@`
    # and friends are probed C++ toolchain facts. nixpkgs knows those from
    # `stdenv`, so it is generated by the assembly step rather than built.

    # The compiler, and the executables shipped beside it.
    ghc = "compiler";
    ghc-bin = "ghc";
    rts = "rts";
    ghc-pkg = "utils/ghc-pkg";
    # `iserv`, not `ghc-iserv`: stable-haskell renamed it on their fork, but
    # upstream 9.14 still has `utils/iserv` with `Name: iserv`.
    iserv = "utils/iserv";
    remote-iserv = "utils/remote-iserv";
    runghc = "utils/runghc";
    hp2ps = "utils/hp2ps";
    hpc-bin = "utils/hpc";
    hsc2hs = "utils/hsc2hs";
    haddock = "utils/haddock";
    haddock-api = "utils/haddock/haddock-api";
    haddock-library = "utils/haddock/haddock-library";
  };

  # GHC spells architectures and operating systems with its own constructors
  # (`GHC.Platform.ArchOS`), not with nixpkgs' names. Needed wherever a
  # generated module or settings entry names the platform.
  # `rts/configure` and `ghc-internal/configure` decide the target from autoconf's
  # own detection, and `ghcplatform.h` is what defines `x86_64_HOST_ARCH` and
  # friends. Run without `--host` they describe the *build* machine, so a cross
  # RTS gets x86 vector registers (`REG_XMM1` in `stg/MachRegsForHost.h`), the
  # vector Cmm in `Jumps.h` switches on, and the AArch64 backend panics with
  # `Invalid Reg W128`.
  #
  # `--host` is the RTS's own platform; there is deliberately no `--target`,
  # which for these scripts would be meaningless.
  configurePlatformFlags = lib.optionals (stdenv.buildPlatform != stdenv.hostPlatform) [
    "--build=${stdenv.buildPlatform.config}"
    "--host=${stdenv.hostPlatform.config}"
  ];

  ghcArch =
    p:
    if p.isx86_64 then
      "ArchX86_64"
    else if p.isx86_32 then
      "ArchX86"
    else if p.isAarch64 then
      "ArchAArch64"
    else if p.isAarch32 then
      "ArchARM ARMv7 [] VFPv3"
    else if p.isRiscV64 then
      "ArchRISCV64"
    else if p.isPower64 then
      "ArchPPC_64 ELF_V2"
    else if p.isS390x then
      "ArchS390X"
    else if p.isWasm then
      "ArchWasm32"
    else if p.isJavaScript then
      "ArchJavaScript"
    else
      throw "ghc/ng: no GHC Arch spelling for ${p.system}";

  ghcOS =
    p:
    if p.isLinux then
      "OSLinux"
    else if p.isDarwin then
      "OSDarwin"
    else if p.isWindows then
      "OSMinGW32"
    else if p.isFreeBSD then
      "OSFreeBSD"
    else if p.isNetBSD then
      "OSNetBSD"
    else if p.isOpenBSD then
      "OSOpenBSD"
    else if p.isWasi then
      "OSWasi"
    else if p.isGhcjs then
      "OSGhcjs"
    else
      throw "ghc/ng: no GHC OS spelling for ${p.system}";

  # Per-package corrections to what cabal2nix produced, as `overrideCabal`
  # functions -- never in the generated files, which are not hand-edited.
  #
  # These live beside the package, in `./packages/<name>/overrides.nix`, the
  # same way its patches sit beside its generated expression.
  #
  # `common/packages/`, not `<version>/packages/`: none of this logic differs
  # between releases. What differs is the generated expression, which bakes in
  # the version, and the patches, which are diffs against a specific `.cabal`.
  # Where a release genuinely differs -- `GHC.Internal.Prim` is generated on
  # 9.14 and a real source file on 9.15 -- these test for the difference rather
  # than for the version, which needs no second copy.
  overridesCtx = {
    inherit
      lib
      stdenv
      libffi
      python3
      ncurses
      autoreconfHook
      haskellLib
      ghcSrc
      configurePlatformFlags
      ghcArch
      ghcOS
      ;
  };

  overridesFor =
    name:
    let
      f = ./packages + "/${name}/overrides.nix";
    in
    if builtins.pathExists f then import f overridesCtx else null;

  # Arguments passed to `callPackage` for a package, where the generated
  # expression names something that is not a nixpkgs attribute. This has to
  # happen at `callPackage` time -- `overrideCabal` runs afterwards and cannot
  # stop an argument from being demanded.
  callArgs = final: {
    # rts.cabal has `extra-libraries: c`, which cabal2nix turns into a `c`
    # argument. That is libc; the stdenv supplies it and there is no such
    # attribute to pass.
    rts.c = null;
    # Likewise: `ghc-internal.cabal` also has `extra-libraries: c`.
    ghc-internal.c = null;

    # `libraryToolDepends`: programs run during the build, so they belong to the
    # build platform. Splicing would give the right instance if the attribute
    # existed here at all, but these live in the tools set -- stage2 has no
    # `deriveConstants` -- so `callPackage` cannot resolve them without help.
    ghc.deriveConstants = final.buildHaskellPackages.deriveConstants;
    ghc.genprimopcode = final.buildHaskellPackages.genprimopcode;
    ghc.alex = final.buildHaskellPackages.alex;
    ghc.happy = final.buildHaskellPackages.happy;

    # `terminfo` has `extra-libraries: ncurses`, meaning the C library. Inside a
    # Haskell package set that name is taken by the *Haskell* `ncurses`
    # binding, which is marked broken -- so the build fails with "Refusing to
    # evaluate package 'ncurses-0.2.16'" rather than anything about terminfo.
    terminfo.ncurses = ncurses;
  };

  # Every `*.patch` beside the generated expression, in sorted order so the
  # result does not depend on directory traversal order.
  patchesFor =
    name:
    let
      dir = packagesDir + "/${name}";
      entries = builtins.readDir dir;
      isPatch = f: type: type == "regular" && lib.hasSuffix ".patch" f;
    in
    map (f: dir + "/${f}") (lib.naturalSort (lib.attrNames (lib.filterAttrs isPatch entries)));

  hasGenerated = name: builtins.pathExists (packagesDir + "/${name}/generated-package.nix");

  # `generic-builder` only passes `--with-ghc` when cross-compiling; natively it
  # lets Cabal find `ghc` on PATH. In a stage2 set that is not good enough --
  # the bootstrap compiler is on PATH too, as `buildHaskellPackages` supplies
  # the Setup.hs compiler and the build tools, and Cabal picked it:
  #
  #     ghc-9.10.3: unrecognised flag: -fobject-determinism
  #
  # (a flag `generic-builder` adds because *our* `ghc` is 9.14). Naming the
  # compiler explicitly removes the ambiguity. Scoped to these packages rather
  # than done in `generic-builder`, which would rehash every Haskell package in
  # nixpkgs.
  withExplicitCompiler = final: {
    # `setupCompilerEnvironmentPhase` builds the package database and recaches it
    # with a bare `ghc-pkg`, so PATH order decides which one writes it. A cache
    # written by the bootstrap `ghc-pkg` is unreadable to this compiler:
    #
    #     package.cache: GHC.Unit.Database.readPackageDb:
    #       inappropriate type (not enough bytes)
    #
    # Rewriting it here is enough; `preConfigure` runs after that phase.
    preConfigure = ''
      "${final._wrappers.ghc}/bin/${final._wrappers.ghc.targetPrefix or ""}ghc-pkg" \
        --package-db="$packageConfDir" recache
    '';

    # The stage1 compiler ships no haddock, so Cabal reaches for the bootstrap
    # one and refuses:
    #
    #     Haddock's internal GHC version must match the configured GHC version.
    #     The GHC version is 9.14.1 but haddock is using GHC version 9.10.3
    #
    # haddock is built from this same tree and could be added to the stage1
    # compiler later; stable-haskell's stage2 does not build documentation
    # either.
    doHaddock = false;

    # Test suites of boot libraries pull the whole ecosystem back in and close
    # loops through the packages being bootstrapped: `pretty`'s tests need
    # QuickCheck, QuickCheck needs template-haskell, template-haskell needs
    # ghc-boot-th, and ghc-boot-th needs pretty. Nix reports that as plain
    # `infinite recursion encountered`.
    #
    # stable-haskell sets `tests: False` in `cabal.project.common` for the same
    # reason.
    doCheck = false;

    # `generic-builder` enables library profiling by default, but profiling is a
    # way like any other: it only works if *every* dependency has profiling
    # libraries, and the RTS ways we build are just `v`. Mixing the two gives
    #
    #     Could not load module GHC.Platform.Host
    #     Perhaps you haven't installed the profiling libraries for package ghc-boot
    #
    # Turning profiling on across the set is the other coherent choice, and
    # would mean building the profiling RTS ways too.
    enableLibraryProfiling = false;

    # For a cross build `generic-builder` would set up an `iserv` proxy so that
    # Template Haskell can run target code on the build machine. The boot
    # libraries do not use Template Haskell, and the proxy needs `iserv-proxy`
    # packages this set does not have -- so asking for it fails on
    # `iserv-wrapper-both` before anything is compiled.
    #
    # Cross Template Haskell for *user* code is a separate matter, and will want
    # `iserv`/`remote-iserv` built and shipped with the compiler.
    enableExternalInterpreter = false;

    configureFlags = [
      "--with-ghc=${final._wrappers.ghc}/bin/${final._wrappers.ghc.targetPrefix or ""}ghc"
      "--with-ghc-pkg=${final._wrappers.ghc}/bin/${final._wrappers.ghc.targetPrefix or ""}ghc-pkg"
    ];
  };

  mkPackage =
    final: name: subdir: exprOverride: extraAttrs:
    haskellLib.overrideCabal
      (
        drv:
        let
          overrides = overridesFor name;
          fixupAttrs = if overrides != null then overrides final drv else { };
        in
        (
          # A `null` subdir means the package brings its own `src` -- see
          # `hackageNames`. Everything else is a subdirectory of the GHC tree.
          if subdir == null then
            { patches = (drv.patches or [ ]) ++ patchesFor name; }
          else
            {
              src = ghcSrc;
              postUnpack = ''sourceRoot="$sourceRoot/${subdir}"'';
              patches = (drv.patches or [ ]) ++ patchesFor name;

              # Some of these packages are also released to Hackage, so cabal2nix
              # emits the Hackage revision (`hsc2hs-0.68.10-r3.cabal`) for them.
              # A revision is an edit to the *Hackage* metadata; the `.cabal`
              # here comes from the GHC tree, so applying one is both wrong and,
              # since the pinned hash goes stale, a build failure.
              revision = null;
              editedCabalFile = null;
            }
        )
        // extraAttrs
        // fixupAttrs
        // {
          # Accumulated rather than overwritten: the generated expression, the
          # stage-wide additions and the per-package fixup may each contribute,
          # and a plain `//` would silently drop all but the last. That is how
          # `--with-ghc` went missing and the RTS got built by the bootstrap
          # compiler.
          configureFlags =
            (drv.configureFlags or [ ])
            ++ (extraAttrs.configureFlags or [ ])
            ++ (fixupAttrs.configureFlags or [ ]);

          # Same reasoning as `configureFlags`: the stage-wide additions and the
          # per-package fixup both have something to say, and a plain `//` would
          # keep only the last.
          preConfigure =
            (drv.preConfigure or "") + (extraAttrs.preConfigure or "") + (fixupAttrs.preConfigure or "");

          # Setup dependencies belong to the build set -- see the note in
          # `explicitCompilerEverywhere`. It has to be repeated here because
          # that overlay maps over `prev`, and the overlays defining these
          # packages are composed afterwards and replace them wholesale.
          setupHaskellDepends = map (d: final.buildHaskellPackages.${d.pname or ""} or d) (
            drv.setupHaskellDepends or [ ]
          );
        }
      )
      (
        final.callPackage (
          if exprOverride != null then exprOverride else packagesDir + "/${name}/generated-package.nix"
        ) ((callArgs final).${name} or { })
      );

  # Which rung a package belongs to.
  #
  # Three, not two, and the third is forced by the RTS. `rts/Apply.cmm` uses
  # `PUSH_BH_UPD_FRAME`, which is not a CPP macro but a built-in of GHC's Cmm
  # parser (`compiler/GHC/Cmm/Parser.hs`). GHC 9.14 knows it; a 9.10 bootstrap
  # compiler does not, and says so:
  #
  #     Apply.cmm:703:3: error: [GHC-09848] unknown macro PUSH_BH_UPD_FRAME
  #
  # So the boot libraries cannot be built by the bootstrap compiler. They need a
  # compiler built from these same sources -- which is the whole reason
  # stable-haskell's Makefile has a stage1 at all.
  #
  #   o `tools`  -- build-platform programs, built by the bootstrap compiler
  #                 against *its* boot libraries. Nothing here may name a library
  #                 we build, or the set does not terminate:
  #                 rts -> deriveConstants -> base -> ghc-internal -> rts.
  #   o `stage1` -- the compiler itself, also built by the bootstrap compiler.
  #                 These use the `+bootstrap` cabal flags of
  #                 `cabal.project.stage1`, which make them compile against the
  #                 old `base`: `ghc-boot-th-next` vendors the TH AST from
  #                 `../ghc-internal/src` and depends on `ghc-prim` rather than
  #                 `ghc-internal`. See Note [Bootstrapping Template Haskell].
  #   o `stage2` -- the boot libraries proper, built by the stage1 compiler.
  #
  # Core libraries that are released on Hackage rather than living in the GHC
  # tree. `hackage-packages.nix` does not contain them -- hackage2nix skips GHC
  # core libraries because they are always `null` there -- so they get vendored
  # expressions of their own, generated from the tarball URLs at the versions
  # `cabal.project.stage2.common` pins.
  #
  # Unlike everything else here they bring their own `src` (cabal2nix emits a
  # self-contained `fetchzip`), so they must NOT get the `ghcSrc` + `postUnpack`
  # treatment.
  hackageNames = [
    # `ghc-pkg` needs Cabal as a *library* dependency, not just a setup one, so
    # the build set's copy will not do: it is built against the old `base` and
    # GHC will not link it. 3.16 is the version that supports GHC 9.14.
    "Cabal"
    "Cabal-syntax"
    "array"
    "binary"
    "bytestring"
    "containers"
    "deepseq"
    "directory"
    "exceptions"
    "file-io"
    "filepath"
    "haskeline"
    "hpc"
    "mtl"
    "os-string"
    "parsec"
    "pretty"
    "process"
    "semaphore-compat"
    "stm"
    "terminfo"
    "text"
    "time"
    "transformers"
    "unix"
    "xhtml"
    "template-haskell-lift"
    "template-haskell-quasiquoter"
  ];

  toolNames = [
    "deriveConstants"
    "genapply"
    "genprimopcode"
    "unlit"
    "hsc2hs"
    "ghc-platform"
    "ghc-toolchain"
    "ghc-toolchain-bin"
  ];

  stage1Names = [
    "ghc-boot-th-next"
    "ghc-boot"
    "ghci"
    "ghc"
    "ghc-bin"
    "ghc-pkg"
  ];

  # A package built for stage1 uses its `+bootstrap` expression where one exists.
  # cabal2nix emits a different dependency list under that flag -- `ghc-boot`
  # depends on `ghc-boot-th-next` rather than `ghc-boot-th`, for instance -- so
  # the two cannot share a generated file.
  variantFile =
    suffix: name:
    let
      f = packagesDir + "/${name}/generated-package-${suffix}.nix";
    in
    if builtins.pathExists f then f else null;

  bootstrapVariant = variantFile "bootstrap";

  # `+internal-interpreter` compiles GHCi's evaluator into the compiler itself.
  # Without it Template Haskell fails at
  #
  #     Couldn't find a target code interpreter. Try with -fexternal-interpreter
  #
  # It changes the dependency list -- `ghc-bin` gains `ghci` and `haskeline` --
  # so it needs its own generated expression rather than just a flag.
  # stable-haskell sets it in `cabal.project.stage2.common` for `ghc`, `ghc-bin`
  # and `ghci`.
  interpreterVariant = variantFile "interpreter";

  select =
    {
      pred,
      bootstrap ? false,
      interpreter ? false,
      explicitCompiler ? false,
    }:
    final: prev:
    lib.mapAttrs (
      name: subdir:
      mkPackage final name subdir (
        if bootstrap then
          bootstrapVariant name
        else if interpreter then
          interpreterVariant name
        else
          null
      ) (if explicitCompiler then withExplicitCompiler final else { })
    ) (lib.filterAttrs (name: _: hasGenerated name && pred name) subdirs);
in
{
  tools = select { pred = name: lib.elem name toolNames; };
  stage1 = select {
    pred = name: lib.elem name stage1Names;
    bootstrap = true;
  };
  # Note this is NOT the complement of stage1: `ghc`, `ghci`, `ghc-boot`,
  # `ghc-pkg` and `ghc-bin` are built twice. Stage1 builds them with the
  # bootstrap compiler and the `+bootstrap` flags, against the old `base`;
  # stage2 builds them again with the stage1 compiler against the new one, and
  # those are the copies the shipped compiler is made of. stable-haskell does
  # the same -- they appear in both `cabal.project.stage1` and
  # `cabal.project.stage2.common`.
  #
  # `ghc-platform` likewise: `ghc-toolchain` needs it at stage1, `ghc-boot`
  # needs it at stage2.
  #
  # Only the genuine build-time programs are stage1-only.
  stage2 = select {
    pred =
      name:
      !(lib.elem name [
        "deriveConstants"
        "genapply"
        "genprimopcode"
        # NB: `unlit` and `hsc2hs` are deliberately NOT excluded. They are
        # build-time programs *and* part of a GHC installation -- the testsuite
        # requires both next to `ghc`, and a shipped compiler needs host copies
        # of them. The build-time uses come from `_tools`, which is build-hosted.
        # `ghc-toolchain-bin` is a build-time program, but `ghc-toolchain` is a
        # library -- and from 9.15 the `ghc` library depends on it, so stage2
        # needs its own copy built against the new `base`.
        "ghc-toolchain-bin"
        "ghc-boot-th-next"
      ]);
    explicitCompiler = true;
    interpreter = true;
  };

  # The Hackage-released core libraries, compiled by the stage1 compiler like
  # everything else in stage2.
  # Not a source package at all -- see ./system-cxx-std-lib.nix.
  systemCxxStdLib = final: prev: {
    system-cxx-std-lib = callPackage ./system-cxx-std-lib.nix {
      # The undecorated version: the conf has to land under the libdir the
      # compiler actually uses, `lib/ghc-<cProjectVersion>`.
      ghcVersion = ghcSrc.release_version;
      # For `mk/system-cxx-std-lib-1.0.conf.in`, which the `.conf` is
      # substituted from.
      inherit ghcSrc;
    };
  };

  # `Setup.hs` of the GHC packages needs a Cabal new enough to understand the
  # tree it comes from. HEAD's `ghc-boot/Setup.hs` calls
  # `LBI.interpretSymbolicPathLBI`, which 3.12 -- the Cabal a 9.10 bootstrap
  # ships -- does not export:
  #
  #     Not in scope: 'LBI.interpretSymbolicPathLBI'
  #
  # Setup.hs is compiled by the *build* compiler, so this is the bootstrap set's
  # Cabal, and nixpkgs already packages newer ones there.
  setupCabal = final: prev: {
    Cabal = final.buildHaskellPackages.${"Cabal_${setupCabalVersion}"};
    Cabal-syntax = final.buildHaskellPackages.${"Cabal-syntax_${setupCabalVersion}"};
  };

  # Every package in a stage2 set must name the compiler explicitly, not only
  # the ones this overlay defines. `generic-builder` passes `--with-ghc` only
  # when cross-compiling; natively Cabal looks on PATH, where the bootstrap
  # compiler also sits (it supplies the Setup.hs compiler and the build tools).
  # Any Hackage package the set pulls in -- `libffi-clib`, say -- would
  # otherwise be compiled by the wrong GHC:
  #
  #     ghc-9.10.3: unrecognised flag: -fobject-determinism
  #
  # Applied across the whole set rather than in `generic-builder`, which would
  # rehash every Haskell package in nixpkgs.
  explicitCompilerEverywhere =
    final: prev:
    lib.mapAttrs (
      name: drv:
      if lib.isDerivation drv && drv ? overrideScope then
        haskellLib.overrideCabal (old: {
          configureFlags = (old.configureFlags or [ ]) ++ (withExplicitCompiler final).configureFlags;
          doCheck = false;
          doHaddock = false;

          preConfigure = (old.preConfigure or "") + (withExplicitCompiler final).preConfigure;

          # `Setup.hs` is compiled and run by the *build* compiler, so its
          # dependencies must come from the build set -- not from this one,
          # whose libraries are built by the compiler under construction and
          # cannot be linked into a Setup binary.
          #
          # This matters most for `Cabal`, which stage2 needs in both senses at
          # once: `ghc-pkg` links the stage1-built one as a library, while every
          # `Setup.hs` needs the bootstrap-built one. Same attribute name, two
          # different derivations.
          setupHaskellDepends = map (d: final.buildHaskellPackages.${d.pname or ""} or d) (
            old.setupHaskellDepends or [ ]
          );
        }) drv
      else
        drv
    ) prev;

  # Build tools, taken from the build set rather than built by the stage1
  # compiler.
  #
  # Normally splicing would do this: `libraryToolDepends` become
  # `nativeBuildInputs`, which resolve through `__spliced.buildHost`. But
  # `splicePackages` is a no-op when `pkgs == buildPackages` -- that is what
  # `actuallySplice` tests -- so on a native build these resolve to the set's
  # own packages. For any ordinary package set that is harmless, because the
  # set and its build set share a compiler. Here they do not, and the result is
  # `alex` being compiled by the stage1 GHC.
  buildTools =
    final: prev: lib.genAttrs [ "alex" "happy" "happy-lib" ] (name: final.buildHaskellPackages.${name});

  hackageCore =
    final: prev:
    lib.genAttrs (lib.filter hasGenerated hackageNames) (
      name:
      mkPackage final name null null (
        withExplicitCompiler final
        // {
          # These are released against whatever `base` was current, and we are
          # building a newer one -- `deepseq-1.5.1.0` wants `base <4.21` while
          # ours is 4.22.0.0. stable-haskell says the same thing as a long
          # `allow-newer: deepseq:*, pretty:*, ...` list in
          # `cabal.project.stage2.common`; `jailbreak` is the nixpkgs spelling.
          jailbreak = true;
        }
      )
    );
}
