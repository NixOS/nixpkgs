+     "; search[1]: example.com\n"
+     "nameserver 192.0.2.1\n"
+     "; nameserver[0]: [192.0.2.1]:53\n"
+    },
+    {.name = "long first entry from the domain directive",
+     .conf = "nameserver 192.0.2.1\n"
