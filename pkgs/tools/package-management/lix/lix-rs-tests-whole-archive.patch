From 9aae1c284737fd9a4dd4887647a2c49250dc0153 Mon Sep 17 00:00:00 2001
From: Raito Bezarius <raito@lix.systems>
Date: Mon, 13 Oct 2026 00:00:00 +0000
Subject: [PATCH] lix-rs: link the C++ static library correctly in tests

The `lix-rs-tests` test seems to link `liblix_cpp_static.a` before the
Rust rlibs that reference the zngur bridge it contains.

If I understand well, GNU ld resolves static archives in a single pass.

The bridge objects are therefore never pulled out, and the link fails
with undefined references to `_zngur_*`.

To fix this, we force the whole archive in, hence we have no ordering problem.

Also, the archive (contrary to upstream packaging) is built with LTO
(Nixpkgs passes `-Db_lto=true`), so the link driver also has to load the
LTO plugin.
---
 lix/lix-rs/build.rs | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/lix/lix-rs/build.rs b/lix/lix-rs/build.rs
index 77b1a2c..26874ff 100644
--- a/lix/lix-rs/build.rs
+++ b/lix/lix-rs/build.rs
@@ -18,7 +18,8 @@ fn main() {
     println!("cargo::rerun-if-env-changed=CXX_LINK_DIR_FOR_TEST");
     if let Ok(dir) = env::var("CXX_LINK_DIR_FOR_TEST") {
         println!("cargo::rustc-link-search={}", dir);
-        println!("cargo::rustc-link-lib=static=lix_cpp_static");
+        println!("cargo::rustc-link-lib=static:+whole-archive=lix_cpp_static");
+        println!("cargo::rustc-link-arg=-flto");
     }
 
     // pull link args for each dependency we'll need to fully link.
-- 
