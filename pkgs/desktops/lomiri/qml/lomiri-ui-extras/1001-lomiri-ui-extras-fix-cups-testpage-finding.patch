@@ -315,16 +315,32 @@ private Q_SLOTS:
         auto printer = QSharedPointer<Printer>(new Printer(printerBackend));
         backend->mockPrinterLoaded(printer);
         p.loadPrinter("printer-a");
+        QSignalSpy printFileSpy(printerBackend, SIGNAL(printToFile(QString, QString)));
+        QList<QVariant> args;
+
+        // Test overriding with envvar
+        const QString testCupsDatadirBase = qEnvironmentVariable("CUPS_DATADIR");
+        QVERIFY(!testCupsDatadirBase.isEmpty());
+
+        p.printTestPage("printer-a");
 
-        // Set the target url
+        QCOMPARE(printFileSpy.count(), 1);
+        args = printFileSpy.takeFirst();
+        QVERIFY(args.at(0).toString().startsWith(testCupsDatadirBase));
+
+        // Test custom search
         auto target = QStandardPaths::locate(QStandardPaths::GenericDataLocation,
                                              "cups/data/default-testpage.pdf",
                                              QStandardPaths::LocateFile);
+        // being *extra* sure about these being different
+        QVERIFY(!target.startsWith(testCupsDatadirBase));
 
-        QSignalSpy printFileSpy(printerBackend, SIGNAL(printToFile(QString, QString)));
+        QVERIFY(qunsetenv("CUPS_DATADIR"));
         p.printTestPage("printer-a");
+        QVERIFY(qputenv("CUPS_DATADIR", testCupsDatadirBase.toUtf8()));
+
         QCOMPARE(printFileSpy.count(), 1);
-        QList<QVariant> args = printFileSpy.takeFirst();
+        args = printFileSpy.takeFirst();
         QCOMPARE(args.at(0).toString(), target);
     }
 
