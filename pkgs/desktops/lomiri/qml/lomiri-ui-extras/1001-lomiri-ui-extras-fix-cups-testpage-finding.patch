From acac333599739ed8cf4c8dd4a7337bc101b77ec7 Mon Sep 17 00:00:00 2001
From: OPNA2608 <opna2608@protonmail.com>
Date: Mon, 28 Sep 2026 11:24:18 +0200
Subject: [PATCH 1/2] Printers: Check more CUPS things before resorting to
 manual search

1. CUPS_DATADIR envvar may be used to override the prefix of the data dir
2. The value of cups_datadir from cups.pc points to the datadir that CUPS normally uses
---
 CMakeLists.txt                                |  2 ++
 .../Components/Extras/Printers/CMakeLists.txt | 15 ++++----
 .../Extras/Printers/cupsconfig.h.in           | 24 +++++++++++++
 .../Extras/Printers/printers/printers.cpp     | 34 +++++++++++++++----
 .../Components/Extras/plugin/CMakeLists.txt   |  1 -
 tests/unittests/Printers/CMakeLists.txt       |  6 +++-
 .../cups/data/default-testpage.pdf            |  0
 tests/unittests/Printers/tst_printers.cpp     | 22 ++++++++++--
 8 files changed, 87 insertions(+), 17 deletions(-)
 create mode 100644 modules/Lomiri/Components/Extras/Printers/cupsconfig.h.in
 create mode 100644 tests/unittests/Printers/envvar_override_testdata/cups/data/default-testpage.pdf

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8e96b74..110a217 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -32,6 +32,8 @@ add_definitions(-DQT_NO_KEYWORDS)
 set(CMAKE_INCLUDE_CURRENT_DIR ON)
 set(CMAKE_AUTOMOC ON)
 
+find_package(PkgConfig REQUIRED)
+
 # make non compiled files visible in qtcreator
 file(GLOB_RECURSE NON_COMPILED_FILES *.qml *.js *.py *.svg *.png *.in *.json *.desktop *.pot qmldir)
 add_custom_target(NON_COMPILED_TARGET ALL SOURCES ${NON_COMPILED_FILES})
diff --git a/modules/Lomiri/Components/Extras/Printers/CMakeLists.txt b/modules/Lomiri/Components/Extras/Printers/CMakeLists.txt
index 12d53df..ade884c 100644
--- a/modules/Lomiri/Components/Extras/Printers/CMakeLists.txt
+++ b/modules/Lomiri/Components/Extras/Printers/CMakeLists.txt
@@ -2,15 +2,18 @@ project(LomiriComponentsExtrasPrintersQml)
 
 add_definitions(-DUBUNTUCOMPONENTSEXTRASPRINTERS_LIBRARY)
 
-include(FindCups)
+pkg_check_modules(CUPS REQUIRED cups)
 
-include_directories(${CMAKE_CURRENT_BINARY_DIR} ${CUPS_INCLUDE_DIR})
+pkg_get_variable(CUPS_DATADIR cups cups_datadir)
+configure_file(
+    cupsconfig.h.in
+    ${CMAKE_CURRENT_BINARY_DIR}/cupsconfig.h
+    @ONLY
+)
 
-find_package(Qt${QT_VERSION_MAJOR} REQUIRED COMPONENTS Gui PrintSupport Qml Concurrent)
+include_directories(${CMAKE_CURRENT_BINARY_DIR} ${CUPS_INCLUDE_DIRS})
 
-if(NOT CUPS_FOUND)
-message(FATAL_ERROR "Could not find cups.")
-endif()
+find_package(Qt${QT_VERSION_MAJOR} REQUIRED COMPONENTS Gui PrintSupport Qml Concurrent)
 
 qt_add_dbus_interface(
     GEN_SOURCES
