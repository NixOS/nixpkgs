+#ifndef USC_PRINTERS_CUPSCONFIG_H
+#define USC_PRINTERS_CUPSCONFIG_H
+
+#include <QString>
+
+const QString cupsDataDirBaseDefault = "@CUPS_DATADIR@";
+
+#endif /* USC_PRINTERS_CUPSCONFIG_H */
diff --git a/modules/Lomiri/Components/Extras/Printers/printers/printers.cpp b/modules/Lomiri/Components/Extras/Printers/printers/printers.cpp
index 6b0cebf..cdc76c5 100644
--- a/modules/Lomiri/Components/Extras/Printers/printers/printers.cpp
+++ b/modules/Lomiri/Components/Extras/Printers/printers/printers.cpp
@@ -15,6 +15,7 @@
  */
 
 #include "backend/backend_cups.h"
+#include "cupsconfig.h" // Note: this file gets generated
 #include "i18n.h"
 #include "printers/printers.h"
 #include "cupsdnotifier.h" // Note: this file was generated.
@@ -382,13 +383,34 @@ void Printers::printTestPage(const QString &name)
         return;
     }
 
-    auto page = QStandardPaths::locate(QStandardPaths::GenericDataLocation,
-                                       "cups/data/default-testpage.pdf",
-                                       QStandardPaths::LocateFile);
+    const QString testPagePathSuffix = "/data/default-testpage.pdf";
 
-    static const QString fallbackPage = "/snap/cups/current/share/cups/data/default-testpage.pdf";
-    if (page.isEmpty() && QFileInfo(fallbackPage).exists()) {
-        page = fallbackPage;
+    auto cupsDataDirCustomSearch = QStandardPaths::locate(QStandardPaths::GenericDataLocation,
+                                                    "cups" + testPagePathSuffix,
+                                                    QStandardPaths::LocateFile);
+
+    const QStringList testPagePathBaseCandidates = {
+        qEnvironmentVariable("CUPS_DATADIR"),
+        cupsDataDirBaseDefault,
+        cupsDataDirCustomSearch,
+        "/snap/cups/current/share/cups"
+    };
+
+    QString page;
+
+    for (const QString &testPagePathBaseCandidate : testPagePathBaseCandidates) {
+        QString pageCandidate = testPagePathBaseCandidate + testPagePathSuffix;
+        if (QFileInfo(pageCandidate).exists()) {
+            page = pageCandidate;
+            break;
+        }
+
+        // QStandardPaths::locate result already points at the file if it succeeded
+        QFileInfo baseCandidateInfo = QFileInfo(testPagePathBaseCandidate);
+        if (baseCandidateInfo.filePath().endsWith (testPagePathSuffix) && baseCandidateInfo.exists()) {
+          page = testPagePathBaseCandidate;
+          break;
+        }
     }
 
     if (page.isEmpty()) {
