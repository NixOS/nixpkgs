 .../mirserver/lomiri-shell-application.pc.in  |   9 +
 tests/framework/CMakeLists.txt                |   1 -
 .../modules/ApplicationManager/CMakeLists.txt |   1 -
 tests/modules/Session/CMakeLists.txt          |   1 -
 tests/modules/SurfaceManager/CMakeLists.txt   |   1 -
 17 files changed, 1551 insertions(+), 17 deletions(-)
