# Dinit backend for modular services.
#
# Translates the abstract service API (see lib/services/service.nix) into
# dinit service description files, emitted under /etc/dinit.d/<name>.
#
# This is opt-in and additive: importing it does not change how systemd or any
# existing NixOS service is translated. Existing `systemd.services`, `systemd`
# and `environment.etc` definitions are untouched.
{
  lib,
  config,
  options,
  pkgs,
  ...
}:

let
  inherit (lib)
    attrValues
    concatLists
    filterAttrs
    listToAttrs
    mapAttrs'
    mapAttrsToList
    mkOption
    nameValuePair
    optional
    removePrefix
    types
    ;
  
  inherit (lib.services.backend) configDataPathModule dash flattenServices;

  # All (enabled) services, keyed by their absolute dashed name.
  allServices = listToAttrs (map (r: {
      name = r.name;
      value = r;
    }) (lib.filter (r: r.name != "") (
      flattenServices "" "" {
        enable = true;
        services = config.system.services;
      }
    )));

  # Absolute name of a dependency relative to a given nesting level.
  depName = parentPrefix: dep: dash parentPrefix dep;

  dinitServiceFile =
    { name, parentPrefix, service }:
    let
      type' =
        {
          simple = "process";
          notify = "process";
          forking = "scripted";
          oneshot = "scripted";
        }
        .${service.process.type};
      wrap = service.runtime.user != "root";
      command = if wrap then "/etc/dinit.d/scripts/${name}" else lib.escapeShellArgs service.process.argv;
      signal =
        if service.process.stopSignal != null then
          removePrefix "SIG" service.process.stopSignal
        else
          null;
      restart =
        {
          always = "true";
          on-failure = "on-failure";
          never = "false";
        }
        .${service.restart.policy};
    in
    lib.concatLines (
      [ "# Generated by the NixOS dinit backend. Do not edit."
        "type = ${type'}"
        "command = ${command}"
        "restart = ${restart}"
      ]
      ++ optional (service.restart.policy == "always") "restart-delay = ${toString service.restart.delay}"
      ++ optional (service.restart.policy == "always") "smooth-recovery = true"
      ++ optional (service.runtime.workingDirectory != null)
        "working-dir = ${service.runtime.workingDirectory}"
      ++ map (v: "env = ${v}") (
        mapAttrsToList (k: v: "${k}=${v}") service.environment
      )
      ++ map (d: "depends-on: ${depName parentPrefix d}") service.dependencies.requires
      ++ map (d: "waits-for: ${depName parentPrefix d}") service.dependencies.wants
      ++ map (d: "after: ${depName parentPrefix d}") service.dependencies.after
      ++ map (d: "before: ${depName parentPrefix d}") service.dependencies.before
      ++ optional (service.process.startTimeout != null)
        "start-timeout = ${toString service.process.startTimeout}"
      ++ optional (service.process.stopTimeout != null)
        "stop-timeout = ${toString service.process.stopTimeout}"
      ++ optional (signal != null) "term-signal = ${signal}"
      ++ optional (service.process.type == "notify") "ready-notification = pipefd:4"
    );

  # dinit has no per-service user/group property, so services that must run as
  # a non-root user are launched through a setpriv wrapper.
  dinitWrappers = mapAttrs' (name: entry: nameValuePair name (
      pkgs.writeShellScript "dinit-runas-${name}" ''
        exec ${pkgs.util-linux}/bin/setpriv \
          --reuid ${lib.escapeShellArg entry.service.runtime.user} \
          --regid ${lib.escapeShellArg entry.service.runtime.group} \
          --init-groups -- ${lib.escapeShellArgs entry.service.process.argv}
      ''
    )) (filterAttrs (name: entry: entry.service.runtime.user != "root") allServices);

  configDataFiles = concatLists (
    map (entry: mapAttrsToList (file: cfg: nameValuePair (
          removePrefix "/etc/" cfg.path
        ) {
          source = cfg.source;
        }) (lib.filterAttrs (file: cfg: cfg.enable) (entry.service.configData or { }))
    ) (attrValues allServices)
  );
modularServiceConfiguration = lib.services.configure {
    serviceManagerPkgs = pkgs;
    extraRootModules = [
      (configDataPathModule { baseDir = "/etc/dinit/system-services"; })
    ];
  };
in
{
  _class = "nixos";

  options.system.services = mkOption {
    description = ''
      A collection of NixOS modular services configured as dinit services.
    '';
    type = types.attrsOf modularServiceConfiguration.serviceSubmodule;
    default = { };
    visible = "shallow";
  };

  config = {
    assertions = concatLists (
      mapAttrsToList (
        name: cfg: lib.services.getAssertions (options.system.services.loc ++ [ name ]) cfg
      ) config.system.services
    );

    warnings = concatLists (
      mapAttrsToList (
        name: cfg: lib.services.getWarnings (options.system.services.loc ++ [ name ]) cfg
      ) config.system.services
    );

    environment.etc = listToAttrs (
      (mapAttrsToList (name: entry: nameValuePair "dinit.d/${name}" {
          text = dinitServiceFile entry;
        }) allServices)
      ++ (mapAttrsToList (name: wrapper: nameValuePair "dinit.d/scripts/${name}" {
          source = wrapper;
        }) dinitWrappers)
      ++ configDataFiles
    );
  };
}