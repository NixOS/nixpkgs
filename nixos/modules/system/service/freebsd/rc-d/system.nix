# FreeBSD rc.d backend for modular services.
#
# Translates the abstract service API (see lib/services/service.nix) into
# FreeBSD rc.d scripts:
#
#   - /etc/rc.d/<name>: rc.subr based service scripts with PROVIDE/REQUIRE/
#     BEFORE baked into the script header
#   - /etc/rc.conf.d/<name>: `<name>_enable="YES"` so service(8) starts the
#     service
#   - /etc/freebsd/system-services/<name>/<file>: configData files
#
# Mapping of the abstract options:
#   - dependencies.requires -> REQUIRE
#   - dependencies.wants    -> REQUIRE (rc.d has no soft dependencies;
#     documented approximation)
#   - dependencies.before   -> BEFORE
#   - dependencies.after    -> REQUIRE on the dependency side (rc.d encodes
#     ordering through REQUIRE; the dependent waits for the dep to start)
#   - process.argv          -> command + command_args (through a wrapper
#     script for user switching, working directory and environment)
#   - runtime.user          -> command_user (native rc.subr support)
#   - restart.policy        -> not natively enforceable by rc.subr
#     (no supervision); documented
#
# The FreeBSD kernel, userland and jails themselves are out of scope for the
# Linux NixOS tree; this backend provides the service translation half of the
# FreeBSD compatibility story.
#
# This is opt-in and additive: importing it does not change anything for
# existing configurations.
{
  lib,
  config,
  options,
  pkgs,
  ...
}:

let
  inherit (lib)
    attrValues
    concatLists
    concatMapStrings
    concatMapStringsSep
    listToAttrs
    mapAttrs
    mapAttrsToList
    mkOption
    nameValuePair
    optional
    types
    ;
  inherit (lib.services.backend) dash flattenServices;

  allServices = listToAttrs (map (r: {
      name = r.name;
      value = r;
    }) (lib.filter (r: r.name != "") (
      flattenServices "" "" {
        enable = true;
        services = config.system.services;
      }
    )));

  depName = parentPrefix: dep: dash parentPrefix dep;

  # rc.subr runs `command` directly; user switching, working directory and
  # environment are handled by a generated wrapper, mirroring the dinit
  # backend's approach.
  wrappers = mapAttrs (name: entry: pkgs.writeShellScript "rc-command-${name}" (
      lib.concatLines (
        [ ''cd ${entry.service.runtime.workingDirectory}''
        ]
        ++ (map (v: "export ${v}") (
          mapAttrsToList (k: v: "${k}=${v}") entry.service.environment
        ))
        ++ [ "exec ${lib.escapeShellArgs entry.service.process.argv}" ]
      )
    )) (lib.filterAttrs (name: entry:
        entry.service.runtime.user != "root"
        || entry.service.runtime.workingDirectory != null
        || entry.service.environment != { }
      ) allServices);

  needsWrapper = entry:
    entry.service.runtime.user != "root"
    || entry.service.runtime.workingDirectory != null
    || entry.service.environment != { };

  script =
    { name, parentPrefix, service }:
    let
      command = if needsWrapper { inherit name parentPrefix service; } then "/etc/rc.d/scripts/${name}" else lib.escapeShellArgs service.process.argv;
      require' = lib.unique (
        (map (d: depName parentPrefix d) service.dependencies.requires)
        ++ (map (d: depName parentPrefix d) service.dependencies.wants)
        ++ (map (d: depName parentPrefix d) service.dependencies.after)
      );
      before' = map (d: depName parentPrefix d) service.dependencies.before;
    in
    lib.concatLines (
      [ "#!/bin/sh"
        "# PROVIDE: ${name}"
      ]
      ++ optional (require' != [ ]) "# REQUIRE: ${concatMapStringsSep " " (x: x) require'}"
      ++ optional (before' != [ ]) "# BEFORE: ${concatMapStringsSep " " (x: x) before'}"
      ++ [ ""
           "# Generated by the NixOS rc.d backend. Do not edit."
           "name=\"${name}\""
           "rcvar=${name}_enable"
           "command=${command}"
         ]
      ++ optional (service.runtime.user != "root") "command_user=\"${service.runtime.user}\""
      ++ optional (service.runtime.workingDirectory != null) "# working directory handled by the wrapper script"
      ++ [ ". /etc/rc.subr"
           "load_rc_config $name"
           "run_rc_command \"$1\""
         ]
    );

  rcScripts = mapAttrs (name: entry: pkgs.writeText "rc-${name}" (script entry)) allServices;

  configDataFiles = concatLists (
    map (entry: mapAttrsToList (file: cfg: nameValuePair (
          "freebsd/system-services/${entry.name}/${cfg.name}"
        ) {
          source = cfg.source;
        }) (lib.filterAttrs (file: cfg: cfg.enable) (entry.service.configData or { }))
    ) (attrValues allServices)
  );
in
{
  _class = "nixos";

  config = lib.mkIf (config.system.initSystem == "rc.d") {
    assertions = concatLists (
      mapAttrsToList (
        name: cfg: lib.services.getAssertions (options.system.services.loc ++ [ name ]) cfg
      ) config.system.services
    );

    warnings = concatLists (
      mapAttrsToList (
        name: cfg: lib.services.getWarnings (options.system.services.loc ++ [ name ]) cfg
      ) config.system.services
    );

    environment.etc = listToAttrs (
      (mapAttrsToList (name: entry: nameValuePair "rc.d/${name}" {
          text = script entry;
        }) allServices)
      ++ (mapAttrsToList (name: entry: nameValuePair "rc.conf.d/${name}" {
          text = "${name}_enable=\"YES\"\n";
        }) allServices)
      ++ (mapAttrsToList (name: wrapper: nameValuePair "rc.d/scripts/${name}" {
          source = wrapper;
        }) wrappers)
      ++ configDataFiles
    );

    system.build.freebsdRcScripts = pkgs.runCommand "freebsd-rc-scripts" { } (
      ''
        mkdir -p $out
      '' + concatMapStrings (name: ''
        install -m 0755 ${rcScripts.${name}} $out/${name}
      '') (builtins.attrNames allServices)
    );
  };
}