{ lib, ... }:
let
  domains = [
    "mail1.localdomain"
    "mail2.localdomain"
  ];
in

{
  name = "opendkim";

  nodes = {
    machine =
      { pkgs, config, ... }:
      {
        # The main service to be tested,
        # in charge of generating DKIM private keys
        # and corresponding public keys in DNS records,
        # then to sign mails given to it through
        # `config.services.postfix.settings.main.non_smtpd_milters`.
        services.opendkim = {
          enable = true;
          socket = "local:/run/opendkim/opendkim.sock";
          group = config.services.postfix.group;
          keyPath = "/var/lib/opendkim/keys";
          keySize = 4096;
          domainConfigs = {
            "mail1.localdomain" = {
              selector = "sel1";
            };
            "mail2.localdomain" = {
              selector = "sel2";
            };
          };
          trustedHosts = [
            "127.0.0.1"
            "::1"
          ];
          settings = {
            Mode = "sv";
            # Ensure the directory permissions allow group read/write.
            UMask = "002";
            Canonicalization = "relaxed/simple";
            SignatureAlgorithm = "rsa-sha256";
            SubDomains = "no";
            SignHeaders = "\"From To Subject Date\"";
            OversignHeaders = "From";
            MaximumSignedBytes = "100000";
            SignatureTTL = "3600";
            InternalHosts = "refile:/etc/opendkim/TrustedHosts";
            ExternalIgnoreList = "refile:/etc/opendkim/TrustedHosts";
            Syslog = "yes";
            SyslogSuccess = "yes";
            LogWhy = "yes";
          };
        };

        # A mail server to have mails signed by `opendkim`.
        services.postfix = {
          enable = true;
          settings = {
            main = {
              mydestination = domains ++ [ "${config.networking.hostName}.localdomain" ];
              # Apply `opendkim` to local mails from `sendmail`.
              non_smtpd_milters = "unix:${lib.removePrefix "local:" config.services.opendkim.socket}";
              # Skip signing if `opendkim` fails, don't drop mail.
              milter_default_action = "accept";
              # Milter protocol version used by `opendkim`.
              milter_protocol = "6";
            };
          };
        };
        networking.nameservers = lib.mkForce [ "::1" ];

        # A DNS server to serve DKIM TXT records for `opendkim-testmsg`
        # to verify the DKIM signature of emails.
        services.knot = {
          enable = true;
          extraArgs = [ "-v" ];
          settings = {
            log.syslog.any = "debug";
            server.listen = [
              "0.0.0.0@53"
              "::@53"
            ];
            template.default = {
              storage = "/var/lib/knot/zones";
              zonefile-load = "difference";
              journal-content = "changes";
            };
            zone = lib.genAttrs domains (domain: {
              file = "${domain}.zone";
              serial-policy = "increment";
              semantic-checks = true;
            });
          };
        };

        # Install the initial DNS zone files for `knot`,
        # the DKIM records will be generated by `opendkim`
        # and appended to them in the `testScript`.
        systemd.tmpfiles.settings = lib.concatMapAttrs (domain: _: {
          "10-knot-zone-${domain}" = {
            "${config.services.knot.settings.template.default.storage}/${domain}.zone"."f+" = {
              user = config.users.users.knot.name;
              group = config.users.groups.knot.name;
              mode = "0640";
              argument = ''
                ${domain}. 500 SOA ns1.${domain}. root.${domain}. 1 86400 900 3600000 86400

                ${domain}. 500 NS ns1.${domain}.
                ns1.${domain}. 500 A 127.0.0.1
                ns1.${domain}. 500 AAAA ::1

                ${domain}. 500 MX 5 mail.${domain}.
                mail.${domain}. 500 CNAME ${domain}.

                ${domain}. 500 A 127.0.0.1
                ${domain}. 500 AAAA ::1
              '';
            };
          };
        }) (lib.genAttrs domains (_: { }));

        environment.systemPackages =
          let
            sendTestMail = pkgs.writeScriptBin "send-testmail" ''
              #!${pkgs.runtimeShell}
              exec sendmail -t <<MAIL
              From: $1
              To: $2
              Subject: Test

              Hello world!
              MAIL
            '';
          in
          [
            sendTestMail
            pkgs.q
          ];
      };

  };

  interactive.sshBackdoor.enable = true;
  interactive.defaults.virtualisation.graphics = false;

  testScript =
    { nodes, ... }:
    # python
    ''
      start_all()

      machine.wait_for_unit("postfix.service")
      machine.wait_for_unit("opendkim.service")
      ${lib.concatMapStringsSep "\n" (domain: ''
        with subtest("Send mail for domain=${domain}"):
          machine.succeed("send-testmail root@${domain} root@machine.localdomain")
      '') domains}

      machine.wait_until_fails('[ "$(postqueue -p)" != "Mail queue is empty" ]')
      mails = machine.succeed("find /var/spool/mail/root/new/ -type f").strip().split("\n")
      t.assertEqual(bool(mails), True, "Expected a non-empty list of mails")

      for mail in mails:
        machine.fail(f"opendkim-testmsg <{mail}")

      ${lib.concatMapStringsSep "\n" (
        domain:
        let
          conf = nodes.machine.services.opendkim.domainConfigs.${domain};
        in
        ''
          with subtest("Add DKIM record for domain=${domain} and selector=${conf.selector}"):
            machine.succeed("cat /var/lib/opendkim/keys/${domain}/${conf.selector}.txt >>/var/lib/knot/zones/${domain}.zone")
            machine.succeed("knotc zone-reload ${domain}")
            machine.wait_until_fails('[ -z "$(q TXT ${conf.selector}._domainkey.${domain})" ]')
        ''
      ) domains}

      for mail in mails:
        machine.succeed(f"opendkim-testmsg <{mail}")

      print(machine.succeed("systemd-analyze security opendkim.service --threshold=12 --no-pager"))
    '';
}
