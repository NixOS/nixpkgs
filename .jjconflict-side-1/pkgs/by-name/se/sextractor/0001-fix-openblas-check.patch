-        $acx_openblas_libopt
-      )],
-      $acx_openblas_libopt
-    )
-  else
-    AC_SEARCH_LIBS(
-      [LAPACKE_dpotrf], ["openblas"$acx_openblas_suffix],,
-      [OPENBLAS_ERROR="OpenBLAS"$acx_openblas_suffix" library file not found!"],
