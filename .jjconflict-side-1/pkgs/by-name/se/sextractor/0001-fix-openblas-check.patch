-  AC_SUBST(OPENBLAS_CFLAGS)
-  AC_SUBST(OPENBLAS_LDFLAGS, "")
-  AC_SUBST(OPENBLAS_LIBS)
-  AC_SUBST(OPENBLAS_WARN)
-  $5
-else
-  AC_SUBST(OPENBLAS_ERROR)
-  $6
-fi
-
-])dnl ACX_OPENBLAS
