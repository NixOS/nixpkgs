{
  lib,
  stdenv,
  fetchFromGitHub,
  jdk,
  findbugs,
  ncurses,
  zip,
}:

let
  archId =
    {
      "x86_64" = "amd64";
      "i686" = "i386";
      "aarch64" = "aarch64";
      "riscv64" = "riscv64";
    }
    .${stdenv.hostPlatform.parsed.cpu.name} or stdenv.hostPlatform.parsed.cpu.name;
  platformId = "linux-${archId}";

  # Hash of the native sources, generated by native-platform build
  nativeVersionHash = "1def1411415f61bf3af743bc5b6707747c0891f09f0c88961ee8f79bc544acac";
in
stdenv.mkDerivation (finalAttrs: {
  pname = "gradle-native-platform";
  version = "0.22-milestone-28";

  __structuredAttrs = true;
  strictDeps = true;

  src = fetchFromGitHub {
    owner = "gradle";
    repo = "native-platform";
    tag = finalAttrs.version;
    hash = "sha256-khjGHgnCQ1zMjFarots7Ss6XMoiuhr38Nn9dRTky7Ng=";
  };

  nativeBuildInputs = [
    jdk
    zip
  ];

  buildInputs = [ ncurses ];

  nativeVersionInterface = ''
    package net.rubygrapefruit.platform.internal.jni;
    public interface NativeVersion {
        String VERSION = "${nativeVersionHash}";
    }
  '';

  nativeVersionHeader = ''
    #ifndef __INCLUDE_NATIVE_PLATFORM_VERSION_H__
    #define __INCLUDE_NATIVE_PLATFORM_VERSION_H__
    #ifdef __cplusplus
    extern "C" {
    #endif
    #define NATIVE_VERSION "${nativeVersionHash}"
    #ifdef __cplusplus
    }
    #endif
    #endif
  '';

  postPatch = ''
    substituteInPlace native-platform/src/main/cpp/posix.cpp \
      --replace-fail '#include <sys/sysctl.h>' ""

    mkdir -p gen-java/net/rubygrapefruit/platform/internal/jni gen-headers
    echo "$nativeVersionInterface" > gen-java/net/rubygrapefruit/platform/internal/jni/NativeVersion.java
    echo "$nativeVersionHeader" > gen-headers/native_platform_version.h
  '';

  buildPhase = ''
    runHook preBuild

    export JAVA_HOME=${jdk.home}
    mkdir -p classes headers jni

    find native-platform/src/main/java gen-java -name '*.java' > sources.txt
    javac -cp ${findbugs}/libexec/findbugs/lib/jsr305.jar \
      -h headers -d classes @sources.txt

    JNI_INC="-I$JAVA_HOME/include -I$JAVA_HOME/include/linux"

    $CXX -shared -fPIC -O2 -D_FILE_OFFSET_BITS=64 \
      $JNI_INC -Iheaders -Igen-headers -Inative-platform/src/shared/headers \
      native-platform/src/shared/cpp/generic.cpp \
      native-platform/src/shared/cpp/generic_posix.cpp \
      native-platform/src/shared/cpp/unix_strings.cpp \
      native-platform/src/main/cpp/posix.cpp \
      native-platform/src/main/cpp/linux.cpp \
      -o jni/libnative-platform.so

    $CXX -shared -fPIC -O2 -D_FILE_OFFSET_BITS=64 \
      $JNI_INC -Iheaders -Igen-headers -Inative-platform/src/shared/headers \
      native-platform/src/curses/cpp/curses.cpp \
      -Wl,-rpath,${lib.makeLibraryPath [ ncurses ]} -lncursesw \
      -o jni/libnative-platform-curses.so

    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall

    mkdir -p $out/lib

    stage() {
      local id="$1" so="$2" jarname="$3"
      local d="jarstage/net/rubygrapefruit/platform/$id"
      rm -rf jarstage && mkdir -p "$d"
      cp "$so" "$d/"
      ( cd jarstage && zip -qr "$out/lib/$jarname" . )
    }

    stage "${platformId}"          jni/libnative-platform.so        native-platform-${platformId}-${finalAttrs.version}.jar
    stage "${platformId}-ncurses5" jni/libnative-platform-curses.so native-platform-${platformId}-ncurses5-${finalAttrs.version}.jar
    stage "${platformId}-ncurses6" jni/libnative-platform-curses.so native-platform-${platformId}-ncurses6-${finalAttrs.version}.jar

    runHook postInstall
  '';

  meta = {
    description = "JNI native libraries for Gradle";
    homepage = "https://github.com/gradle/native-platform";
    license = lib.licenses.asl20;
    platforms = lib.platforms.linux;
    maintainers = with lib.maintainers; [ liberodark ];
  };
})
